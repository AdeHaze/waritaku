---
import { entries, collections, terms, entryTerms, taxonomies, settings } from '../db/schema';
import { eq, and, desc, like, sql } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { getDb } from '../lib/db';
import { getCanonicalUrl } from '../lib/queries';

interface Props {
    zone?: 'left' | 'right';
    context?: 'frontpage' | 'article' | 'category' | 'all';
}
const { zone = 'right', context = 'all' } = Astro.props;

let widgets: any[] = [];
let db: any = null;
let showSidebar = true;
let stickyClass = "sticky top-24";

if (env && (env as any).DB) {
    db = getDb(env as any);
    
    // Check global layout config
    const configRes = await db.select().from(settings).where(eq(settings.key, 'sidebar_layout_config')).limit(1);
    if (configRes.length > 0) {
        try {
            const layoutConfig = JSON.parse(configRes[0].value);
            if (context === 'frontpage' && !layoutConfig[zone]?.showOnFrontpage) showSidebar = false;
            if (context === 'article' && !layoutConfig[zone]?.showOnArticles) showSidebar = false;
            if (context === 'category' && !layoutConfig[zone]?.showOnCategories) showSidebar = false;
            
            if (layoutConfig[zone]?.stickyBehavior === 'sticky-bottom') {
                stickyClass = 'dynamic-sticky';
            } else if (layoutConfig[zone]?.stickyBehavior === 'none') {
                stickyClass = '';
            }
        } catch(e) {}
    }

    if (showSidebar) {
        const settingKey = zone === 'left' ? 'sidebar_widgets_left' : 'sidebar_widgets_right';
        const settingResult = await db.select().from(settings).where(eq(settings.key, settingKey)).limit(1);
        
        if (settingResult.length > 0) {
            try {
                widgets = JSON.parse(settingResult[0].value);
            } catch(e) {
                console.error(e);
            }
        } else if (zone === 'right') {
            // Fallback for legacy setups that only had one sidebar
            const oldSetting = await db.select().from(settings).where(eq(settings.key, 'sidebar_widgets')).limit(1);
            if (oldSetting.length > 0) {
                try { widgets = JSON.parse(oldSetting[0].value); } catch(e) {}
            }
        }
    }
}

// Filter widgets based on widget-level visibility
widgets = widgets.filter(w => !w.visibility || w.visibility === 'all' || w.visibility === context);

const t = Astro.locals.t || ((k: string, f?: string) => f || k);

function getThumbnail(content: string) {
    if (!content) return '/placeholder.webp';
    const match = content.match(/<img[^>]+src="([^">]+)"/i);
    return match ? match[1] : '/placeholder.webp';
}

// Pre-process all widget data in the frontmatter (avoids async .map in template)
const processedWidgets = await Promise.all(widgets.map(async (widget: any) => {
    if (widget.type === 'calendar') {
        const dateUrlMatch = Astro.url.pathname.match(/\/(\d{4})\/(\d{2})(?:\/(\d{2}))?/);
        const year = dateUrlMatch ? parseInt(dateUrlMatch[1], 10) : new Date().getFullYear();
        const month = dateUrlMatch ? parseInt(dateUrlMatch[2], 10) : new Date().getMonth() + 1;
        const monthStr = month.toString().padStart(2, '0');
        const datePrefix = `${year}-${monthStr}-%`;
        const activeDays = new Set<number>();
        if (db) {
            const articlesCol = await db.select().from(collections).where(eq(collections.slug, 'articles')).limit(1);
            if (articlesCol.length > 0) {
                const monthPosts = await db.select({ publishedAt: entries.publishedAt })
                    .from(entries)
                    .where(and(eq(entries.collectionId, articlesCol[0].id), eq(entries.status, 'published'), like(entries.publishedAt, datePrefix)));
                monthPosts.forEach((p: any) => { if (p.publishedAt) { const d = new Date(p.publishedAt).getDate(); if (d) activeDays.add(d); } });
            }
        }
        const firstDay = new Date(year, month - 1, 1).getDay();
        const daysInMonth = new Date(year, month, 0).getDate();
        const monthNamesShort = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
        const monthNamesFull = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
        const prevDate = new Date(year, month - 2, 1);
        const prevYear = prevDate.getFullYear();
        const prevMonth = (prevDate.getMonth() + 1).toString().padStart(2, '0');
        const prevLabel = `« ${monthNamesShort[prevDate.getMonth()]}`;
        const nextDate = new Date(year, month, 1);
        const nextYear = nextDate.getFullYear();
        const nextMonth = (nextDate.getMonth() + 1).toString().padStart(2, '0');
        const nextLabel = `${monthNamesShort[nextDate.getMonth()]} »`;
        const noFollowAttr = widget.indexation === 'noindex' ? 'nofollow' : undefined;
        return { widget, calendarData: { year, month, monthStr, firstDay, daysInMonth, monthNamesFull, prevYear, prevMonth, prevLabel, nextYear, nextMonth, nextLabel, noFollowAttr, activeDays } };
    }
    if (widget.type === 'recent') {
        let articleList: any[] = [];
        if (db) {
            const articlesCol = await db.select().from(collections).where(eq(collections.slug, 'articles')).limit(1);
            if (articlesCol.length > 0) {
                let query = db.select({ entry: entries }).from(entries);
                let conditions: any = and(eq(entries.status, 'published'), eq(entries.collectionId, articlesCol[0].id));
                if (widget.categoryId && widget.categoryId !== 'all') {
                    query = query.innerJoin(entryTerms, eq(entries.id, entryTerms.entryId));
                    conditions = and(conditions, eq(entryTerms.termId, parseInt(widget.categoryId)));
                }
                
                query = query.where(conditions) as any;
                let result: any[];
                if (widget.randomize) {
                    result = await query.groupBy(entries.id).orderBy(sql`RANDOM()`).limit(widget.limit || 5);
                } else {
                    result = await query.groupBy(entries.id).orderBy(desc(entries.publishedAt)).limit(widget.limit || 5);
                }
                
                // Batch-fetch the primary category term for all results
                const entryIds = result.map((r: any) => r.entry.id);
                let categoryMap: Record<number, string> = {};
                if (entryIds.length > 0) {
                    // Find the 'categories' taxonomy id
                    const catTax = await db.select({ id: taxonomies.id })
                        .from(taxonomies).where(eq(taxonomies.slug, 'categories')).limit(1);
                    if (catTax.length > 0) {
                        const catTermRows = await db.select({ entryId: entryTerms.entryId, id: terms.id, name: terms.name })
                            .from(entryTerms)
                            .innerJoin(terms, eq(entryTerms.termId, terms.id))
                            .where(and(
                                eq(terms.taxonomyId, catTax[0].id),
                                sql`${entryTerms.entryId} IN (${sql.join(entryIds.map((id: number) => sql`${id}`), sql`, `)})`
                            ));
                        for (const row of catTermRows) {
                            if (!categoryMap[row.entryId]) categoryMap[row.entryId] = [];
                            (categoryMap[row.entryId] as any).push(row);
                        }
                    }
                }
                articleList = await Promise.all(result.map(async (r: any) => {
                    const data = JSON.parse(r.entry.data || '{}');
                    const rawContent = data.content || '';
                    const textOnly = rawContent.replace(/<[^>]+>/g, '').replace(/\[caption[^\]]*\]|\[\/caption\]/g, '').trim();
                    const excerpt = textOnly.length > 80 ? textOnly.substring(0, 80) + '...' : textOnly;
                    const canonicalUrl = await getCanonicalUrl(db, r.entry.id, r.entry.slug);
                    
                    let categoryName = '';
                    const cats = (categoryMap[r.entry.id] as any) || [];
                    if (cats.length > 0) {
                        const primary = data.primaryTermId ? cats.find((c: any) => c.id === data.primaryTermId) : null;
                        categoryName = primary ? primary.name : cats[0].name;
                    }

                    return { id: r.entry.id, slug: r.entry.slug, canonicalUrl: `/${canonicalUrl}`, publishedAt: r.entry.publishedAt, ...data, categoryName, excerpt };
                }));
            }
        }
        return { widget, articleList };
    }
    return { widget };
}));
---
{showSidebar && processedWidgets.length > 0 && (
<div class={`space-y-10 ${stickyClass}`}>
    {processedWidgets.map(({ widget, calendarData, articleList }) => {
        
        if (widget.type === 'search') {
            return (
                <div class="bg-background rounded-2xl border border-border overflow-hidden shadow-sm">
                    <div class="bg-primary/10 px-5 py-3 border-b border-border">
                        <h3 class="text-sm font-bold uppercase tracking-wider text-primary flex items-center">
                            {widget.title || 'Search'}
                        </h3>
                    </div>
                    <div class="p-5">
                        <form action="/search" method="GET" class="relative">
                            <input 
                                type="text" 
                                name="q" 
                                placeholder="Search articles..." 
                                required
                                class="w-full h-10 pl-3 pr-10 rounded-md border border-input bg-muted/50 text-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary transition-colors"
                            />
                            <button type="submit" class="absolute right-0 top-0 h-10 w-10 flex items-center justify-center text-muted-foreground hover:text-primary transition-colors" aria-label="Search">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
                            </button>
                        </form>
                    </div>
                </div>
            );
        }

        if (widget.type === 'calendar' && calendarData) {
            const { year, month, monthStr, firstDay, daysInMonth, monthNamesFull, prevYear, prevMonth, prevLabel, nextYear, nextMonth, nextLabel, noFollowAttr, activeDays } = calendarData;
            return (
                <section class="bg-sidebar text-sidebar-foreground border border-border rounded-2xl p-5 shadow-sm">
                    <div class="flex flex-wrap items-center justify-between border-b-2 border-border pb-2 mb-4 gap-2">
                        <h2 class="text-base font-extrabold uppercase tracking-tight border-l-4 border-primary pl-3">{widget.title || 'Calendar'}</h2>
                        <div class="flex items-center gap-1">
                            <select 
                                class="text-xs font-bold bg-muted/60 border border-border rounded px-1.5 py-0.5 focus:outline-none focus:ring-1 focus:ring-primary text-foreground cursor-pointer" 
                                onchange="if(this.value){ window.location.href = '/' + this.dataset.year + '/' + this.value + '/'; }"
                                data-year={year}
                            >
                                {monthNamesFull.map((mName: string, mIdx: number) => {
                                    const val = (mIdx + 1).toString().padStart(2, '0');
                                    return (
                                        <option value={val} selected={mIdx + 1 === month}>{mName}</option>
                                    );
                                })}
                            </select>

                            <select 
                                class="text-xs font-bold bg-muted/60 border border-border rounded px-1.5 py-0.5 focus:outline-none focus:ring-1 focus:ring-primary text-foreground cursor-pointer"
                                onchange="if(this.value){ window.location.href = '/' + this.value + '/' + this.dataset.month + '/'; }"
                                data-month={monthStr}
                            >
                                {Array.from({ length: new Date().getFullYear() - 2018 + 1 }).map((_, yIdx) => {
                                    const yVal = new Date().getFullYear() - yIdx;
                                    return (
                                        <option value={yVal} selected={yVal === year}>{yVal}</option>
                                    );
                                })}
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-7 gap-1 text-center text-xs font-bold mb-2 text-muted-foreground">
                        <span>S</span><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span>
                    </div>

                    <div class="grid grid-cols-7 gap-1 text-center text-xs">
                        {Array.from({ length: firstDay }).map(() => (
                            <div class="py-1"></div>
                        ))}
                        {Array.from({ length: daysInMonth }).map((_, i) => {
                            const day = i + 1;
                            const dayPadded = day.toString().padStart(2, '0');
                            const hasPosts = activeDays.has(day);
                            return (
                                <div class="py-1">
                                    {hasPosts ? (
                                        <a 
                                            href={`/${year}/${monthStr}/${dayPadded}/`} 
                                            rel={noFollowAttr} 
                                            class="font-black text-primary hover:underline bg-primary/10 rounded px-1 py-0.5"
                                        >
                                            {day}
                                        </a>
                                    ) : (
                                        <span class="text-muted-foreground/70">{day}</span>
                                    )}
                                </div>
                            );
                        })}
                    </div>

                    <div class="flex items-center justify-between border-t border-border mt-4 pt-3 text-xs font-bold">
                        <a href={`/${prevYear}/${prevMonth}/`} rel={noFollowAttr} class="text-muted-foreground hover:text-primary transition-colors">
                            {prevLabel}
                        </a>
                        <a href={`/${year}/${monthStr}/`} rel={noFollowAttr} class="text-xs font-semibold text-primary hover:underline">
                            Arsip Bulan Ini
                        </a>
                        <a href={`/${nextYear}/${nextMonth}/`} rel={noFollowAttr} class="text-muted-foreground hover:text-primary transition-colors">
                            {nextLabel}
                        </a>
                    </div>
                </section>
            );
        }

        if (widget.type === 'html') {
            return (
                <div class="w-full rounded-2xl overflow-hidden">
                    <div set:html={widget.content || ''}></div>
                </div>
            );
        }

        if (widget.type === 'recent') {
            const list = articleList || [];
            return (
                <section class="bg-muted/30 rounded-2xl p-4 md:p-6 border border-border">
                    <div class="flex items-center justify-between border-b-2 border-border pb-2 mb-6">
                        <h2 class="text-xl font-extrabold uppercase tracking-tight border-l-4 border-primary pl-3">{widget.title || 'Terbaru'}</h2>
                    </div>
                    <div class="flex flex-col gap-4">
                        {list.map((article: any, idx: number) => (
                            <div class={`flex flex-row gap-4 group ${idx !== list.length - 1 ? 'border-b border-border pb-4' : ''}`}>
                                <a href={article.canonicalUrl || `/${article.slug}`} class="block relative w-24 h-16 md:w-28 md:h-20 rounded-lg overflow-hidden flex-shrink-0">
                                    <img src={article.featuredImageUrl || getThumbnail(article.content)} alt={article.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                                </a>
                                <div class="flex-1 flex flex-col justify-center">
                                    <span class="text-primary text-[10px] font-black uppercase tracking-wider mb-1 block">{article.categoryName}</span>
                                    <h3 class="text-xs md:text-sm font-bold leading-snug mb-1 group-hover:text-primary transition-colors line-clamp-2 md:line-clamp-3">
                                        <a href={article.canonicalUrl || `/${article.slug}`}>{article.title}</a>
                                    </h3>
                                    <time class="text-[10px] text-muted-foreground font-semibold uppercase">{new Date(article.publishedAt).toLocaleDateString()}</time>
                                </div>
                            </div>
                        ))}
                        {list.length === 0 && (
                            <div class="text-sm text-muted-foreground text-center py-4">No articles found.</div>
                        )}
                    </div>
                    <a href="/articles" class="block w-full text-center text-sm font-bold text-muted-foreground hover:text-primary transition-colors bg-background border border-border mt-6 py-2 rounded-lg">
                        Lihat Semua &raquo;
                    </a>
                </section>
            );
        }

        if (widget.type === 'social') {
            const links = widget.links || {};
            return (
                <section class="bg-muted/10 rounded-2xl p-4 md:p-6 border border-border">
                    <div class="flex items-center justify-between border-b-2 border-border pb-2 mb-6">
                        <h2 class="text-xl font-extrabold uppercase tracking-tight border-l-4 border-primary pl-3">{widget.title || 'Stay Connected'}</h2>
                    </div>
                    <div class="grid grid-cols-1 gap-3">
                        {links.facebook && (
                            <a href={links.facebook} target="_blank" rel="noopener noreferrer" class="flex items-center p-3 rounded-lg bg-[#1877F2] text-white hover:bg-[#0c63d4] transition-colors">
                                <svg class="w-6 h-6 mr-3 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                                <div class="flex-1"><div class="font-bold text-sm">Facebook</div></div>
                            </a>
                        )}
                        {links.twitter && (
                            <a href={links.twitter} target="_blank" rel="noopener noreferrer" class="flex items-center p-3 rounded-lg bg-black text-white hover:gray-800 transition-colors">
                                <svg class="w-6 h-6 mr-3 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                                <div class="flex-1"><div class="font-bold text-sm">X (Twitter)</div></div>
                            </a>
                        )}
                        {links.youtube && (
                            <a href={links.youtube} target="_blank" rel="noopener noreferrer" class="flex items-center p-3 rounded-lg bg-[#FF0000] text-white hover:bg-[#cc0000] transition-colors">
                                <svg class="w-6 h-6 mr-3 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                                <div class="flex-1"><div class="font-bold text-sm">YouTube</div></div>
                            </a>
                        )}
                        {links.instagram && (
                            <a href={links.instagram} target="_blank" rel="noopener noreferrer" class="flex items-center p-3 rounded-lg bg-gradient-to-r from-[#833ab4] via-[#fd1d1d] to-[#fcb045] text-white hover:opacity-90 transition-opacity">
                                <svg class="w-6 h-6 mr-3 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
                                <div class="flex-1"><div class="font-bold text-sm">Instagram</div></div>
                            </a>
                        )}
                        {links.pinterest && (
                            <a href={links.pinterest} target="_blank" rel="noopener noreferrer" class="flex items-center p-3 rounded-lg bg-[#E60023] text-white hover:opacity-90 transition-opacity">
                                <svg class="w-6 h-6 mr-3 fill-current" viewBox="0 0 24 24"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.951-7.252 4.185 0 7.437 2.981 7.437 6.933 0 4.161-2.62 7.51-6.262 7.51-1.223 0-2.373-.635-2.766-1.385l-.754 2.875c-.272 1.042-1.01 2.346-1.506 3.141 1.185.365 2.451.562 3.76.562 6.621 0 11.988-5.368 11.988-11.988 0-6.62-5.367-11.987-11.988-11.987z"/></svg>
                                <div class="flex-1"><div class="font-bold text-sm">Pinterest</div></div>
                            </a>
                        )}
                    </div>
                </section>
            );
        }

        return null;
    })}
</div>
)}

<style>
    .dynamic-sticky {
        position: sticky;
        /* Default to top until JS kicks in */
        top: 6rem;
    }
</style>

<script>
    function initBidirectionalSticky() {
        document.querySelectorAll('.dynamic-sticky').forEach(sidebar => {
            const TOP_MARGIN = 96; // 6rem
            const BOTTOM_MARGIN = 16; // 1rem
            
            let lastScrollY = window.scrollY;
            let currentTop = TOP_MARGIN;
            
            // Override the default CSS top with JS controlled one
            (sidebar as HTMLElement).style.top = currentTop + 'px';
            
            const onScroll = () => {
                const currentScrollY = window.scrollY;
                const delta = currentScrollY - lastScrollY;
                lastScrollY = currentScrollY;
                
                const sidebarHeight = sidebar.getBoundingClientRect().height;
                const viewportHeight = window.innerHeight;
                
                // If sidebar fits entirely in viewport, always stick to top
                if (sidebarHeight <= viewportHeight - TOP_MARGIN - BOTTOM_MARGIN) {
                    currentTop = TOP_MARGIN;
                    (sidebar as HTMLElement).style.top = currentTop + 'px';
                    return;
                }
                
                const minTop = viewportHeight - sidebarHeight - BOTTOM_MARGIN;
                
                // Scrolling down
                if (delta > 0) {
                    currentTop -= delta;
                    if (currentTop < minTop) {
                        currentTop = minTop;
                    }
                } 
                // Scrolling up
                else {
                    currentTop -= delta; // delta is negative, so this adds to currentTop
                    if (currentTop > TOP_MARGIN) {
                        currentTop = TOP_MARGIN;
                    }
                }
                
                (sidebar as HTMLElement).style.top = currentTop + 'px';
            };

            window.addEventListener('scroll', onScroll, { passive: true });
            
            // Clean up old listeners if astro navigates
            (sidebar as any)._stickyCleanup = () => {
                window.removeEventListener('scroll', onScroll);
            };
        });
    }

    // Run on DOM load and also after Astro page transitions if applicable
    document.addEventListener('DOMContentLoaded', initBidirectionalSticky);
    document.addEventListener('astro:page-load', () => {
        document.querySelectorAll('.dynamic-sticky').forEach(s => {
            if ((s as any)._stickyCleanup) (s as any)._stickyCleanup();
        });
        initBidirectionalSticky();
    });
    
    // Initial call just in case it's already loaded
    initBidirectionalSticky();
</script>
 