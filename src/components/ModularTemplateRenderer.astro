---
import GlobalSidebar from './GlobalSidebar.astro';
import { parseEmbeds } from '../utils/embedParser';
import { sanitizeHtml } from '../utils/sanitize';

export interface Props {
    data: any;
    parsedContent: string;
    showLeftSidebar: boolean;
    showRightSidebar: boolean;
    articleUpperHtml?: string;
    articleBottomHtml?: string;
    headerImage: string;
}

const { data, parsedContent, showLeftSidebar, showRightSidebar, articleUpperHtml, articleBottomHtml, headerImage } = Astro.props;

const layoutBlocks = data.supports?.layoutBlocks || [];

// Custom Fields Extractor (excludes built-in fields like content)
const customFields = Object.keys(data).filter(k => 
    !['id', 'slug', 'canonicalUrl', 'status', 'publishedAt', 'updatedAt', 'authorName', 'authorSlug', 'tags', 'supports', 'categoryName', 'categorySlug', 'categories', 'content', 'title', 'name', 'metaTitle', 'metaDescription', 'featuredImageUrl', 'layout_config', 'is_block_builder', 'layout_blocks', 'customSchema', 'visibility', 'password'].includes(k)
).map(k => ({ key: k, value: data[k] })).filter(f => f.value !== null && f.value !== undefined && f.value !== '');

---
<div class={`w-full ${!showLeftSidebar && !showRightSidebar ? 'max-w-7xl mx-auto' : ''}`}>
    {layoutBlocks.map((block: any, index: number) => {
        
        // 1. BREADCRUMBS
        if (block.type === 'breadcrumbs') {
            return (
                <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-4">
                    <nav class={`flex text-sm text-muted-foreground/80 font-medium ${block.config?.visibility === 'hidden' ? 'sr-only' : ''}`} aria-label="Breadcrumb">
                        <ol class="inline-flex items-center space-x-1 md:space-x-3">
                            <li class="inline-flex items-center">
                                <a href="/" class="inline-flex items-center hover:text-foreground transition-colors">
                                    <svg class="w-3 h-3 mr-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20"><path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z"/></svg>
                                    Home
                                </a>
                            </li>
                            {data.categorySlug && data.categorySlug !== 'all' && (
                                <li>
                                    <div class="flex items-center">
                                        <svg class="w-3 h-3 text-muted-foreground/50 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                                        </svg>
                                        <a href={`/${data.categorySlug}`} class="ml-1 hover:text-primary md:ml-2 transition-colors">{data.categoryName}</a>
                                    </div>
                                </li>
                            )}
                            <li aria-current="page">
                                <div class="flex items-center">
                                    <svg class="w-3 h-3 text-muted-foreground/50 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                                    </svg>
                                    <span class="ml-1 text-foreground md:ml-2 truncate max-w-[200px] sm:max-w-[300px] inline-block">{data.title || data.name}</span>
                                </div>
                            </li>
                        </ol>
                    </nav>
                </div>
            );
        }

        // 2. HERO HEADER (Article Style)
        if (block.type === 'hero') {
            return (
                <div class="w-full h-[45vh] md:h-[65vh] relative overflow-hidden bg-muted mb-12">
                    <img 
                        src={headerImage} 
                        alt={data.title || data.name}
                        class="w-full h-full object-cover"
                        onerror="this.src='https://placehold.co/1920x1080/333/FFF?text=Waritaku'"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-background via-background/60 to-transparent"></div>
                    <div class="absolute bottom-0 left-0 w-full">
                        <div class="container mx-auto px-4 sm:px-6 lg:px-8 pb-12">
                            <div class="max-w-4xl space-y-4">
                                {data.categories && data.categories.length > 0 && (
                                    <div class="flex flex-wrap gap-2">
                                        {data.categories.map((cat: any) => (
                                            <a href={`/${cat.slug}`} class="inline-flex items-center px-3 py-1 rounded-full bg-primary/20 text-primary text-sm font-semibold tracking-wide uppercase backdrop-blur-sm hover:bg-primary hover:text-primary-foreground transition-colors">
                                                {cat.name}
                                            </a>
                                        ))}
                                    </div>
                                )}
                                <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-foreground leading-tight drop-shadow-sm">
                                    {data.title || data.name}
                                </h1>
                                <div class="flex items-center text-muted-foreground pt-4 font-medium">
                                    <span>By <a href={`/author/${data.authorSlug}`} class="hover:text-primary transition-colors">{data.authorName}</a></span>
                                    <span class="mx-3">•</span>
                                    <time datetime={data.publishedAt}>{new Date(data.publishedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            );
        }

        // 3. PRODUCT SPLIT HEADER (Image Left, Info Right)
        if (block.type === 'product_split') {
            return (
                <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
                        <div class="relative rounded-2xl overflow-hidden shadow-xl border border-border bg-card">
                            <img 
                                src={headerImage} 
                                alt={data.title || data.name}
                                class="w-full h-auto object-cover"
                                onerror="this.src='https://placehold.co/800x800/333/FFF?text=Image'"
                            />
                        </div>
                        <div class="flex flex-col space-y-6">
                            {data.categoryName && (
                                <div class="text-sm font-bold text-primary uppercase tracking-widest">
                                    <a href={`/${data.categorySlug}`} class="hover:underline">{data.categoryName}</a>
                                </div>
                            )}
                            <h1 class="text-3xl md:text-5xl font-extrabold text-foreground leading-tight">
                                {data.title || data.name}
                            </h1>
                            
                            {/* Render custom fields quickly in the split header */}
                            {customFields.length > 0 && (
                                <div class="bg-muted/30 border border-border rounded-xl p-6 space-y-4">
                                    {customFields.map(field => {
                                        // Skip if it looks like rich text/html or a large array
                                        if (typeof field.value === 'string' && field.value.length > 200) return null;
                                        if (typeof field.value === 'object') return null;
                                        return (
                                            <div class="flex justify-between border-b border-border/50 pb-2 last:border-0 last:pb-0">
                                                <span class="font-semibold text-muted-foreground capitalize">{field.key.replace(/_/g, ' ')}</span>
                                                <span class="font-bold text-foreground text-right">{field.value.toString()}</span>
                                            </div>
                                        );
                                    })}
                                </div>
                            )}
                        </div>
                    </div>
                </div>
            );
        }

        // 4. BODY CONTENT (with Sidebars)
        if (block.type === 'body_content') {
            return (
                <div class={`container mx-auto px-4 sm:px-6 lg:px-8 py-8 ${!showLeftSidebar && !showRightSidebar ? 'max-w-4xl' : ''}`}>
                    <div class={`grid grid-cols-1 gap-8 md:gap-12 ${showLeftSidebar && showRightSidebar ? 'lg:grid-cols-4' : (showLeftSidebar || showRightSidebar) ? 'lg:grid-cols-3' : 'lg:grid-cols-1'}`}>
                        
                        {showLeftSidebar && (
                            <aside class="lg:col-span-1 mt-12 lg:mt-0 order-last lg:order-first">
                                <GlobalSidebar zone="left" context="article" />
                            </aside>
                        )}

                        <div class={`${showLeftSidebar && showRightSidebar ? 'lg:col-span-2' : (showLeftSidebar || showRightSidebar) ? 'lg:col-span-2' : 'lg:col-span-1'} overflow-hidden prose prose-neutral dark:prose-invert prose-lg md:prose-xl prose-a:text-primary hover:prose-a:text-primary/80 prose-img:rounded-xl prose-img:shadow-lg max-w-none`}>
                            {articleUpperHtml && <div class="mb-8" set:html={sanitizeHtml(articleUpperHtml)} />}
                            
                            <div set:html={sanitizeHtml(parsedContent)} />
                            


                            {articleBottomHtml && (
                                <div class="mt-16 pt-12 border-t border-border">
                                    <div class="bg-card border border-border p-6 rounded-xl shadow-sm" set:html={sanitizeHtml(articleBottomHtml)} />
                                </div>
                            )}
                        </div>

                        {showRightSidebar && (
                            <aside class="lg:col-span-1 mt-12 lg:mt-0">
                                <GlobalSidebar zone="right" context="article" />
                            </aside>
                        )}
                    </div>
                </div>
            );
        }

        // 4.5 AUTHOR BOX
        if (block.type === 'author_box') {
            if (!data.authorName) return null;
            return (
                <div class={`container mx-auto px-4 sm:px-6 lg:px-8 py-8 ${!showLeftSidebar && !showRightSidebar ? 'max-w-4xl' : ''}`}>
                    <div class="bg-card border border-border rounded-2xl p-6 sm:p-8 flex flex-col sm:flex-row items-center sm:items-start gap-6 shadow-sm">
                        <div class="w-24 h-24 sm:w-32 sm:h-32 shrink-0">
                            <img 
                                src={data.authorAvatar || `https://ui-avatars.com/api/?name=${encodeURIComponent(data.authorName)}&background=random`}
                                alt={data.authorName}
                                class="w-full h-full object-cover rounded-full border-4 border-muted"
                                onerror="this.src='https://ui-avatars.com/api/?name=Writer&background=random'"
                            />
                        </div>
                        <div class="flex-1 text-center sm:text-left">
                            <h3 class="text-xl font-bold mb-2 text-foreground">{data.authorName}</h3>
                            {data.authorBio ? (
                                <p class="text-muted-foreground text-sm leading-relaxed mb-4">{data.authorBio}</p>
                            ) : (
                                <p class="text-muted-foreground text-sm italic mb-4">This author has not written a bio yet.</p>
                            )}
                            <a href={`/author/${data.authorSlug}`} class="inline-flex items-center text-sm font-semibold text-primary hover:text-primary/80 transition-colors">
                                View all posts by {data.authorName}
                                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                            </a>
                        </div>
                    </div>
                </div>
            );
        }

        // 5. TAXONOMY TERMS
        if (block.type === 'taxonomy_terms') {
            const taxSlug = block.config?.targetTaxonomy;
            if (!taxSlug || !data.taxonomyTerms || !data.taxonomyTerms[taxSlug]) return null;
            const terms = data.taxonomyTerms[taxSlug];
            
            return (
                <div class={`container mx-auto px-4 sm:px-6 lg:px-8 py-8 ${!showLeftSidebar && !showRightSidebar ? 'max-w-4xl' : ''}`}>
                    <div class="flex flex-wrap gap-2">
                        {terms.map((term: any) => (
                            <a href={term.url} class="inline-flex items-center justify-center px-4 py-2 border border-border rounded-lg text-sm font-semibold bg-muted/30 hover:bg-primary hover:text-primary-foreground hover:border-primary transition-all shadow-sm">
                                {term.name}
                            </a>
                        ))}
                    </div>
                </div>
            );
        }

        // 6. RELATED ITEMS
        if (block.type === 'related_items') {
            const targetTaxSlug = block.config?.targetTaxonomy || 'categories';
            let termIdsToMatch: number[] = [];
            if (data.taxonomyTerms && data.taxonomyTerms[targetTaxSlug]) {
                termIdsToMatch = data.taxonomyTerms[targetTaxSlug].map((t: any) => t.id);
            }
            
            return (
                <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-border mt-12 bg-muted/10">
                    <h3 class="text-2xl font-bold mb-8 uppercase tracking-widest text-center">Related Items</h3>
                    <div 
                        class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 related-items-container min-h-[300px]"
                        data-tax={targetTaxSlug}
                        data-terms={termIdsToMatch.length > 0 ? termIdsToMatch.join(',') : 'all'}
                        data-current-id={data.id || ''}
                        data-limit="4"
                        data-randomize="true"
                    >
                        {/* Client-Side Shuffle will inject articles here */}
                    </div>
                </div>
            );
        }

        return null;
    })}
</div>

<script>
    function decodeHtmlRelated(text) {
        if (!text) return '';
        const textArea = document.createElement('textarea');
        textArea.innerHTML = text;
        return textArea.value;
    }

    function getThumbnail(content) {
        if (!content) return null;
        const match = content.match(/<img[^>]+src=["']([^"']+)["']/i);
        return match ? match[1] : null;
    }

    async function loadRelatedItems(container) {
        const tax = container.getAttribute('data-tax');
        const terms = container.getAttribute('data-terms');
        const limit = parseInt(container.getAttribute('data-limit'), 10) || 4;
        const currentId = parseInt(container.getAttribute('data-current-id'), 10);
        const randomize = container.getAttribute('data-randomize') === 'true';

        try {
            const res = await fetch(`/api/widgets/recent.json?tax=${tax}&terms=${terms}&limit=50`);
            if (!res.ok) throw new Error('Failed to fetch');
            let articles = await res.json();

            // Filter out the current article being viewed
            if (currentId) {
                articles = articles.filter(a => a.id !== currentId);
            }

            if (randomize) {
                for (let i = articles.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    [articles[i], articles[j]] = [articles[j], articles[i]];
                }
            }

            articles = articles.slice(0, limit);

            if (articles.length === 0) {
                container.innerHTML = '<div class="col-span-full text-sm text-muted-foreground text-center py-8">No related articles found.</div>';
                container.classList.remove('min-h-[300px]');
                return;
            }

            let html = '';
            articles.forEach(item => {
                const imgUrl = item.featuredImageUrl || getThumbnail(item.content) || `https://placehold.co/600x400/333/FFF?text=${encodeURIComponent(item.title)}`;
                const title = decodeHtmlRelated(item.title);
                const excerpt = item.excerpt || '';

                html += `
                    <a href="${item.canonicalUrl}" class="group flex flex-col bg-card border border-border rounded-2xl overflow-hidden hover:shadow-lg transition-all hover:-translate-y-1">
                        <div class="aspect-[16/9] w-full overflow-hidden bg-muted">
                            <img 
                                src="${imgUrl}"
                                alt="${title}"
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                onerror="this.src='https://placehold.co/600x400/333/FFF?text=${encodeURIComponent(title)}'"
                                loading="lazy"
                            />
                        </div>
                        <div class="p-5 flex flex-col flex-grow">
                            <h4 class="text-lg font-bold leading-snug group-hover:text-primary transition-colors line-clamp-2 mb-2">
                                ${title}
                            </h4>
                            <p class="text-xs text-muted-foreground line-clamp-2 mt-auto">
                                ${excerpt}
                            </p>
                        </div>
                    </a>
                `;
            });

            container.innerHTML = html;
            container.classList.remove('min-h-[300px]');
        } catch (e) {
            console.error('Error loading related items:', e);
            container.innerHTML = '<div class="col-span-full text-sm text-destructive text-center py-8">Error loading articles.</div>';
            container.classList.remove('min-h-[300px]');
        }
    }

    function initImageZoom() {
        const images = document.querySelectorAll('.prose img');
        if (!images.length) return;

        let lightbox = document.getElementById('waritaku-lightbox');
        let img;
        
        let scale = 1;
        let panning = false;
        let pointX = 0;
        let pointY = 0;
        let start = { x: 0, y: 0 };
        
        function setTransform() {
            img.style.transform = `translate(${pointX}px, ${pointY}px) scale(${scale})`;
        }

        if (!lightbox) {
            lightbox = document.createElement('div');
            lightbox.id = 'waritaku-lightbox';
            lightbox.className = 'fixed inset-0 z-[9999] bg-black/95 hidden flex-col items-center justify-center cursor-auto transition-opacity duration-300 opacity-0 select-none touch-none';
            
            img = document.createElement('img');
            img.className = 'max-w-full max-h-full object-contain shadow-2xl rounded-lg cursor-grab transition-transform duration-200';
            img.style.transformOrigin = '0 0'; // Needed for accurate pointer zooming
            lightbox.appendChild(img);
            
            // Add a hint
            const hint = document.createElement('div');
            hint.className = 'absolute bottom-4 text-white/50 text-xs tracking-widest uppercase font-mono pointer-events-none text-center px-4';
            hint.innerText = 'Scroll to zoom • Drag to pan • Double click to zoom • Click outside to close';
            lightbox.appendChild(hint);
            
            document.body.appendChild(lightbox);

            // Close when clicking outside the image
            lightbox.addEventListener('click', (e) => {
                if (e.target === lightbox) {
                    closeLightbox();
                }
            });

            // Double click to zoom
            img.addEventListener('dblclick', (e) => {
                e.preventDefault();
                if (scale >= 2) {
                    scale = 1;
                    pointX = 0;
                    pointY = 0;
                } else {
                    scale = 2;
                    // Center the zoom
                    const rect = img.getBoundingClientRect();
                    pointX = -((rect.width * 2) - window.innerWidth) / 2;
                    pointY = -((rect.height * 2) - window.innerHeight) / 2;
                }
                img.style.transition = 'transform 0.2s ease-out';
                setTransform();
            });

            // Wheel to zoom
            lightbox.addEventListener('wheel', (e) => {
                e.preventDefault();
                let delta = (e.wheelDelta ? e.wheelDelta : -e.deltaY);
                let zoomPointX = e.clientX - pointX;
                let zoomPointY = e.clientY - pointY;
                
                let zoomFactor = (delta > 0) ? 1.1 : 0.9;
                let newScale = scale * zoomFactor;
                
                if (newScale < 1) newScale = 1;
                if (newScale > 10) newScale = 10;
                
                if (newScale === 1) {
                    pointX = 0;
                    pointY = 0;
                } else {
                    pointX -= zoomPointX * (newScale / scale - 1);
                    pointY -= zoomPointY * (newScale / scale - 1);
                }
                
                scale = newScale;
                img.style.transition = 'none'; // instant follow for scroll
                setTransform();
            }, { passive: false });

            // Panning
            img.addEventListener('mousedown', (e) => {
                e.preventDefault();
                start = { x: e.clientX - pointX, y: e.clientY - pointY };
                panning = true;
                img.style.cursor = 'grabbing';
                img.style.transition = 'none';
            });

            lightbox.addEventListener('mouseup', () => {
                panning = false;
                img.style.cursor = 'grab';
                img.style.transition = 'transform 0.2s ease-out';
            });

            lightbox.addEventListener('mousemove', (e) => {
                if (!panning || scale === 1) return;
                e.preventDefault();
                pointX = (e.clientX - start.x);
                pointY = (e.clientY - start.y);
                setTransform();
            });
            
            lightbox.addEventListener('mouseleave', () => {
                panning = false;
                img.style.cursor = 'grab';
            });
        } else {
            img = lightbox.querySelector('img');
        }

        function closeLightbox() {
            lightbox.classList.replace('opacity-100', 'opacity-0');
            setTimeout(() => {
                lightbox.classList.replace('flex', 'hidden');
                scale = 1;
                pointX = 0;
                pointY = 0;
                img.style.transition = 'none';
                setTransform();
            }, 300);
        }

        images.forEach(el => {
            el.style.cursor = 'zoom-in';
            // Prevent multiple listeners if re-initialized
            if (!el.dataset.zoomInit) {
                el.dataset.zoomInit = 'true';
                el.addEventListener('click', () => {
                    img.src = el.src;
                    scale = 1;
                    pointX = 0;
                    pointY = 0;
                    img.style.transition = 'none';
                    setTransform();
                    
                    lightbox.classList.replace('hidden', 'flex');
                    setTimeout(() => {
                        lightbox.classList.replace('opacity-0', 'opacity-100');
                        img.style.transition = 'transform 0.2s ease-out';
                    }, 10);
                });
            }
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        const containers = document.querySelectorAll('.related-items-container');
        containers.forEach(container => loadRelatedItems(container));
        initImageZoom();
    });

    document.addEventListener('astro:page-load', () => {
        const containers = document.querySelectorAll('.related-items-container');
        containers.forEach(container => loadRelatedItems(container));
        initImageZoom();
    });
</script>
