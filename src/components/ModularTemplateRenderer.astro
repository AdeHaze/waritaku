---
import GlobalSidebar from './GlobalSidebar.astro';
import { parseEmbeds } from '../utils/embedParser';
import { sanitizeHtml } from '../utils/sanitize';

export interface Props {
    data: any;
    parsedContent: string;
    showLeftSidebar: boolean;
    showRightSidebar: boolean;
    articleUpperHtml?: string;
    articleBottomHtml?: string;
    headerImage: string;
}

const { data, parsedContent, showLeftSidebar, showRightSidebar, articleUpperHtml, articleBottomHtml, headerImage } = Astro.props;

const layoutBlocks = data.supports?.layoutBlocks || [];

const blockFiles = import.meta.glob('./blocks/*.astro', { eager: true });
const Blocks: Record<string, any> = {};

for (const path in blockFiles) {
  const name = path.split('/').pop()?.replace('.astro', '');
  if (name) {
    const mod = blockFiles[path] as any;
    Blocks[name] = mod.default;
  }
}

const typeToComponent = (type: string) => {
    return type.split('_').map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join('') + 'Block';
};
---
<div class={`w-full ${!showLeftSidebar && !showRightSidebar ? 'max-w-7xl mx-auto' : ''}`}>
    {layoutBlocks.map((block: any, index: number) => {
        const ComponentName = typeToComponent(block.type);
        const Component = Blocks[ComponentName];
        
        if (!Component) return null;
        
        return <Component 
            block={block} 
            data={data} 
            parsedContent={parsedContent} 
            showLeftSidebar={showLeftSidebar} 
            showRightSidebar={showRightSidebar} 
            articleUpperHtml={articleUpperHtml} 
            articleBottomHtml={articleBottomHtml} 
            headerImage={headerImage} 
        />;
    })}
</div>

<script>
    function decodeHtmlRelated(text: string) {
        if (!text) return '';
        const textArea = document.createElement('textarea');
        textArea.innerHTML = text;
        return textArea.value;
    }

    function getThumbnail(content: string) {
        if (!content) return null;
        const match = content.match(/<img[^>]+src=["']([^"']+)["']/i);
        return match ? match[1] : null;
    }

    async function loadRelatedItems(container: HTMLElement) {
        const tax = container.getAttribute('data-tax');
        const terms = container.getAttribute('data-terms');
        const limit = parseInt(container.getAttribute('data-limit') || '4', 10);
        const currentId = parseInt(container.getAttribute('data-current-id') || '0', 10);
        const randomize = container.getAttribute('data-randomize') === 'true';

        try {
            const res = await fetch(`/api/widgets/recent.json?tax=${tax}&terms=${terms}&limit=50`);
            if (!res.ok) throw new Error('Failed to fetch');
            let articles: any[] = await res.json();

            // Filter out the current article being viewed
            if (currentId) {
                articles = articles.filter((a: any) => a.id !== currentId);
            }

            if (randomize) {
                for (let i = articles.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    [articles[i], articles[j]] = [articles[j], articles[i]];
                }
            }

            articles = articles.slice(0, limit);

            if (articles.length === 0) {
                container.innerHTML = '<div class="col-span-full text-sm text-muted-foreground text-center py-8">No related articles found.</div>';
                container.classList.remove('min-h-[300px]');
                return;
            }

            let html = '';
            articles.forEach((item: any) => {
                const imgUrl = item.featuredImageUrl || getThumbnail(item.content) || `https://placehold.co/600x400/333/FFF?text=${encodeURIComponent(item.title)}`;
                const title = decodeHtmlRelated(item.title);
                const excerpt = item.excerpt || '';

                html += `
                    <a href="${item.canonicalUrl}" class="group flex flex-col bg-card border border-border rounded-2xl overflow-hidden hover:shadow-lg transition-all hover:-translate-y-1">
                        <div class="aspect-[16/9] w-full overflow-hidden bg-muted">
                            <img 
                                src="${imgUrl}"
                                alt="${title}"
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                onerror="this.src='https://placehold.co/600x400/333/FFF?text=${encodeURIComponent(title)}'"
                                loading="lazy"
                            />
                        </div>
                        <div class="p-5 flex flex-col flex-grow">
                            <h4 class="text-lg font-bold leading-snug group-hover:text-primary transition-colors line-clamp-2 mb-2">
                                ${title}
                            </h4>
                            <p class="text-xs text-muted-foreground line-clamp-2 mt-auto">
                                ${excerpt}
                            </p>
                        </div>
                    </a>
                `;
            });

            container.innerHTML = html;
            container.classList.remove('min-h-[300px]');
        } catch (e) {
            console.error('Error loading related items:', e);
            container.innerHTML = '<div class="col-span-full text-sm text-destructive text-center py-8">Error loading articles.</div>';
            container.classList.remove('min-h-[300px]');
        }
    }

    function initImageZoom() {
        const images = document.querySelectorAll('.prose img') as NodeListOf<HTMLImageElement>;
        if (!images.length) return;

        let lightbox = document.getElementById('waritaku-lightbox') as HTMLElement;
        let img = null as unknown as HTMLImageElement;
        
        let scale = 1;
        let panning = false;
        let pointX = 0;
        let pointY = 0;
        let start = { x: 0, y: 0 };
        
        function setTransform() {
            img.style.transform = `translate(${pointX}px, ${pointY}px) scale(${scale})`;
        }

        if (!lightbox) {
            lightbox = document.createElement('div');
            lightbox.id = 'waritaku-lightbox';
            lightbox.className = 'fixed inset-0 z-[9999] bg-black/95 hidden flex-col items-center justify-center cursor-auto transition-opacity duration-300 opacity-0 select-none touch-none';
            
            img = document.createElement('img');
            img.className = 'max-w-full max-h-full object-contain shadow-2xl rounded-lg cursor-grab transition-transform duration-200';
            img.style.transformOrigin = 'center'; // Use center for intuitive scaling
            lightbox.appendChild(img);
            
            // Add a hint
            const hint = document.createElement('div');
            hint.className = 'absolute bottom-4 text-white/50 text-xs tracking-widest uppercase font-mono pointer-events-none text-center px-4';
            hint.innerText = 'Scroll to zoom • Drag to pan • Double click to zoom • Click outside to close';
            lightbox.appendChild(hint);
            
            document.body.appendChild(lightbox);

            // Close when clicking outside the image
            lightbox.addEventListener('click', (e) => {
                if (e.target === lightbox) {
                    closeLightbox();
                }
            });

            // Double click to zoom
            img.addEventListener('dblclick', (e) => {
                e.preventDefault();
                if (scale >= 2) {
                    scale = 1;
                    pointX = 0;
                    pointY = 0;
                } else {
                    // Zoom into exactly where the user double-clicked
                    let mouseX = e.clientX - window.innerWidth / 2;
                    let mouseY = e.clientY - window.innerHeight / 2;
                    let ratio = 1 - (2 / scale);
                    pointX += (mouseX - pointX) * ratio;
                    pointY += (mouseY - pointY) * ratio;
                    scale = 2;
                }
                img.style.transition = 'transform 0.2s ease-out';
                setTransform();
            });

            // Wheel to zoom
            lightbox.addEventListener('wheel', (e) => {
                e.preventDefault();
                let delta = ((e as any).wheelDelta ? (e as any).wheelDelta : -e.deltaY);
                let zoomFactor = (delta > 0) ? 1.1 : 0.9;
                let newScale = scale * zoomFactor;
                
                if (newScale < 1) newScale = 1;
                if (newScale > 10) newScale = 10;
                
                if (newScale === 1) {
                    pointX = 0;
                    pointY = 0;
                } else {
                    // Calculate pointer position relative to center of screen
                    let mouseX = e.clientX - window.innerWidth / 2;
                    let mouseY = e.clientY - window.innerHeight / 2;
                    
                    // Adjust pointX and pointY so the pixel under the mouse stays exactly under the mouse
                    let ratio = 1 - (newScale / scale);
                    pointX += (mouseX - pointX) * ratio;
                    pointY += (mouseY - pointY) * ratio;
                }
                
                scale = newScale;
                img.style.transition = 'none'; // instant follow for scroll
                setTransform();
            }, { passive: false });

            // Panning
            img.addEventListener('mousedown', (e) => {
                e.preventDefault();
                start = { x: e.clientX - pointX, y: e.clientY - pointY };
                panning = true;
                img.style.cursor = 'grabbing';
                img.style.transition = 'none';
            });

            lightbox.addEventListener('mouseup', () => {
                panning = false;
                img.style.cursor = 'grab';
                img.style.transition = 'transform 0.2s ease-out';
            });

            lightbox.addEventListener('mousemove', (e) => {
                if (!panning || scale === 1) return;
                e.preventDefault();
                pointX = (e.clientX - start.x);
                pointY = (e.clientY - start.y);
                setTransform();
            });
            
            lightbox.addEventListener('mouseleave', () => {
                panning = false;
                img.style.cursor = 'grab';
            });
        } else {
            img = lightbox.querySelector('img') as HTMLImageElement;
        }

        function closeLightbox() {
            lightbox.classList.replace('opacity-100', 'opacity-0');
            setTimeout(() => {
                lightbox.classList.replace('flex', 'hidden');
                scale = 1;
                pointX = 0;
                pointY = 0;
                img.style.transition = 'none';
                setTransform();
            }, 300);
        }

        images.forEach(el => {
            el.style.cursor = 'zoom-in';
            // Prevent multiple listeners if re-initialized
            if (!el.dataset.zoomInit) {
                el.dataset.zoomInit = 'true';
                el.addEventListener('click', () => {
                    img.src = el.src;
                    scale = 1;
                    pointX = 0;
                    pointY = 0;
                    img.style.transition = 'none';
                    setTransform();
                    
                    lightbox.classList.replace('hidden', 'flex');
                    setTimeout(() => {
                        lightbox.classList.replace('opacity-0', 'opacity-100');
                        img.style.transition = 'transform 0.2s ease-out';
                    }, 10);
                });
            }
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        const containers = document.querySelectorAll('.related-items-container') as NodeListOf<HTMLElement>;
        containers.forEach(container => loadRelatedItems(container));
        initImageZoom();
    });

    document.addEventListener('astro:page-load', () => {
        const containers = document.querySelectorAll('.related-items-container') as NodeListOf<HTMLElement>;
        containers.forEach(container => loadRelatedItems(container));
        initImageZoom();
    });
</script>
