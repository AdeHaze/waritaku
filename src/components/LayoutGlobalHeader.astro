---
import LayoutGlobalNavbar from './LayoutGlobalNavbar.astro';
import { settings } from '../db/schema';
import { eq, inArray } from 'drizzle-orm';
import { env } from "cloudflare:workers";
import { getDb } from '../lib/db';

let { headerStyle = 'default' } = Astro.props;

let generalConfig = {
    siteTitle: 'Waritaku',
    logoUrl: 'https://waritaku.com/wp-content/uploads/2022/12/Logo_Waritaku_With_Tagline_7_Desktop.png'
};

if (env && env.DB) {
    try {
        const db = getDb(env);
        const records = await db.select().from(settings).where(inArray(settings.key, ['general_settings', 'global_navigation_layout']));
        
        records.forEach(record => {
            if (record.key === 'general_settings') {
                const dbSettings = JSON.parse(record.value);
                if (!dbSettings.logoUrl || dbSettings.logoUrl.trim() === '') {
                    delete dbSettings.logoUrl;
                }
                generalConfig = { ...generalConfig, ...dbSettings };
            }
            if (record.key === 'global_navigation_layout' && headerStyle === 'default') {
                const layoutData = JSON.parse(record.value);
                if (layoutData.headerStyle) headerStyle = layoutData.headerStyle;
            }
        });
    } catch(e) {}
}
---
<header class="sticky top-0 z-50 w-full border-b bg-navbar/95 text-navbar-foreground backdrop-blur supports-[backdrop-filter]:bg-navbar/60 shadow-sm">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        {headerStyle === 'centered' ? (
            <>
                <!-- TOP ROW (Centered Layout) -->
                <div class="flex h-20 items-center justify-between border-b border-border/50">
                    <!-- Left: Search -->
                    <div class="flex items-center w-1/3">
                        <form action="/search" method="GET" class="relative hidden md:block w-full max-w-[200px]">
                            <svg class="absolute left-2.5 top-2.5 h-4 w-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                            <input type="text" name="q" placeholder="Search..." class="flex h-9 w-full rounded-md border border-input bg-background px-3 py-1 pl-9 text-sm shadow-sm transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" />
                        </form>
                        <button class="md:hidden p-2 text-foreground focus:outline-none" aria-label="Search">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                        </button>
                    </div>

                    <!-- Center: Logo -->
                    <div class="flex items-center justify-center w-1/3">
                        <a href="/" class="flex items-center transition-transform hover:scale-105">
                            {generalConfig.logoUrl ? (
                                <img src={generalConfig.logoUrl} alt={generalConfig.siteTitle} class="h-12 w-auto object-contain" />
                            ) : (
                                <span class="text-2xl font-black text-primary uppercase tracking-wider">{generalConfig.siteTitle}</span>
                            )}
                        </a>
                    </div>

                    <!-- Right: Map & Phone -->
                    <div class="flex items-center justify-end w-1/3 space-x-4 md:space-x-6">
                        <a href="/contact" class="flex items-center text-muted-foreground hover:text-primary transition-colors">
                            <svg class="w-5 h-5 md:mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                            <span class="hidden md:inline text-sm font-medium">Find Us</span>
                        </a>
                        <a href="tel:+123456789" class="flex items-center text-muted-foreground hover:text-primary transition-colors">
                            <svg class="w-5 h-5 md:mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                            <span class="hidden md:inline text-sm font-medium">Contact</span>
                        </a>
                        <div class="lg:hidden flex items-center">
                            <button id="mobile-menu-btn" onclick="document.getElementById('mobile-menu').classList.toggle('hidden'); document.body.classList.toggle('overflow-hidden');" class="p-2 text-foreground focus:outline-none focus:ring-2 focus:ring-primary rounded-md" aria-label="Toggle menu">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- BOTTOM ROW: Navbar Center -->
                <div class="hidden lg:flex h-12 items-center justify-center">
                    <LayoutGlobalNavbar headerStyle={headerStyle} />
                </div>
            </>
        ) : (
            <>
                <!-- ORIGINAL LAYOUT (Magazine Default) -->
                <div class="flex h-16 items-center justify-between">
                    <div class="flex items-center">
                        <a href="/" class="flex items-center space-x-2 transition-transform hover:scale-105">
                            {generalConfig.logoUrl ? (
                                <img src={generalConfig.logoUrl} alt={generalConfig.siteTitle} class="h-10 w-auto object-contain transition-all duration-300" />
                            ) : (
                                <span class="text-xl font-bold text-primary">{generalConfig.siteTitle}</span>
                            )}
                        </a>
                        
                        <div class="ml-10">
                            <LayoutGlobalNavbar headerStyle={headerStyle} />
                        </div>
                    </div>
                    <div class="flex items-center space-x-4">
                        <div class="lg:hidden ml-auto flex items-center">
                            <button id="mobile-menu-btn" onclick="document.getElementById('mobile-menu').classList.toggle('hidden'); document.body.classList.toggle('overflow-hidden');" class="p-2 text-foreground focus:outline-none focus:ring-2 focus:ring-primary rounded-md transition-colors duration-300" aria-label="Toggle menu">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                            </button>
                        </div>
                    </div>
                </div>
            </>
        )}
    </div>
</header>
