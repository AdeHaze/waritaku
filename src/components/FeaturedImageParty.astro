---
const { title = 'Features', features = [] } = Astro.props;
---

<div class="relative w-screen left-1/2 -translate-x-1/2 py-16 md:py-24 bg-background">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        {title && (
            <h2 class="text-3xl md:text-5xl font-black text-center mb-16 tracking-tight text-foreground">
                {title}
            </h2>
        )}
        
        <div class="space-y-24 md:space-y-32">
            {features.map((feature: any, index: number) => {
                // If imageLeft is explicitly defined, use it, otherwise alternate based on index
                const isImageLeft = feature.imageLeft !== undefined ? feature.imageLeft : index % 2 === 0;
                
                return (
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-24 items-center">
                        <div class={`order-2 ${isImageLeft ? 'md:order-1' : 'md:order-2'}`}>
                            <div class="relative aspect-square md:aspect-[4/3] rounded-3xl overflow-hidden shadow-2xl bg-muted group">
                                <img 
                                    src={feature.image || '/placeholder.webp'} 
                                    alt={feature.title} 
                                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                                    loading="lazy"
                                />
                            </div>
                        </div>
                        
                        <div class={`order-1 space-y-6 ${isImageLeft ? 'md:order-2' : 'md:order-1'}`}>
                            <h3 class="text-3xl md:text-4xl font-extrabold tracking-tight text-foreground">
                                {feature.title || 'Feature Title'}
                            </h3>
                            <p class="text-lg md:text-xl text-muted-foreground leading-relaxed">
                                {feature.description || 'Describe this feature in detail. Highlight the benefits and value it provides to your users.'}
                            </p>
                            
                            {feature.buttonText && feature.buttonLink && (
                                <div class="pt-4">
                                    <a 
                                        href={feature.buttonLink}
                                        class="inline-flex items-center justify-center px-6 py-3 text-sm md:text-base font-bold text-primary-foreground bg-primary rounded-full hover:bg-primary/90 transition-colors shadow-md"
                                    >
                                        {feature.buttonText}
                                    </a>
                                </div>
                            )}
                        </div>
                    </div>
                )
            })}
        </div>
    </div>
</div>
