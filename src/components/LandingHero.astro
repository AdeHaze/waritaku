---
const { headline, subheadline, buttonText, buttonLink, backgroundUrl, textPosition = '5', dissolveAmount = 60 } = Astro.props;

// Map the 1-9 grid to Flexbox alignments
const positionClasses: Record<string, string> = {
  '1': 'items-end justify-start text-left',
  '2': 'items-end justify-center text-center',
  '3': 'items-end justify-end text-right',
  '4': 'items-center justify-start text-left',
  '5': 'items-center justify-center text-center',
  '6': 'items-center justify-end text-right',
  '7': 'items-start justify-start text-left',
  '8': 'items-start justify-center text-center',
  '9': 'items-start justify-end text-right',
};

const flexClass = positionClasses[textPosition.toString()] || positionClasses['5'];
---

<div class="mt-[-96px] md:mt-[-112px] mb-16">
    <div class="w-screen relative left-1/2 -translate-x-1/2 h-[60vh] md:h-[80vh] min-h-[500px] bg-muted overflow-hidden">
        <!-- Background Image -->
        <img 
            src={backgroundUrl || '/placeholder.webp'} 
            alt={headline} 
            class="absolute inset-0 w-full h-full object-cover object-center"
            loading="eager"
        />
        
        <!-- Custom Fade out gradient based on user-defined dissolveAmount -->
        <div 
            class="absolute inset-0" 
            style={`background: linear-gradient(to top, var(--background) 0%, color-mix(in oklch, var(--background) ${dissolveAmount}%, transparent) 50%, transparent 100%);`}
        ></div>

        <!-- Content Container -->
        <div class={`absolute inset-0 pb-16 md:pb-24 pt-32 md:pt-40 flex ${flexClass}`}>
            <div class="container mx-auto px-4 sm:px-6 lg:px-8">
                <div class="max-w-4xl space-y-4 md:space-y-6">
                    {headline && (
                        <h2 class="text-4xl md:text-6xl font-black text-white tracking-tight leading-tight drop-shadow-md">
                            {headline}
                        </h2>
                    )}
                    
                    {subheadline && (
                        <p class="text-lg md:text-2xl text-white/95 font-medium max-w-2xl drop-shadow">
                            {subheadline}
                        </p>
                    )}
                    
                    {buttonText && buttonLink && (
                        <div class="pt-4">
                            <a 
                                href={buttonLink}
                                class="inline-flex items-center justify-center px-8 py-4 text-base md:text-lg font-bold text-black bg-white rounded-full hover:bg-white/90 hover:scale-105 transition-all shadow-xl"
                            >
                                {buttonText}
                            </a>
                        </div>
                    )}
                </div>
            </div>
        </div>
    </div>
</div>
