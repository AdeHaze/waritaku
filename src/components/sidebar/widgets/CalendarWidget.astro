---
// Calendar widget — month grid with post-day highlighting and archive navigation.
// Self-contained: loads its own post-day data from D1.
import { entries, collections } from '../../../db/schema';
import { eq, and, like } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { getDb } from '../../../lib/db';

interface Props {
    widget: any;
}
const { widget } = Astro.props;

const dateArchiveMode = (Astro.locals as any).generalSettings?.dateArchiveMode || 'date';
const noFollowAttr = widget.indexation === 'noindex' ? 'nofollow' : undefined;

if (dateArchiveMode === 'off') {
    // Kill switch: calendar disabled by settings — render nothing.
    return;
}

const dateUrlMatch = Astro.url.pathname.match(/\/(\d{4})\/(\d{2})(?:\/(\d{2}))?/);
const year = dateUrlMatch ? parseInt(dateUrlMatch[1], 10) : new Date().getFullYear();
const month = dateUrlMatch ? parseInt(dateUrlMatch[2], 10) : new Date().getMonth() + 1;
const monthStr = month.toString().padStart(2, '0');
const datePrefix = `${year}-${monthStr}-%`;
const activeDays = new Set<number>();

if (env && (env as any).DB) {
    const db = getDb(env as any);
    const articlesCol = await db.select().from(collections).where(eq(collections.slug, 'articles')).limit(1);
    if (articlesCol.length > 0) {
        const monthPosts = await db.select({ publishedAt: entries.publishedAt })
            .from(entries)
            .where(and(eq(entries.collectionId, articlesCol[0].id), eq(entries.status, 'published'), like(entries.publishedAt, datePrefix)));
        monthPosts.forEach((p: any) => { if (p.publishedAt) { const d = new Date(p.publishedAt).getDate(); if (d) activeDays.add(d); } });
    }
}

const firstDay = new Date(year, month - 1, 1).getDay();
const daysInMonth = new Date(year, month, 0).getDate();
const monthNamesShort = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
const monthNamesFull = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
const prevDate = new Date(year, month - 2, 1);
const prevYear = prevDate.getFullYear();
const prevMonth = (prevDate.getMonth() + 1).toString().padStart(2, '0');
const prevLabel = `« ${monthNamesShort[prevDate.getMonth()]}`;
const nextDate = new Date(year, month, 1);
const nextYear = nextDate.getFullYear();
const nextMonth = (nextDate.getMonth() + 1).toString().padStart(2, '0');
const nextLabel = `${monthNamesShort[nextDate.getMonth()]} »`;
---

<section class="bg-sidebar text-sidebar-foreground border border-border rounded-2xl p-5 shadow-sm">
    <div class="flex flex-wrap items-center justify-between border-b-2 border-border pb-2 mb-4 gap-2">
        <h2 class="text-base font-extrabold uppercase tracking-tight border-l-4 border-primary pl-3">{widget.title || 'Calendar'}</h2>
        <div class="flex items-center gap-1">
            {dateArchiveMode !== 'year' && (
                <select 
                    class="text-xs font-bold bg-muted/60 border border-border rounded px-1.5 py-0.5 focus:outline-none focus:ring-1 focus:ring-primary text-foreground cursor-pointer" 
                    onchange="if(this.value){ window.location.href = '/' + this.dataset.year + '/' + this.value + '/'; }"
                    data-year={year}
                >
                    {monthNamesFull.map((mName: string, mIdx: number) => {
                        const val = (mIdx + 1).toString().padStart(2, '0');
                        return (
                            <option value={val} selected={mIdx + 1 === month}>{mName}</option>
                        );
                    })}
                </select>
            )}

            <select 
                class="text-xs font-bold bg-muted/60 border border-border rounded px-1.5 py-0.5 focus:outline-none focus:ring-1 focus:ring-primary text-foreground cursor-pointer"
                onchange="if(this.value){ var m = this.dataset.month ? this.dataset.month + '/' : ''; window.location.href = '/' + this.value + '/' + m ; }"
                data-month={dateArchiveMode === 'year' ? '' : monthStr}
            >
                {Array.from({ length: new Date().getFullYear() - 2018 + 1 }).map((_, yIdx) => {
                    const yVal = new Date().getFullYear() - yIdx;
                    return (
                        <option value={yVal} selected={yVal === year}>{yVal}</option>
                    );
                })}
            </select>
        </div>
    </div>

    <div class="grid grid-cols-7 gap-1 text-center text-xs font-bold mb-2 text-muted-foreground">
        <span>S</span><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span>
    </div>

    <div class="grid grid-cols-7 gap-1 text-center text-xs">
        {Array.from({ length: firstDay }).map(() => (
            <div class="py-1"></div>
        ))}
        {Array.from({ length: daysInMonth }).map((_, i) => {
            const day = i + 1;
            const dayPadded = day.toString().padStart(2, '0');
            const hasPosts = activeDays.has(day);
            return (
                <div class="py-1">
                    {hasPosts && dateArchiveMode === 'date' ? (
                        <a 
                            href={`/${year}/${monthStr}/${dayPadded}/`} 
                            rel={noFollowAttr} 
                            class="font-black text-primary hover:underline bg-primary/10 rounded px-1 py-0.5"
                        >
                            {day}
                        </a>
                    ) : hasPosts ? (
                        <span class="font-black text-primary bg-primary/10 rounded px-1 py-0.5">{day}</span>
                    ) : (
                        <span class="text-muted-foreground/70">{day}</span>
                    )}
                </div>
            );
        })}
    </div>

    {dateArchiveMode !== 'year' && (
        <div class="flex items-center justify-between border-t border-border mt-4 pt-3 text-xs font-bold">
            <a href={`/${prevYear}/${prevMonth}/`} rel={noFollowAttr} class="text-muted-foreground hover:text-primary transition-colors">
                {prevLabel}
            </a>
            <a href={`/${year}/${monthStr}/`} rel={noFollowAttr} class="text-xs font-semibold text-primary hover:underline">
                Arsip Bulan Ini
            </a>
            <a href={`/${nextYear}/${nextMonth}/`} rel={noFollowAttr} class="text-muted-foreground hover:text-primary transition-colors">
                {nextLabel}
            </a>
        </div>
    )}
</section>
