---
---
<div class="flex items-center gap-2 bg-muted/30 p-1 rounded-lg border border-border">
    <button 
        type="button" 
        id="btn-view-grid" 
        class="p-2 rounded-md transition-all hover:bg-background hover:shadow-sm hover:text-primary data-[active=true]:bg-background data-[active=true]:shadow-sm data-[active=true]:text-primary text-muted-foreground"
        aria-label="Grid View"
        data-active="true"
    >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="7" height="7" x="3" y="3" rx="1" />
            <rect width="7" height="7" x="14" y="3" rx="1" />
            <rect width="7" height="7" x="14" y="14" rx="1" />
            <rect width="7" height="7" x="3" y="14" rx="1" />
        </svg>
    </button>
    <button 
        type="button" 
        id="btn-view-list" 
        class="p-2 rounded-md transition-all hover:bg-background hover:shadow-sm hover:text-primary data-[active=true]:bg-background data-[active=true]:shadow-sm data-[active=true]:text-primary text-muted-foreground"
        aria-label="List View"
        data-active="false"
    >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="8" x2="21" y1="6" y2="6" />
            <line x1="8" x2="21" y1="12" y2="12" />
            <line x1="8" x2="21" y1="18" y2="18" />
            <line x1="3" x2="3.01" y1="6" y2="6" />
            <line x1="3" x2="3.01" y1="12" y2="12" />
            <line x1="3" x2="3.01" y1="18" y2="18" />
        </svg>
    </button>
</div>

<script is:inline>
    (function() {
        // Run immediately to prevent FOUC on container load
        const storedView = localStorage.getItem('waritaku-archive-view');
        if (storedView) {
            document.documentElement.setAttribute('data-archive-view', storedView);
        } else {
            document.documentElement.setAttribute('data-archive-view', 'grid');
        }

        document.addEventListener('DOMContentLoaded', () => {
            const btnGrid = document.getElementById('btn-view-grid');
            const btnList = document.getElementById('btn-view-list');
            
            function updateActiveButtons(mode) {
                if (btnGrid && btnList) {
                    btnGrid.setAttribute('data-active', mode === 'grid' ? 'true' : 'false');
                    btnList.setAttribute('data-active', mode === 'list' ? 'true' : 'false');
                }
            }

            const currentView = document.documentElement.getAttribute('data-archive-view') || 'grid';
            updateActiveButtons(currentView);

            if (btnGrid) {
                btnGrid.addEventListener('click', () => {
                    document.documentElement.setAttribute('data-archive-view', 'grid');
                    localStorage.setItem('waritaku-archive-view', 'grid');
                    updateActiveButtons('grid');
                });
            }

            if (btnList) {
                btnList.addEventListener('click', () => {
                    document.documentElement.setAttribute('data-archive-view', 'list');
                    localStorage.setItem('waritaku-archive-view', 'list');
                    updateActiveButtons('list');
                });
            }
        });
    })();
</script>
