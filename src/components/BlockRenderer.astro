---
import GlobalSidebar from './GlobalSidebar.astro';

const { layoutBlocks: rawLayoutBlocks, blockData = {}, showLeftSidebar = false, showRightSidebar = true } = Astro.props;
const layoutBlocks = Array.isArray(rawLayoutBlocks) ? rawLayoutBlocks : [];

// Dynamically import all block components
const rawBlocks = import.meta.glob('./frontpage-blocks/*.astro', { eager: true });
const Blocks: Record<string, any> = {};

for (const [path, module] of Object.entries(rawBlocks)) {
  const name = path.split('/').pop()?.replace('.astro', '');
  if (name) Blocks[name] = (module as any).default;
}

const typeToComponent = (type: string) => {
    if (!type) return '';
    let name = type.split('_').map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join('');
    // Handle the specific naming mapping we did
    if (name === 'CategoryBlock2') name = 'CategoryBlock2'; 
    else if (name === 'Hero2') name = 'Hero2Block';
    else if (name === 'Hero3') name = 'Hero3Block';
    else if (!name.endsWith('Block')) name = name + 'Block';
    return name;
};

const layoutSections: any[] = [];
let currentMainColumnGroup: any[] = [];
const validBlocks = layoutBlocks.filter((b: any) => b && b.type);
for (const block of validBlocks) {
    const isMainColumn = block.type === 'category_block' || block.type === 'category_block_2';
    if (isMainColumn) {
        currentMainColumnGroup.push(block);
    } else {
        if (currentMainColumnGroup.length > 0) {
            layoutSections.push({ type: 'main_column_group', blocks: currentMainColumnGroup });
            currentMainColumnGroup = [];
        }
        layoutSections.push({ type: 'full_width', block: block });
    }
}
if (currentMainColumnGroup.length > 0) {
    layoutSections.push({ type: 'main_column_group', blocks: currentMainColumnGroup });
}
---

<div class="space-y-16">
    {layoutSections.map((section: any) => {
        if (section.type === 'main_column_group') {
            return (
                <div class={`grid grid-cols-1 ${showLeftSidebar && showRightSidebar ? 'lg:grid-cols-4' : (showLeftSidebar || showRightSidebar) ? 'lg:grid-cols-3' : 'lg:grid-cols-1'} gap-8 md:gap-12`}>
                    {showLeftSidebar && (
                        <div class="lg:col-span-1">
                            <GlobalSidebar zone="left" context="frontpage" />
                        </div>
                    )}
                    <div class={showLeftSidebar && showRightSidebar ? 'lg:col-span-2 space-y-12' : (showLeftSidebar || showRightSidebar) ? 'lg:col-span-2 space-y-12' : 'lg:col-span-1 space-y-12'}>
                        {section.blocks.map((block: any) => {
                            const ComponentName = typeToComponent(block.type);
                            const Component = Blocks[ComponentName];
                            if (!Component) return <div class="text-red-500">Block {ComponentName} not found</div>;

                            const hasFilter = block.config?.targetTaxonomy || block.config?.targetTerm || block.tagSlug || block.categoryId;
                            const archiveUrl = hasFilter 
                                ? (block.tagSlug ? `tag/${block.tagSlug}` : (blockData[block.id]?.[0]?.categories?.[0]?.slug || 'category'))
                                : (block.config?.targetCollection || 'articles');
                            
                            return <Component 
                                block={block}
                                title={block.title || 'Category'} 
                                categorySlug={archiveUrl} 
                                articles={blockData[block.id] || []} 
                                showExcerpt={block.showExcerpt} 
                            />;
                        })}
                    </div>
                    {showRightSidebar && (
                        <div class="lg:col-span-1">
                            <GlobalSidebar zone="right" context="frontpage" />
                        </div>
                    )}
                </div>
            );
        } else {
            const block = section.block;
            const ComponentName = typeToComponent(block.type);
            const Component = Blocks[ComponentName];
            
            if (!Component) return <div class="text-red-500">Block {ComponentName} not found ({block.type})</div>;

            return (
                <div class="w-full">
                    <Component 
                        block={block}
                        blockData={blockData}
                        articles={blockData[block.id] || []}
                        {...block}
                    />
                </div>
            );
        }
    })}
</div>
