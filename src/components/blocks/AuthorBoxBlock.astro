---
export interface Props {
    block: any;
    data: any;
    showLeftSidebar: boolean;
    showRightSidebar: boolean;
}
const { block, data, showLeftSidebar, showRightSidebar } = Astro.props;

if (!data.authorName) {
    return null; // Return nothing if no author
}
---
<div class={`container mx-auto px-4 sm:px-6 lg:px-8 py-8 ${!showLeftSidebar && !showRightSidebar ? 'max-w-4xl' : ''}`}>
    <div class="bg-card border border-border rounded-2xl p-6 sm:p-8 flex flex-col sm:flex-row items-center sm:items-start gap-6 shadow-sm">
        <div class="w-24 h-24 sm:w-32 sm:h-32 shrink-0">
            <img 
                src={data.authorAvatar || `https://ui-avatars.com/api/?name=${encodeURIComponent(data.authorName)}&background=random`}
                alt={data.authorName}
                class="w-full h-full object-cover rounded-full border-4 border-muted"
                onerror="this.src='https://ui-avatars.com/api/?name=Writer&background=random'"
            />
        </div>
        <div class="flex-1 text-center sm:text-left">
            <h3 class="text-xl font-bold mb-2 text-foreground">{data.authorName}</h3>
            {data.authorBio ? (
                <p class="text-muted-foreground text-sm leading-relaxed mb-4">{data.authorBio}</p>
            ) : (
                <p class="text-muted-foreground text-sm italic mb-4">This author has not written a bio yet.</p>
            )}
            <a href={`/author/${data.authorSlug}`} class="inline-flex items-center text-sm font-semibold text-primary hover:text-primary/80 transition-colors">
                View all posts by {data.authorName}
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>
        </div>
    </div>
</div>
