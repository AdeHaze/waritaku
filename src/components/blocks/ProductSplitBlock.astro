---
export interface Props {
    block: any;
    data: any;
    headerImage: string;
}
const { block, data, headerImage } = Astro.props;

// Custom Fields Extractor (excludes built-in fields like content)
const customFields = Object.keys(data).filter(k => 
    !['id', 'slug', 'canonicalUrl', 'status', 'publishedAt', 'updatedAt', 'authorName', 'authorSlug', 'tags', 'supports', 'categoryName', 'categorySlug', 'categories', 'content', 'title', 'name', 'metaTitle', 'metaDescription', 'featuredImageUrl', 'layout_config', 'is_block_builder', 'layout_blocks', 'customSchema', 'visibility', 'password'].includes(k)
).map(k => ({ key: k, value: data[k] })).filter(f => f.value !== null && f.value !== undefined && f.value !== '');
---
<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
        <div class="relative rounded-2xl overflow-hidden shadow-xl border border-border bg-card">
            <img 
                src={headerImage} 
                alt={data.title || data.name}
                class="w-full h-auto object-cover"
                onerror="this.src='https://placehold.co/800x800/333/FFF?text=Image'"
            />
        </div>
        <div class="flex flex-col space-y-6">
            {data.categoryName && (
                <div class="text-sm font-bold text-primary uppercase tracking-widest">
                    <a href={`/${data.categorySlug}`} class="hover:underline">{data.categoryName}</a>
                </div>
            )}
            <h1 class="text-3xl md:text-5xl font-extrabold text-foreground leading-tight">
                {data.title || data.name}
            </h1>
            
            {/* Render custom fields quickly in the split header */}
            {customFields.length > 0 && (
                <div class="bg-muted/30 border border-border rounded-xl p-6 space-y-4">
                    {customFields.map(field => {
                        // Skip if it looks like rich text/html or a large array
                        if (typeof field.value === 'string' && field.value.length > 200) return null;
                        if (typeof field.value === 'object') return null;
                        return (
                            <div class="flex justify-between border-b border-border/50 pb-2 last:border-0 last:pb-0">
                                <span class="font-semibold text-muted-foreground capitalize">{field.key.replace(/_/g, ' ')}</span>
                                <span class="font-bold text-foreground text-right">{field.value.toString()}</span>
                            </div>
                        );
                    })}
                </div>
            )}
        </div>
    </div>
</div>
