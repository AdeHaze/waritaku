---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getDb } from "../../../lib/db";
import { collections } from "../../../db/schema";
const env = Astro.locals?.runtime?.env;

const user = Astro.locals.user;
if (!user || user.role !== "superadmin") {
    return Astro.redirect("/admin/login");
}

const db = getDb(env);
const collectionsList = await db.select().from(collections);
---

<AdminLayout title="Content Type Builder">
    <div class="mb-8 flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold tracking-tight">
                Content Type Builder
            </h1>
            <p class="text-muted-foreground mt-1">
                Manage your Headless CMS models and schemas.
            </p>
        </div>
        <a
            href="/admin/content-builder/create"
            class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2 shadow-sm"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="mr-2"
                ><path d="M5 12h14"></path><path d="M12 5v14"></path></svg
            >
            Create New Type
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
            collectionsList.map((col) => (
                <div class="bg-card border border-border rounded-xl shadow-sm overflow-hidden flex flex-col hover:border-primary/50 transition-colors">
                    <div class="p-6 flex-1">
                        <div class="flex items-center justify-between mb-4">
                            <div class="p-2.5 bg-primary/10 text-primary rounded-lg">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="24"
                                    height="24"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <>
                                        <rect
                                            width="18"
                                            height="18"
                                            x="3"
                                            y="3"
                                            rx="2"
                                            ry="2"
                                        />
                                        <line x1="3" x2="21" y1="9" y2="9" />
                                        <path d="m9 16 3-3 3 3" />
                                    </>
                                </svg>
                            </div>
                            <span class="text-xs font-mono bg-muted text-muted-foreground px-2 py-1 rounded-md">
                                {col.slug}
                            </span>
                        </div>
                        <h3 class="text-xl font-bold mb-2">{col.label}</h3>
                        <p class="text-sm text-muted-foreground line-clamp-2">
                            {col.description || "No description provided."}
                        </p>
                    </div>
                    <div class="bg-muted/30 px-6 py-4 border-t border-border flex justify-between items-center">
                        <span class="text-xs font-medium text-muted-foreground">
                            {JSON.parse(col.fields || "[]").length} fields
                        </span>
                        <div class="flex items-center gap-3">
                            <button
                                type="button"
                                class="text-sm font-semibold text-destructive hover:underline btn-delete"
                                data-slug={col.slug}
                                data-name={col.label}
                            >
                                Delete
                            </button>
                            <a
                                href={`/admin/content-builder/edit/${col.slug}`}
                                class="text-sm font-semibold text-primary hover:underline"
                            >
                                Edit Schema &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            ))
        }
    </div>

    <script>
        document.querySelectorAll(".btn-delete").forEach((btn) => {
            btn.addEventListener("click", async (e) => {
                const button = e.currentTarget as HTMLButtonElement;
                const slug = button.dataset.slug;
                const name = button.dataset.name;

                button.style.opacity = "0.5";
                button.style.pointerEvents = "none";

                try {
                    // Fetch stats before deleting
                    const statsRes = await fetch(
                        `/api/content-builder/${slug}/stats`,
                    );
                    if (!statsRes.ok)
                        throw new Error("Could not fetch content type stats");

                    const stats = (await statsRes.json()) as any;

                    let confirmMessage = `Are you sure you want to delete the Content Type "${name}"?`;

                    if (stats.count > 0) {
                        confirmMessage = `WARNING! You are currently attempting to delete the Content Type "${name}".\n\nThere are ${stats.count.toLocaleString()} entries currently assigned to this content type in the database!\n\nDeleting this Content Type will PERMANENTLY DESTROY all ${stats.count.toLocaleString()} entries.\n\nAre you absolutely sure you want to proceed?`;
                    } else {
                        confirmMessage += `\n\nThis will permanently delete it from the database.`;
                    }

                    if (confirm(confirmMessage)) {
                        const res = await fetch(
                            `/api/content-builder/${slug}?force=true`,
                            { method: "DELETE" },
                        );
                        if (res.ok) {
                            window.location.reload();
                        } else {
                            const err = (await res.json()) as any;
                            alert(`Error deleting content type: ${err.error}`);
                            button.style.opacity = "1";
                            button.style.pointerEvents = "auto";
                        }
                    } else {
                        button.style.opacity = "1";
                        button.style.pointerEvents = "auto";
                    }
                } catch (err: any) {
                    alert(`Error: ${err.message}`);
                    button.style.opacity = "1";
                    button.style.pointerEvents = "auto";
                }
            });
        });
    </script>
</AdminLayout>
