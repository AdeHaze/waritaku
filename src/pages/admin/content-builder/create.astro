---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { hasPermission } from "../../../lib/permissions";

const permissions = Astro.locals.permissions;
if (!permissions || !hasPermission(permissions, 'content_builder', 'create')) {
    return Astro.redirect("/admin/login");
}
---

<AdminLayout title="Create Content Type">
    <div class="mb-8 flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold tracking-tight">
                Create Content Type
            </h1>
            <p class="text-muted-foreground mt-1">
                Define a new collection for your CMS.
            </p>
        </div>
        <a
            href="/admin/content-builder"
            class="text-sm text-muted-foreground hover:text-primary transition-colors"
            >&larr; Back to list</a
        >
    </div>

    <div class="max-w-2xl">
        <form
            id="createCollectionForm"
            class="bg-card border border-border rounded-xl shadow-sm p-6 space-y-6"
        >
            <div
                id="formError"
                class="hidden p-4 rounded-lg font-medium text-sm bg-red-500/10 text-red-500"
            >
            </div>

            <div class="space-y-4">
                <div>
                    <label
                        class="block text-sm font-bold tracking-wide text-foreground mb-1"
                        >Display Name (Plural) <span class="text-red-500"
                            >*</span
                        ></label
                    >
                    <input
                        type="text"
                        id="label"
                        required
                        placeholder="e.g. Products, Articles, Testimonials"
                        class="w-full px-4 py-2 bg-background border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary"
                    />
                </div>

                <div>
                    <label
                        class="block text-sm font-bold tracking-wide text-foreground mb-1"
                        >Display Name (Singular) <span class="text-red-500"
                            >*</span
                        ></label
                    >
                    <input
                        type="text"
                        id="labelSingular"
                        required
                        placeholder="e.g. Product, Article, Testimonial"
                        class="w-full px-4 py-2 bg-background border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary"
                    />
                </div>

                <div>
                    <label
                        class="block text-sm font-bold tracking-wide text-foreground mb-1"
                        >API Slug (URL-friendly) <span class="text-red-500"
                            >*</span
                        ></label
                    >
                    <input
                        type="text"
                        id="slug"
                        required
                        placeholder="e.g. products, articles"
                        pattern="[a-z0-9-]+"
                        title="Only lowercase letters, numbers, and hyphens"
                        class="w-full px-4 py-2 bg-background border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary"
                    />
                    <p class="text-xs text-muted-foreground mt-1">
                        This will be the collection ID and database table slug.
                    </p>
                </div>

                <div>
                    <label
                        class="block text-sm font-bold tracking-wide text-foreground mb-1"
                        >Description</label
                    >
                    <textarea
                        id="description"
                        rows="2"
                        placeholder="Brief description of this content type..."
                        class="w-full px-4 py-2 bg-background border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary"
                    ></textarea>
                </div>

                <div>
                    <label
                        class="block text-sm font-bold tracking-wide text-foreground mb-1"
                        >Icon (Lucide Icon Name)</label
                    >
                    <input
                        type="text"
                        id="icon"
                        value="FileText"
                        class="w-full px-4 py-2 bg-background border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary"
                    />
                </div>
            </div>

            <div class="pt-4 border-t border-border flex justify-end">
                <button
                    type="submit"
                    id="submitBtn"
                    class="px-6 py-2.5 bg-primary text-primary-foreground font-bold rounded-md hover:bg-primary/90 transition-colors disabled:opacity-50"
                >
                    Create & Continue to Schema Builder &rarr;
                </button>
            </div>
        </form>
    </div>
</AdminLayout>

<script>
    document
        .getElementById("createCollectionForm")
        ?.addEventListener("submit", async (e) => {
            e.preventDefault();
            const submitBtn = document.getElementById(
                "submitBtn",
            ) as HTMLButtonElement;
            const errorDiv = document.getElementById("formError");

            submitBtn.disabled = true;
            submitBtn.innerText = "Creating...";
            if (errorDiv) errorDiv.classList.add("hidden");

            const payload = {
                label: (document.getElementById("label") as HTMLInputElement)
                    .value,
                labelSingular: (
                    document.getElementById("labelSingular") as HTMLInputElement
                ).value,
                slug: (document.getElementById("slug") as HTMLInputElement)
                    .value,
                description: (
                    document.getElementById(
                        "description",
                    ) as HTMLTextAreaElement
                ).value,
                icon: (document.getElementById("icon") as HTMLInputElement)
                    .value,
                routePrefix: "/",
                fields: "[]",
                supports: "{}",
            };

            try {
                const res = await fetch("/api/content-builder", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload),
                });
                const json = (await res.json()) as any;

                if (res.ok) {
                    window.location.href = `/admin/content-builder/edit/${json.slug}`;
                } else {
                    if (errorDiv) {
                        errorDiv.textContent = json.error;
                        errorDiv.classList.remove("hidden");
                    }
                    submitBtn.disabled = false;
                    submitBtn.innerText =
                        "Create & Continue to Schema Builder →";
                }
            } catch (err: any) {
                if (errorDiv) {
                    errorDiv.textContent = err.message;
                    errorDiv.classList.remove("hidden");
                }
                submitBtn.disabled = false;
                submitBtn.innerText = "Create & Continue to Schema Builder →";
            }
        });
</script>
