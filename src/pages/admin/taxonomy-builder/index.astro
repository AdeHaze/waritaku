---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/db';
import { taxonomies } from '../../../db/schema';
const env = Astro.locals?.runtime?.env;
import { Plus, FolderTree, Edit, Trash2 } from 'lucide-react';

const user = Astro.locals.user;
if (!user || (user.role !== 'admin' && user.role !== 'superadmin')) {
    return Astro.redirect('/admin/login');
}

const db = getDb(env);
const allTaxonomies = await db.select().from(taxonomies);
---

<AdminLayout title="Taxonomy Builder">
    <div class="max-w-7xl mx-auto space-y-6">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-black text-foreground uppercase tracking-tight">Taxonomy Builder</h1>
                <p class="text-muted-foreground mt-1">Create and manage content classification structures (e.g., Categories, Tags).</p>
            </div>
            <a href="/admin/taxonomy-builder/create" class="inline-flex items-center gap-2 bg-primary text-primary-foreground px-4 py-2 rounded-md hover:bg-primary/90 font-medium transition-colors">
                <Plus size={18} />
                New Taxonomy
            </a>
        </div>

        <div class="bg-card border border-border rounded-xl shadow-sm overflow-hidden">
            {allTaxonomies.length === 0 ? (
                <div class="p-12 text-center flex flex-col items-center">
                    <FolderTree size={48} class="text-muted-foreground/30 mb-4" />
                    <h3 class="text-xl font-bold text-foreground">No taxonomies found</h3>
                    <p class="text-muted-foreground mt-2 max-w-md mx-auto">You haven't created any custom taxonomies yet. Create your first taxonomy to start classifying your content.</p>
                    <a href="/admin/taxonomy-builder/create" class="mt-6 inline-flex items-center gap-2 bg-primary text-primary-foreground px-6 py-2.5 rounded-full hover:bg-primary/90 font-medium transition-all shadow hover:shadow-md">
                        <Plus size={18} />
                        Create Taxonomy
                    </a>
                </div>
            ) : (
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm whitespace-nowrap">
                        <thead class="bg-muted/50 text-muted-foreground border-b border-border">
                            <tr>
                                <th class="px-6 py-4 font-semibold">Taxonomy</th>
                                <th class="px-6 py-4 font-semibold">Slug</th>
                                <th class="px-6 py-4 font-semibold">Linked Collections</th>
                                <th class="px-6 py-4 font-semibold">Routing</th>
                                <th class="px-6 py-4 font-semibold text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border">
                            {allTaxonomies.map(tax => {
                                let allowed = [];
                                try { allowed = JSON.parse(tax.allowedCollections); } catch(e) {}
                                return (
                                    <tr class="hover:bg-muted/30 transition-colors group">
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-3">
                                                <div class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center">
                                                    <FolderTree size={16} />
                                                </div>
                                                <div>
                                                    <div class="font-bold text-foreground">{tax.label}</div>
                                                    <div class="text-xs text-muted-foreground max-w-xs truncate">{tax.description || 'No description'}</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4">
                                            <code class="px-2 py-1 bg-muted rounded text-xs text-muted-foreground font-mono">{tax.slug}</code>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="flex gap-1 flex-wrap max-w-[200px]">
                                                {allowed.length > 0 ? allowed.map((c: string) => (
                                                    <span class="px-2 py-0.5 bg-secondary text-secondary-foreground rounded text-[10px] uppercase font-bold tracking-wider">{c}</span>
                                                )) : (
                                                    <span class="text-muted-foreground text-xs italic">None</span>
                                                )}
                                            </div>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="flex flex-col gap-1">
                                                {tax.isRouted ? (
                                                    <span class="text-emerald-500 text-xs font-medium flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Archive Pages</span>
                                                ) : (
                                                    <span class="text-muted-foreground text-xs flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-border"></span> No Archive</span>
                                                )}
                                                {tax.prefixEntryUrl && (
                                                    <span class="text-blue-500 text-[10px] font-bold uppercase tracking-wider">Prefixes URLs</span>
                                                )}
                                            </div>
                                        </td>
                                        <td class="px-6 py-4 text-right">
                                            <div class="flex items-center justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                                <a href={`/admin/taxonomies/${tax.slug}`} class="p-2 text-muted-foreground hover:text-primary hover:bg-primary/10 rounded-md transition-colors tooltip-trigger" title="Manage Terms">
                                                    <FolderTree size={16} />
                                                </a>
                                                <a href={`/admin/taxonomy-builder/edit/${tax.id}`} class="p-2 text-muted-foreground hover:text-amber-500 hover:bg-amber-500/10 rounded-md transition-colors">
                                                    <Edit size={16} />
                                                </a>
                                                <button type="button" class="p-2 text-muted-foreground hover:text-destructive hover:bg-destructive/10 rounded-md transition-colors btn-delete" data-id={tax.id} data-name={tax.label}>
                                                    <Trash2 size={16} />
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                );
                            })}
                        </tbody>
                    </table>
                </div>
            )}
        </div>
    </div>

    <script>
        document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', async (e) => {
                const button = e.currentTarget as HTMLButtonElement;
                const id = button.dataset.id;
                const name = button.dataset.name;
                
                button.style.opacity = '0.5';
                button.style.pointerEvents = 'none';
                
                try {
                    // Fetch stats before deleting
                    const statsRes = await fetch(`/api/taxonomy-builder/${id}/stats`);
                    if (!statsRes.ok) throw new Error('Could not fetch taxonomy stats');
                    
                    const stats = await statsRes.json();
                    
                    let confirmMessage = `Are you sure you want to delete the taxonomy "${name}"?`;
                    
                    if (stats.termCount > 0) {
                        confirmMessage = `WARNING! You are currently attempting to delete ${stats.termCount.toLocaleString()} terms (tags/categories), which are interlinked with ${stats.entryCount.toLocaleString()} articles/entries in the database!\n\nDeleting this taxonomy will PERMANENTLY DESTROY all these terms and sever all connections.\n\nAre you absolutely sure you want to proceed?`;
                    } else {
                        confirmMessage += `\n\nThis will permanently delete it from the database.`;
                    }

                    if (confirm(confirmMessage)) {
                        const res = await fetch(`/api/taxonomy-builder/${id}`, { method: 'DELETE' });
                        if (res.ok) {
                            window.location.reload();
                        } else {
                            const err = await res.json();
                            alert(`Error deleting taxonomy: ${err.error}`);
                            button.style.opacity = '1';
                            button.style.pointerEvents = 'auto';
                        }
                    } else {
                        // User cancelled
                        button.style.opacity = '1';
                        button.style.pointerEvents = 'auto';
                    }
                } catch (error) {
                    alert('Network error while checking taxonomy stats.');
                    button.style.opacity = '1';
                    button.style.pointerEvents = 'auto';
                }
            });
        });
    </script>
</AdminLayout>
