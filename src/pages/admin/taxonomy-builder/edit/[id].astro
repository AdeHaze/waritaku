---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { getDb } from "../../../../lib/db";
import { collections, taxonomies } from "../../../../db/schema";
import { eq } from "drizzle-orm";
import { env } from 'cloudflare:workers';
import { Save, ArrowLeft } from "lucide-react";
import { hasPermission } from '../../../../lib/permissions';

const user = Astro.locals.user;
const permissions = Astro.locals.permissions;
const id = parseInt(Astro.params.id || "0", 10);
if (!id) return Astro.redirect("/404");

const db = getDb(env);
const allCollections = await db.select().from(collections);
const taxRes = await db
    .select()
    .from(taxonomies)
    .where(eq(taxonomies.id, id))
    .limit(1);

if (taxRes.length === 0) {
    return Astro.redirect("/404");
}
const taxonomy = taxRes[0];

if (!user || !permissions) {
    return Astro.redirect('/admin/login');
}
const isOwner = taxonomy.authorId === user.userId;
const canEdit = isOwner ? hasPermission(permissions, 'taxonomy_builder', 'edit_own') : hasPermission(permissions, 'taxonomy_builder', 'edit_others');
if (!canEdit) {
    return Astro.redirect('/admin/login');
}

let allowed = [];
try {
    allowed = JSON.parse(taxonomy.allowedCollections);
} catch (e) {}
---

<AdminLayout title="Edit Taxonomy">
    <div class="max-w-4xl mx-auto space-y-6 pb-20">
        <div class="flex items-center gap-4">
            <a
                href="/admin/taxonomy-builder"
                class="p-2 text-muted-foreground hover:text-foreground hover:bg-muted rounded-full transition-colors"
            >
                <ArrowLeft size={20} />
            </a>
            <div>
                <h1
                    class="text-3xl font-black text-foreground uppercase tracking-tight"
                >
                    Edit Taxonomy
                </h1>
                <p class="text-muted-foreground mt-1">
                    Modifying: {taxonomy.label}
                </p>
            </div>
        </div>

        <form id="edit-taxonomy-form" class="space-y-8" data-id={taxonomy.id}>
            <div
                class="bg-card border border-border rounded-xl shadow-sm p-6 space-y-6"
            >
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-2">
                        <label class="text-sm font-semibold text-foreground"
                            >Taxonomy Name <span class="text-destructive"
                                >*</span
                            ></label
                        >
                        <input
                            type="text"
                            name="label"
                            required
                            value={taxonomy.label}
                            class="w-full bg-background border border-border rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-primary/50"
                        />
                    </div>
                    <div class="space-y-2">
                        <label class="text-sm font-semibold text-foreground"
                            >Slug <span class="text-destructive">*</span></label
                        >
                        <input
                            type="text"
                            name="slug"
                            required
                            value={taxonomy.slug}
                            class="w-full bg-background border border-border rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-primary/50 font-mono text-sm"
                        />
                    </div>
                </div>

                <div class="space-y-2">
                    <label class="text-sm font-semibold text-foreground"
                        >Description</label
                    >
                    <textarea
                        name="description"
                        rows="2"
                        class="w-full bg-background border border-border rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-primary/50"
                        >{taxonomy.description}</textarea
                    >
                </div>
            </div>

            <div
                class="bg-card border border-border rounded-xl shadow-sm p-6 space-y-6"
            >
                <h3 class="font-bold text-lg border-b border-border pb-2">
                    Routing & SEO Settings
                </h3>
                <p class="text-sm text-muted-foreground">
                    Control how this taxonomy interacts with URLs and search
                    engines.
                </p>

                <div class="space-y-6">
                    <label class="flex items-start gap-3 cursor-pointer group">
                        <div class="mt-1">
                            <input
                                type="checkbox"
                                name="allowInlineCreation"
                                value="true"
                                checked={taxonomy.allowInlineCreation}
                                class="w-4 h-4 rounded border-border text-primary focus:ring-primary/50 bg-background"
                            />
                        </div>
                        <div class="w-full">
                            <div class="font-semibold text-foreground group-hover:text-primary transition-colors">
                                Allow Inline Creation
                            </div>
                            <div class="text-sm text-muted-foreground mt-1">
                                If checked, editors can create new terms on the fly while creating/editing an entry.
                            </div>
                            
                            <div class={`mt-3 pl-4 border-l-2 border-border space-y-2 ${taxonomy.allowInlineCreation ? '' : 'hidden'}`} id="inline-creation-options">
                                <label class="text-sm font-semibold text-foreground">Inline Search Hint</label>
                                <input
                                    type="text"
                                    name="inlineSearchHint"
                                    placeholder="e.g. The tag is massive, search first before creating"
                                    value={taxonomy.inlineSearchHint || ''}
                                    class="w-full bg-background border border-border rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-primary/50 text-sm"
                                />
                                <div class="text-xs text-muted-foreground">This text appears below the search bar to instruct editors.</div>
                            </div>
                        </div>
                    </label>

                    <label class="flex items-start gap-3 cursor-pointer group">
                        <div class="mt-1">
                            <input
                                type="checkbox"
                                name="isRouted"
                                value="true"
                                checked={taxonomy.isRouted}
                                class="w-4 h-4 rounded border-border text-primary focus:ring-primary/50 bg-background"
                            />
                        </div>
                        <div class="w-full">
                            <div
                                class="font-semibold text-foreground group-hover:text-primary transition-colors"
                            >
                                Enable Archive Pages
                            </div>
                            <div class="text-sm text-muted-foreground mt-1">
                                If checked, this taxonomy will generate
                                dedicated archive pages for each term.
                            </div>

                            <div
                                id="route-format-options"
                                class={`mt-3 pl-4 border-l-2 border-border space-y-3 ${taxonomy.isRouted ? "" : "hidden"}`}
                            >
                                <label
                                    class="flex items-center gap-2 cursor-pointer"
                                >
                                    <input
                                        type="radio"
                                        name="omitTaxonomySlug"
                                        value="false"
                                        checked={!taxonomy.omitTaxonomySlug}
                                        class="text-primary focus:ring-primary/50"
                                    />
                                    <span class="text-sm font-medium"
                                        >Long Format (e.g. <code
                                            class="bg-muted px-1 rounded text-xs"
                                            >/taxonomy-slug/term-slug</code
                                        >)</span
                                    >
                                </label>
                                <div class="space-y-1">
                                    <label class="flex items-center gap-2 cursor-pointer">
                                        <input
                                            type="radio"
                                            name="omitTaxonomySlug"
                                            value="true"
                                            checked={taxonomy.omitTaxonomySlug}
                                            class="text-primary focus:ring-primary/50"
                                        />
                                        <span class="text-sm font-medium"
                                            >Short Format (e.g. <code
                                                class="bg-muted px-1 rounded text-xs"
                                                >/term-slug</code
                                            >)</span
                                        >
                                    </label>
                                    <div class="text-xs text-amber-500 font-medium bg-amber-500/10 px-2 py-1.5 rounded inline-block ml-6">
                                        Warning: This can cause slug collisions with entries. If a collision occurs, entries will take precedence, and term slugs will be appended with -2.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </label>

                    <div class="space-y-3 pt-2">
                        <div>
                            <div class="font-semibold text-foreground group-hover:text-primary transition-colors">
                                Prefix Entry URLs
                            </div>
                            <div class="text-sm text-muted-foreground mt-1">
                                Control how entries assigned to this taxonomy are formatted in URLs.
                            </div>
                            <div class="text-xs text-amber-500 mt-1 font-medium bg-amber-500/10 px-2 py-1 rounded inline-block">
                                Note: If multiple terms are assigned to an entry, the taxonomy priority configured in the Content Builder is used.
                            </div>
                        </div>

                        <div class="pl-4 border-l-2 border-border space-y-3">
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input
                                    type="radio"
                                    name="entryUrlFormat"
                                    value="long"
                                    checked={taxonomy.entryUrlFormat === 'long'}
                                    class="text-primary focus:ring-primary/50"
                                />
                                <span class="text-sm font-medium">Long Format (e.g. <code class="bg-muted px-1 rounded text-xs">/taxonomy-slug/term-slug/entry-slug</code>)</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input
                                    type="radio"
                                    name="entryUrlFormat"
                                    value="short"
                                    checked={taxonomy.entryUrlFormat === 'short' || taxonomy.entryUrlFormat === 'default'}
                                    class="text-primary focus:ring-primary/50"
                                />
                                <span class="text-sm font-medium">Short Format (e.g. <code class="bg-muted px-1 rounded text-xs">/term-slug/entry-slug</code>)</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input
                                    type="radio"
                                    name="entryUrlFormat"
                                    value="none"
                                    checked={taxonomy.entryUrlFormat === 'none'}
                                    class="text-primary focus:ring-primary/50"
                                />
                                <span class="text-sm font-medium">No Prefix (e.g. <code class="bg-muted px-1 rounded text-xs">/entry-slug</code>)</span>
                            </label>
                        </div>
                    </div>
                    
                    <div class="border-t border-border my-4 pt-4">
                        <h4 class="font-bold text-sm mb-3 uppercase tracking-wider text-muted-foreground">Umbrella Archive Page (/taxonomy)</h4>
                        
                        <div class="space-y-4 pl-4 border-l-2 border-primary/20">
                            <div>
                                <div class="font-semibold text-foreground text-sm">View Mode</div>
                                <div class="text-xs text-muted-foreground mt-1 mb-2">Control what is displayed when visiting the main taxonomy index page.</div>
                                <select name="umbrellaViewMode" class="w-full max-w-xs px-3 py-1.5 text-sm bg-background border border-input rounded focus:outline-none focus:ring-1 focus:ring-primary">
                                    <option value="child_terms" selected={taxonomy.umbrellaViewMode === 'child_terms' || !taxonomy.umbrellaViewMode}>List Child Terms (Default)</option>
                                    <option value="all_entries" selected={taxonomy.umbrellaViewMode === 'all_entries'}>List All Entries (Paginated Grid)</option>
                                </select>
                            </div>
                            
                            <div>
                                <div class="font-semibold text-foreground text-sm">Items Per Page</div>
                                <div class="text-xs text-muted-foreground mt-1 mb-2">Number of items to show per page before paginating.</div>
                                <select name="umbrellaItemsPerPage" class="w-full max-w-xs px-3 py-1.5 text-sm bg-background border border-input rounded focus:outline-none focus:ring-1 focus:ring-primary">
                                    <option value="0" selected={taxonomy.umbrellaItemsPerPage === 0 || !taxonomy.umbrellaItemsPerPage}>Fetch All (No Pagination)</option>
                                    <option value="12" selected={taxonomy.umbrellaItemsPerPage === 12}>12 Items</option>
                                    <option value="24" selected={taxonomy.umbrellaItemsPerPage === 24}>24 Items</option>
                                    <option value="48" selected={taxonomy.umbrellaItemsPerPage === 48}>48 Items</option>
                                    <option value="100" selected={taxonomy.umbrellaItemsPerPage === 100}>100 Items</option>
                                </select>
                            </div>
                            
                            <label class="flex items-start gap-3 cursor-pointer group">
                                <div class="mt-0.5">
                                    <input type="checkbox" name="umbrellaAllowIndexing" value="true" checked={taxonomy.umbrellaAllowIndexing !== false} class="w-4 h-4 rounded border-border text-primary focus:ring-primary/50 bg-background" />
                                </div>
                                <div>
                                    <div class="font-semibold text-foreground text-sm group-hover:text-primary transition-colors">Allow Search Engine Indexing</div>
                                    <div class="text-xs text-muted-foreground mt-1">If unchecked, the umbrella archive page will output a <code class="bg-muted px-1 py-0.5 rounded text-[10px]">&lt;meta name="robots" content="noindex"&gt;</code> tag.</div>
                                </div>
                            </label>
                        </div>
                    </div>

                    <div class="border-t border-border my-4 pt-4">
                        <h4 class="font-bold text-sm mb-3 uppercase tracking-wider text-muted-foreground">Term Archive Pages (/taxonomy/term)</h4>
                        
                        <label class="flex items-start gap-3 cursor-pointer group pl-4 border-l-2 border-primary/20">
                            <div class="mt-0.5">
                                <input
                                    type="checkbox"
                                    name="allowIndexing"
                                    value="true"
                                    checked={taxonomy.allowIndexing}
                                    class="w-4 h-4 rounded border-border text-primary focus:ring-primary/50 bg-background"
                                />
                            </div>
                            <div>
                                <div class="font-semibold text-foreground text-sm group-hover:text-primary transition-colors">Allow Search Engine Indexing</div>
                                <div class="text-xs text-muted-foreground mt-1">If unchecked, individual term pages will output a <code class="bg-muted px-1 py-0.5 rounded text-[10px]">&lt;meta name="robots" content="noindex"&gt;</code> tag.</div>
                            </div>
                        </label>
                    </div>
                </div>
            </div>

            <div
                class="bg-card border border-border rounded-xl shadow-sm p-6 space-y-4"
            >
                <h3 class="font-bold text-lg border-b border-border pb-2">
                    Allowed Collections
                </h3>
                <p class="text-sm text-muted-foreground">
                    Select which Content Types (Collections) can use this
                    taxonomy.
                </p>

                <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                    {
                        allCollections.map((col) => (
                            <label class="flex items-center gap-3 p-3 rounded-lg border border-border bg-background hover:bg-muted/30 cursor-pointer transition-colors">
                                <input
                                    type="checkbox"
                                    name="allowedCollections"
                                    value={col.slug}
                                    checked={allowed.includes(col.slug)}
                                    class="w-4 h-4 rounded border-border text-primary focus:ring-primary/50 bg-background"
                                />
                                <span class="font-medium text-sm">
                                    {col.label}
                                </span>
                            </label>
                        ))
                    }
                    {
                        allCollections.length === 0 && (
                            <div class="col-span-full text-sm text-amber-500 bg-amber-500/10 p-4 rounded-lg">
                                No collections found. You must create a Content
                                Collection before assigning taxonomies.
                            </div>
                        )
                    }
                </div>
            </div>

            <div class="flex justify-end pt-4">
                <button
                    type="submit"
                    class="inline-flex items-center gap-2 bg-primary text-primary-foreground px-8 py-2.5 rounded-full hover:bg-primary/90 font-medium transition-all shadow hover:shadow-md"
                >
                    <Save size={18} />
                    Save Changes
                </button>
            </div>
        </form>
    </div>

    <script>
        const form = document.getElementById(
            "edit-taxonomy-form",
        ) as HTMLFormElement;

        const isRoutedCb = form.querySelector(
            'input[name="isRouted"]',
        ) as HTMLInputElement;
        const formatOptions = document.getElementById("route-format-options");
        isRoutedCb.addEventListener("change", (e) => {
            if ((e.target as HTMLInputElement).checked)
                formatOptions?.classList.remove("hidden");
            else formatOptions?.classList.add("hidden");
        });

        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            const btn = form.querySelector(
                'button[type="submit"]',
            ) as HTMLButtonElement;
            btn.disabled = true;
            btn.innerHTML = "Saving...";

            const formData = new FormData(form);
            const id = form.dataset.id;

            const data: any = {
                label: formData.get("label"),
                slug: formData.get("slug"),
                description: formData.get("description"),
                isRouted: formData.get("isRouted") === "true",
                entryUrlFormat: formData.get("entryUrlFormat"),
                allowIndexing: formData.get("allowIndexing") === "true",
                umbrellaViewMode: formData.get("umbrellaViewMode") || "child_terms",
                umbrellaItemsPerPage: formData.get("umbrellaItemsPerPage"),
                umbrellaAllowIndexing: formData.get("umbrellaAllowIndexing") === "true",
                omitTaxonomySlug: formData.get("omitTaxonomySlug") === "true",
                allowInlineCreation: formData.get("allowInlineCreation") === "true",
                inlineSearchHint: formData.get("inlineSearchHint"),
                allowedCollections: formData.getAll("allowedCollections"),
            };

            // Maintain backwards compatibility with API logic
            data.prefixEntryUrl = data.entryUrlFormat !== 'none';

            try {
                const res = await fetch(`/api/taxonomy-builder/${id}`, {
                    method: "PUT",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(data),
                });

                if (res.ok) {
                    window.location.href = "/admin/taxonomy-builder";
                } else {
                    const err = (await res.json()) as any;
                    alert(`Error updating taxonomy: ${err.error}`);
                    btn.disabled = false;
                    btn.innerHTML = "Save Changes";
                }
            } catch (error) {
                alert("Network error while saving.");
                btn.disabled = false;
                btn.innerHTML = "Save Changes";
            }
        // Toggle inline creation options
        const inlineCreationCheckbox = document.querySelector('input[name="allowInlineCreation"]');
        const inlineCreationOptions = document.getElementById("inline-creation-options");
        if (inlineCreationCheckbox && inlineCreationOptions) {
            inlineCreationCheckbox.addEventListener("change", (e: any) => {
                if (e.target.checked) {
                    inlineCreationOptions.classList.remove("hidden");
                } else {
                    inlineCreationOptions.classList.add("hidden");
                }
            });
        }
    });
</script>
</AdminLayout>
