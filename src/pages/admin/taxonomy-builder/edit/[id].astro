---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getDb } from '../../../../lib/db';
import { collections, taxonomies } from '../../../../db/schema';
import { eq } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { Save, ArrowLeft } from 'lucide-react';

const user = Astro.locals.user;
if (!user || (user.role !== 'admin' && user.role !== 'superadmin')) {
    return Astro.redirect('/admin/login');
}

const id = parseInt(Astro.params.id || '0', 10);
if (!id) return Astro.redirect('/404');

const db = getDb(env);
const allCollections = await db.select().from(collections);
const taxRes = await db.select().from(taxonomies).where(eq(taxonomies.id, id)).limit(1);

if (taxRes.length === 0) {
    return Astro.redirect('/404');
}

const taxonomy = taxRes[0];
let allowed = [];
try { allowed = JSON.parse(taxonomy.allowedCollections); } catch(e) {}
---

<AdminLayout title="Edit Taxonomy">
    <div class="max-w-4xl mx-auto space-y-6 pb-20">
        <div class="flex items-center gap-4">
            <a href="/admin/taxonomy-builder" class="p-2 text-muted-foreground hover:text-foreground hover:bg-muted rounded-full transition-colors">
                <ArrowLeft size={20} />
            </a>
            <div>
                <h1 class="text-3xl font-black text-foreground uppercase tracking-tight">Edit Taxonomy</h1>
                <p class="text-muted-foreground mt-1">Modifying: {taxonomy.label}</p>
            </div>
        </div>

        <form id="edit-taxonomy-form" class="space-y-8" data-id={taxonomy.id}>
            <div class="bg-card border border-border rounded-xl shadow-sm p-6 space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-2">
                        <label class="text-sm font-semibold text-foreground">Taxonomy Name <span class="text-destructive">*</span></label>
                        <input type="text" name="label" required value={taxonomy.label} class="w-full bg-background border border-border rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-primary/50" />
                    </div>
                    <div class="space-y-2">
                        <label class="text-sm font-semibold text-foreground">Slug <span class="text-destructive">*</span></label>
                        <input type="text" name="slug" required value={taxonomy.slug} class="w-full bg-background border border-border rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-primary/50 font-mono text-sm" />
                    </div>
                </div>
                
                <div class="space-y-2">
                    <label class="text-sm font-semibold text-foreground">Description</label>
                    <textarea name="description" rows="2" class="w-full bg-background border border-border rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-primary/50">{taxonomy.description}</textarea>
                </div>
            </div>

            <div class="bg-card border border-border rounded-xl shadow-sm p-6 space-y-6">
                <h3 class="font-bold text-lg border-b border-border pb-2">Routing & SEO Settings</h3>
                <p class="text-sm text-muted-foreground">Control how this taxonomy interacts with URLs and search engines.</p>
                
                <div class="space-y-6">
                    <label class="flex items-start gap-3 cursor-pointer group">
                        <div class="mt-1">
                            <input type="checkbox" name="isRouted" value="true" checked={taxonomy.isRouted} class="w-4 h-4 rounded border-border text-primary focus:ring-primary/50 bg-background" />
                        </div>
                        <div>
                            <div class="font-semibold text-foreground group-hover:text-primary transition-colors">Enable Archive Pages</div>
                            <div class="text-sm text-muted-foreground mt-1">If checked, this taxonomy will generate dedicated archive pages for each term.</div>
                        </div>
                    </label>

                    <label class="flex items-start gap-3 cursor-pointer group">
                        <div class="mt-1">
                            <input type="checkbox" name="prefixEntryUrl" value="true" checked={taxonomy.prefixEntryUrl} class="w-4 h-4 rounded border-border text-primary focus:ring-primary/50 bg-background" />
                        </div>
                        <div>
                            <div class="font-semibold text-foreground group-hover:text-primary transition-colors">Prefix Entry URLs with Term Slug</div>
                            <div class="text-sm text-muted-foreground mt-1">If checked, any entry assigned a term from this taxonomy will have the term's slug prefixed to its URL.</div>
                            <div class="text-xs text-amber-500 mt-1 font-medium bg-amber-500/10 px-2 py-1 rounded inline-block">Note: If multiple terms are assigned to an entry, the first attached term is used.</div>
                        </div>
                    </label>

                    <label class="flex items-start gap-3 cursor-pointer group">
                        <div class="mt-1">
                            <input type="checkbox" name="allowIndexing" value="true" checked={taxonomy.allowIndexing} class="w-4 h-4 rounded border-border text-primary focus:ring-primary/50 bg-background" />
                        </div>
                        <div>
                            <div class="font-semibold text-foreground group-hover:text-primary transition-colors">Allow Search Engine Indexing</div>
                            <div class="text-sm text-muted-foreground mt-1">If unchecked, the taxonomy archive pages will output a <code class="bg-muted px-1 py-0.5 rounded text-xs">&lt;meta name="robots" content="noindex"&gt;</code> tag.</div>
                        </div>
                    </label>
                </div>
            </div>

            <div class="bg-card border border-border rounded-xl shadow-sm p-6 space-y-4">
                <h3 class="font-bold text-lg border-b border-border pb-2">Allowed Collections</h3>
                <p class="text-sm text-muted-foreground">Select which Content Types (Collections) can use this taxonomy.</p>
                
                <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                    {allCollections.map(col => (
                        <label class="flex items-center gap-3 p-3 rounded-lg border border-border bg-background hover:bg-muted/30 cursor-pointer transition-colors">
                            <input type="checkbox" name="allowedCollections" value={col.slug} checked={allowed.includes(col.slug)} class="w-4 h-4 rounded border-border text-primary focus:ring-primary/50 bg-background" />
                            <span class="font-medium text-sm">{col.label}</span>
                        </label>
                    ))}
                    {allCollections.length === 0 && (
                        <div class="col-span-full text-sm text-amber-500 bg-amber-500/10 p-4 rounded-lg">
                            No collections found. You must create a Content Collection before assigning taxonomies.
                        </div>
                    )}
                </div>
            </div>

            <div class="flex justify-end pt-4">
                <button type="submit" class="inline-flex items-center gap-2 bg-primary text-primary-foreground px-8 py-2.5 rounded-full hover:bg-primary/90 font-medium transition-all shadow hover:shadow-md">
                    <Save size={18} />
                    Save Changes
                </button>
            </div>
        </form>
    </div>

    <script>
        const form = document.getElementById('edit-taxonomy-form') as HTMLFormElement;
        
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
            btn.disabled = true;
            btn.innerHTML = 'Saving...';

            const formData = new FormData(form);
            const id = form.dataset.id;
            
            const data: any = {
                label: formData.get('label'),
                slug: formData.get('slug'),
                description: formData.get('description'),
                isRouted: formData.get('isRouted') === 'true',
                prefixEntryUrl: formData.get('prefixEntryUrl') === 'true',
                allowIndexing: formData.get('allowIndexing') === 'true',
                allowedCollections: formData.getAll('allowedCollections')
            };

            try {
                const res = await fetch(`/api/taxonomy-builder/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (res.ok) {
                    window.location.href = '/admin/taxonomy-builder';
                } else {
                    const err = await res.json();
                    alert(`Error updating taxonomy: ${err.error}`);
                    btn.disabled = false;
                    btn.innerHTML = 'Save Changes';
                }
            } catch (error) {
                alert('Network error while saving.');
                btn.disabled = false;
                btn.innerHTML = 'Save Changes';
            }
        });
    </script>
</AdminLayout>
