---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { settings } from '../../db/schema';
import { eq } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { getDb } from '../../lib/db';


const user = Astro.locals.user;
if (!user || user.role !== 'superadmin') {
    return Astro.redirect('/admin');
}

let db = null;
if (env && env.DB) {
    db = getDb(env);
}

let message = '';
let isError = false;
let secrets = {
    telegramBotToken: '',
    openaiApiKey: '',
    senderEmail: 'noreply@resend.waritaku.com',
    customSecretsJson: '{}'
};
let resendStatus = 'missing';
if (env && (env as any).RESEND_API_KEY) {
    const key = (env as any).RESEND_API_KEY as string;
    if (key.startsWith('re_')) resendStatus = 'connected';
    else resendStatus = 'invalid';
}
let dbEnvironment = 'Local Development';
let imageEnv = 'Local Disk';
if (env && (env as any).UPLOADS) {
    imageEnv = 'Cloudflare R2';
}

// Load existing settings first
if (db) {
    const allSettings = await db.select().from(settings);
    const secSetting = allSettings.find(s => s.key === 'system_secrets');
    if (secSetting) {
        try { secrets = { ...secrets, ...JSON.parse(secSetting.value) }; } catch(e) {}
    }
    const envSetting = allSettings.find(s => s.key === 'database_environment');
    if (envSetting) {
        dbEnvironment = envSetting.value;
    }
}

if (Astro.request.method === 'POST') {
    try {
        const formData = await Astro.request.formData();
        const action = formData.get('action');

        if (action === 'update_environment') {
            const newEnv = formData.get('databaseEnvironment') as string;
            if (db && newEnv) {
                await db.insert(settings)
                    .values({ key: 'database_environment', value: newEnv })
                    .onConflictDoUpdate({ target: settings.key, set: { value: newEnv } });
                message = 'Database environment label updated successfully.';
                dbEnvironment = newEnv;
            }
        } else {
            const newSecrets = {
                telegramBotToken: formData.get('telegramBotToken') as string || '',
                openaiApiKey: formData.get('openaiApiKey') as string || '',
                senderEmail: formData.get('senderEmail') as string || 'noreply@resend.waritaku.com',
                customSecretsJson: formData.get('customSecretsJson') as string || '{}'
            };

            // Validate JSON
            JSON.parse(newSecrets.customSecretsJson);

            if (db) {
                const configStr = JSON.stringify(newSecrets);
                await db.insert(settings)
                    .values({ key: 'system_secrets', value: configStr })
                    .onConflictDoUpdate({ target: settings.key, set: { value: configStr } });

                message = 'System secrets updated successfully.';
                secrets = newSecrets;
            }
        }
    } catch (e: any) {
        message = 'Error saving settings: ' + e.message;
        isError = true;
    }
}
---

<AdminLayout title="Advanced System Settings">
    <div class="max-w-4xl">
        <div class="mb-8 flex flex-col sm:flex-row sm:items-start justify-between gap-4">
            <div>
                <h2 class="text-3xl font-bold tracking-tight text-foreground">Advanced System Settings</h2>
                <p class="text-muted-foreground mt-2">Manage API keys, sensitive configurations, and perform database backups.</p>
            </div>
            <div class="flex flex-col items-end gap-3 shrink-0">
                <a href="/admin/docs#docs-system-advanced" class="inline-flex items-center gap-1.5 text-sm font-bold text-primary bg-primary/10 hover:bg-primary/20 px-4 py-2 rounded-full transition-colors border border-primary/20 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                    Read Documentation
                </a>
                {message && (
                    <div class={`px-4 py-2 text-sm rounded-md font-medium ${isError ? 'bg-destructive/10 text-destructive border border-destructive/20' : 'bg-green-500/10 text-green-600 border border-green-500/20'}`}>
                        {message}
                    </div>
                )}
            </div>
        </div>

        <div class="space-y-8">
            {/* ── WordPress Import Card ──────────────────────────────────────── */}
            <div class="bg-card border border-border rounded-xl shadow-sm overflow-hidden relative" id="wp-import-section">
                <div class="absolute top-0 left-0 w-1 h-full bg-orange-500"></div>
                <div class="p-6">
                    <div class="mb-6 pb-4 border-b border-border flex justify-between items-start">
                        <div>
                            <h3 class="text-lg font-bold flex items-center gap-2">
                                <span class="text-2xl">🗃️</span>
                                WordPress Database Import
                            </h3>
                            <p class="text-sm text-muted-foreground mt-1">
                                Import your real WordPress database into Waritaku in two steps.
                            </p>
                        </div>
                    </div>

                    {/* Step 1 */}
                    <div class="space-y-4">
                        <div class="flex gap-4 items-start p-4 bg-muted/20 border border-border rounded-lg">
                            <div class="size-8 rounded-full bg-orange-500 text-white flex items-center justify-center text-sm font-bold shrink-0">1</div>
                            <div class="flex-1">
                                <h4 class="font-bold text-sm">Generate import_payload.json (run once, locally)</h4>
                                <p class="text-xs text-muted-foreground mt-1 mb-3">
                                    This script reads your raw WordPress SQL dump and maps it to the Waritaku schema.
                                    Run from the project root:
                                </p>
                                <code class="block bg-background border border-border rounded-md px-3 py-2 text-xs font-mono text-foreground">
                                    node scripts/wp-import.mjs
                                </code>
                                <p class="text-xs text-muted-foreground mt-2">
                                    Default SQL path: <code class="font-mono text-xs">../waritaku.old/u637737143_nOzYvIanNOaEnU.sql</code>
                                </p>
                            </div>
                        </div>

                        {/* Step 2 */}
                        <div class="flex gap-4 items-start p-4 bg-muted/20 border border-border rounded-lg">
                            <div class="size-8 rounded-full bg-orange-500 text-white flex items-center justify-center text-sm font-bold shrink-0">2</div>
                            <div class="flex-1">
                                <h4 class="font-bold text-sm">Upload &amp; Import</h4>
                                <p class="text-xs text-muted-foreground mt-1 mb-3">
                                    Select the generated <code class="font-mono">scripts/import_payload.json</code> file and click Import.
                                    Re-importing is safe — existing rows are skipped.
                                </p>
                                <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center">
                                    <input
                                        id="wp-import-file"
                                        type="file"
                                        accept=".json,application/json"
                                        class="text-sm file:mr-3 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-orange-500 file:text-white hover:file:bg-orange-600 cursor-pointer text-muted-foreground"
                                    />
                                    <div class="flex gap-2">
                                        <button
                                            id="wp-import-btn"
                                            type="button"
                                            class="px-5 py-2 bg-orange-500 text-white font-semibold text-sm rounded-md hover:bg-orange-600 active:scale-95 transition-all shadow-sm disabled:opacity-60 disabled:cursor-not-allowed"
                                        >
                                            Start Import
                                        </button>
                                        <button
                                            id="wp-import-reset"
                                            type="button"
                                            class="px-4 py-2 bg-muted text-muted-foreground font-medium text-sm rounded-md hover:bg-muted/80 transition-colors"
                                        >
                                            Reset
                                        </button>
                                    </div>
                                </div>

                                <div id="wp-import-status" class=""></div>

                                <div id="wp-import-progress" class="hidden mt-4">
                                    <div class="w-full h-1.5 bg-muted rounded-full overflow-hidden">
                                        <div class="h-full bg-orange-500 animate-pulse rounded-full" style="width: 100%"></div>
                                    </div>
                                </div>

                                <div id="wp-import-stats" class="hidden"></div>
                            </div>
                        </div>

                        {/* Notes */}
                        <div class="p-4 bg-amber-50 dark:bg-amber-950/20 border border-amber-200 dark:border-amber-800/30 rounded-lg">
                            <h5 class="text-xs font-bold text-amber-800 dark:text-amber-400 mb-2">Import Notes</h5>
                            <ul class="text-xs text-amber-700 dark:text-amber-500 space-y-1 list-disc list-inside">
                                <li>Password hashes are preserved. Users with <code class="font-mono">$wp$2y$</code> (bcrypt) hashes can log in immediately.</li>
                                <li>Users with <code class="font-mono">$P$</code> (old phpass) hashes must have their password reset by an admin.</li>
                                <li>WordPress image URLs are kept as-is — they resolve to the live site while it is still online.</li>
                                <li>All <code class="font-mono">[caption]</code> shortcodes are automatically converted to clean <code class="font-mono">&lt;figure&gt;</code> HTML.</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            {/* Database Management Card */}
            <div class="bg-card border border-destructive/30 rounded-xl shadow-sm overflow-hidden relative">
                <div class="absolute top-0 left-0 w-1 h-full bg-destructive"></div>
                <div class="p-6">
                    <div class="mb-6 pb-4 border-b border-border flex justify-between items-start">
                        <div>
                            <h3 class="text-lg font-bold text-destructive">Database Management</h3>
                            <p class="text-sm text-muted-foreground mt-1">Export your entire Cloudflare D1 database. Restoration must be done via Wrangler CLI.</p>
                        </div>
                    </div>
                    
                    <div class="flex flex-col sm:flex-row gap-4 items-center p-4 bg-muted/20 border border-border rounded-lg">
                        <div class="flex-1">
                            <h4 class="font-bold text-sm">Full Database Export (JSON)</h4>
                            <p class="text-xs text-muted-foreground mt-1">Downloads a complete snapshot of all tables, users, articles, and settings.</p>
                        </div>
                        <a href="/api/export-db" download="waritaku-backup.json" class="px-4 py-2 bg-foreground text-background font-bold text-sm rounded-md shadow hover:bg-foreground/90 transition-colors inline-flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                            Download Backup
                        </a>
                    </div>
                </div>
            </div>

            {/* Image Storage Location Card */}
            <div class="bg-card border border-border rounded-xl shadow-sm overflow-hidden relative">
                <div class={`absolute top-0 left-0 w-1 h-full ${imageEnv === 'Cloudflare R2' ? 'bg-blue-500' : 'bg-slate-500'}`}></div>
                <div class="p-6">
                    <div class="mb-4 pb-4 border-b border-border flex justify-between items-start">
                        <div>
                            <h3 class="text-lg font-bold">Image Storage Location</h3>
                            <p class="text-sm text-muted-foreground mt-1">This system automatically switches between Local Disk and Cloudflare R2 based on the environment.</p>
                        </div>
                    </div>
                    
                    <div class="flex gap-4 items-center p-4 bg-muted/20 border border-border rounded-lg">
                        <div class={`size-12 rounded-full flex items-center justify-center shrink-0 ${imageEnv === 'Cloudflare R2' ? 'bg-blue-100 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400' : 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400'}`}>
                            <span class="text-2xl">{imageEnv === 'Cloudflare R2' ? '☁️' : '📁'}</span>
                        </div>
                        <div>
                            <h4 class="font-bold text-sm">Currently Serving From: <span class={imageEnv === 'Cloudflare R2' ? 'text-blue-600 dark:text-blue-400' : 'text-slate-600 dark:text-slate-400'}>{imageEnv}</span></h4>
                            <p class="text-xs text-muted-foreground mt-1">
                                {imageEnv === 'Cloudflare R2' 
                                    ? 'Images are being streamed directly from the Cloudflare R2 "UPLOADS" binding at the edge.' 
                                    : 'Images are being served locally via Vite middleware to prevent Astro build bloat.'}
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            {/* Database Environment Label Form */}
            <form method="POST" class="bg-card border border-border rounded-xl shadow-sm">
                <input type="hidden" name="action" value="update_environment" />
                <div class="p-6">
                    <div class="mb-6 pb-4 border-b border-border">
                        <h3 class="text-lg font-bold">Database Environment Indicator</h3>
                        <p class="text-sm text-muted-foreground mt-1">Set a label for this specific database so you don't accidentally modify it assuming it's another environment.</p>
                    </div>
                    
                    <div class="space-y-4">
                        <label class="text-sm font-semibold">Current Database Environment</label>
                        <select name="databaseEnvironment" class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
                            <option value="Local Development" selected={dbEnvironment === 'Local Development'}>🟢 Local Development</option>
                            <option value="Local Cloud Development" selected={dbEnvironment === 'Local Cloud Development'}>🟡 Local Cloud Development</option>
                            <option value="Production" selected={dbEnvironment === 'Production'}>🔴 Production</option>
                        </select>
                        <p class="text-[11px] text-muted-foreground">This label is saved securely in this database's settings table and will appear globally across the admin panel.</p>
                    </div>
                </div>
                
                <div class="p-6 bg-muted/30 border-t border-border flex justify-end">
                    <button type="submit" class="px-6 py-2.5 bg-primary text-primary-foreground font-medium rounded-md hover:bg-primary/90 transition-colors shadow-sm">
                        Save Environment Label
                    </button>
                </div>
            </form>

            {/* Secrets Manager Form */}
            <form method="POST" class="bg-card border border-border rounded-xl shadow-sm">
                <div class="p-6">
                    <div class="mb-6 pb-4 border-b border-border">
                        <h3 class="text-lg font-bold">Secrets Store</h3>
                        <p class="text-sm text-muted-foreground mt-1">Securely store API keys for external services. These will be encrypted and accessible by the backend.</p>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label class="text-sm font-semibold">Telegram Bot Token</label>
                            <input type="password" name="telegramBotToken" value={secrets.telegramBotToken} placeholder="123456789:ABCdefGHIjklMNO..." class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring font-mono" />
                            <p class="text-[11px] text-muted-foreground">Used for sending notifications to Telegram.</p>
                        </div>

                        <div class="space-y-2">
                            <label class="text-sm font-semibold">OpenAI API Key</label>
                            <input type="password" name="openaiApiKey" value={secrets.openaiApiKey} placeholder="sk-..." class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring font-mono" />
                            <p class="text-[11px] text-muted-foreground">Used for AI content generation tools.</p>
                        </div>

                        <div class="space-y-2">
                            <label class="text-sm font-semibold">Resend Connection Status</label>
                            <div class={`flex items-center gap-2 h-10 px-3 py-2 rounded-md border text-sm font-medium ${resendStatus === 'connected' ? 'bg-emerald-500/10 text-emerald-600 border-emerald-500/30' : resendStatus === 'invalid' ? 'bg-yellow-500/10 text-yellow-600 border-yellow-500/30' : 'bg-destructive/10 text-destructive border-destructive/30'}`}>
                                <span class="text-lg">{resendStatus === 'connected' ? '🟢' : resendStatus === 'invalid' ? '🟡' : '🔴'}</span>
                                {resendStatus === 'connected' ? 'Secured & Connected (.dev.vars)' : resendStatus === 'invalid' ? 'Invalid Key Format' : 'Missing from Environment'}
                            </div>
                            <p class="text-[11px] text-muted-foreground">API key securely loaded from Cloudflare Worker.</p>
                        </div>

                        <div class="space-y-2">
                            <label class="text-sm font-semibold">Sender Email Address</label>
                            <input type="email" name="senderEmail" value={secrets.senderEmail} placeholder="noreply@resend.waritaku.com" class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" />
                            <p class="text-[11px] text-muted-foreground">Used as the "From" address for all outbound emails.</p>
                        </div>

                        <div class="space-y-2 md:col-span-2 mt-4 pt-4 border-t border-border">
                            <label class="text-sm font-semibold">Custom Secrets (Raw JSON)</label>
                            <textarea 
                                name="customSecretsJson" 
                                rows="6"
                                class="flex w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring font-mono"
                            >{secrets.customSecretsJson}</textarea>
                            <p class="text-[11px] text-muted-foreground">Define any additional keys required by plugins in strict JSON format.</p>
                        </div>
                    </div>
                </div>
                
                <div class="p-6 bg-muted/30 border-t border-border flex justify-end">
                    <button type="submit" class="px-6 py-2.5 bg-primary text-primary-foreground font-medium rounded-md hover:bg-primary/90 transition-colors shadow-sm">
                        Save System Secrets
                    </button>
                </div>
            </form>
        </div>
    </div>

    {/* ── WordPress Import UI ─────────────────────────────────────────────── */}
    <script>
    (function () {
      const fileInput = document.getElementById('wp-import-file') as HTMLInputElement;
      const importBtn = document.getElementById('wp-import-btn') as HTMLButtonElement;
      const resetBtn = document.getElementById('wp-import-reset');
      const statusBox = document.getElementById('wp-import-status');
      const progressBox = document.getElementById('wp-import-progress');
      const statsBox = document.getElementById('wp-import-stats');

      function setStatus(msg: string, type: 'idle' | 'loading' | 'success' | 'error') {
        if (!statusBox) return;
        const colors = {
          idle:    'text-muted-foreground',
          loading: 'text-yellow-600 dark:text-yellow-400',
          success: 'text-green-600 dark:text-green-400',
          error:   'text-destructive',
        };
        statusBox.className = `text-sm font-medium mt-3 ${colors[type]}`;
        statusBox.textContent = msg;
      }

      if (importBtn) {
        importBtn.addEventListener('click', async () => {
          const files = fileInput?.files;
          if (!files || files.length === 0) {
            setStatus('⚠ Please select an import_payload.json file first.', 'error');
            return;
          }

          const file = files[0];
          let payload: any;
          try {
            payload = JSON.parse(await file.text());
          } catch {
            setStatus('⚠ Invalid JSON file — could not parse it.', 'error');
            return;
          }

          if (payload?.version !== '1.0' && payload?.version !== '2.0') {
            setStatus('⚠ Unrecognised format. Generate a fresh import_payload.json with: node scripts/wp-import.mjs', 'error');
            return;
          }

          // Show loading state
          importBtn.disabled = true;
          importBtn.textContent = 'Importing…';
          setStatus(`⏳ Importing ${payload.stats?.articles ?? '?'} articles, ${payload.stats?.users ?? '?'} users…`, 'loading');
          if (progressBox) progressBox.classList.remove('hidden');

          try {
            const res = await fetch('/api/import-wp', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
            const result = await res.json() as any;

            if (result.success) {
              setStatus('✅ ' + result.message, 'success');
              const r = result.results || {};
              if (statsBox) {
                statsBox.innerHTML = `
                  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-4">
                    ${[
                      ['Users',       r.users ?? 0],
                      ['Categories',  r.categories ?? 0],
                      ['Tags',        r.tags ?? 0],
                      ['Articles',    r.articles ?? 0],
                      ['Pages',       r.pages ?? 0],
                      ['Cat. Links',  r.article_categories ?? 0],
                      ['Tag Links',   r.article_tags ?? 0],
                    ].map(([label, val]) => `
                      <div class="bg-background border border-border rounded-lg p-3 text-center">
                        <div class="text-2xl font-bold text-primary">${val}</div>
                        <div class="text-xs text-muted-foreground mt-1">${label}</div>
                      </div>`).join('')}
                  </div>`;
                statsBox.classList.remove('hidden');
              }
            } else {
              setStatus('⚠ ' + result.message, 'error');
              if (result.errors?.length && statsBox) {
                statsBox.innerHTML = `<pre class="text-xs text-destructive mt-3 p-3 bg-destructive/5 rounded-lg overflow-auto">${result.errors.join('\n')}</pre>`;
                statsBox.classList.remove('hidden');
              }
            }
          } catch (err: any) {
            setStatus('❌ Network error: ' + err.message, 'error');
          } finally {
            importBtn.disabled = false;
            importBtn.textContent = 'Start Import';
          }
        });
      }

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          if (fileInput) fileInput.value = '';
          if (statusBox) { statusBox.textContent = ''; statusBox.className = ''; }
          if (progressBox) progressBox.classList.add('hidden');
          if (statsBox) { statsBox.innerHTML = ''; statsBox.classList.add('hidden'); }
          if (importBtn) { importBtn.disabled = false; importBtn.textContent = 'Start Import'; }
        });
      }
    })();
    </script>
</AdminLayout>
