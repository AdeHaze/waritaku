---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { settings } from '../../../db/schema';
import { eq, inArray } from 'drizzle-orm';
import { env } from "cloudflare:workers";
import { getDb } from '../../../lib/db';

import NavigationSettings from '../../../components/admin/NavigationSettings';

const user = Astro.locals.user;
if (!user || user.role !== 'superadmin') {
    return Astro.redirect('/admin/login');
}

let db = null;
if (env && env.DB) {
    db = getDb(env);
}

let message = '';
let isError = false;

let navbarLinksData = [
    { label: 'All', url: '/all' },
    { label: 'Anime', url: '/anime' },
    { label: 'Manga', url: '/manga' },
    { label: 'Games', url: '/games' },
    { label: 'Novel', url: '/novel' },
    { label: 'Simak', url: '/simak' },
    { label: 'Event', url: '/event' },
    { label: 'Staff List', url: '/staff-list' },
    { label: 'Recruitment', url: '/recruitment' }
];

let footerLinksData = [
    { label: 'Latest', url: '/all' },
    { label: 'Tentang', url: '/tentang-planet-wibu' },
    { label: 'Kebijakan Privasi', url: '/kebijakan-privasi' },
    { label: 'Sitemap', url: '/sitemap-index.xml' },
    { label: 'Login', url: '/admin' }
];

if (Astro.request.method === 'POST') {
    try {
        const formData = await Astro.request.formData();
        const navbarLinksStr = formData.get('navbarLinks') as string;
        const footerLinksStr = formData.get('footerLinks') as string;
        
        if (db) {
            // Update or Insert navbar_links
            const existingNav = await db.select().from(settings).where(eq(settings.key, 'navbar_links'));
            if (existingNav.length > 0) {
                await db.update(settings).set({ value: navbarLinksStr }).where(eq(settings.key, 'navbar_links'));
            } else {
                await db.insert(settings).values({ key: 'navbar_links', value: navbarLinksStr });
            }

            // Update or Insert footer_links
            const existingFoot = await db.select().from(settings).where(eq(settings.key, 'footer_links'));
            if (existingFoot.length > 0) {
                await db.update(settings).set({ value: footerLinksStr }).where(eq(settings.key, 'footer_links'));
            } else {
                await db.insert(settings).values({ key: 'footer_links', value: footerLinksStr });
            }

            message = 'Navigation settings updated successfully.';
            
            // Update local state for immediate render
            navbarLinksData = JSON.parse(navbarLinksStr);
            footerLinksData = JSON.parse(footerLinksStr);
        }
    } catch (e) {
        message = 'An error occurred while saving navigation settings.';
        isError = true;
        console.error(e);
    }
} else if (db) {
    const records = await db.select().from(settings).where(inArray(settings.key, ['navbar_links', 'footer_links']));
    
    records.forEach(record => {
        try {
            if (record.key === 'navbar_links') navbarLinksData = JSON.parse(record.value);
            if (record.key === 'footer_links') footerLinksData = JSON.parse(record.value);
        } catch (e) {}
    });
}
---

<AdminLayout title="Navigation & Footer">
    <div class="max-w-4xl">
        <div class="mb-8 flex flex-col sm:flex-row sm:items-start justify-between gap-4">
            <div>
                <h2 class="text-3xl font-bold tracking-tight">Navigation & Footer</h2>
                <p class="text-muted-foreground mt-2">Manage the links and text that appear in your global header and footer.</p>
            </div>
            <div class="flex flex-col items-end gap-3 shrink-0">
                <a href="/admin/docs#docs-navigation" class="inline-flex items-center gap-1.5 text-sm font-bold text-primary bg-primary/10 hover:bg-primary/20 px-4 py-2 rounded-full transition-colors border border-primary/20 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                    Read Documentation
                </a>
                {message && (
                    <div class={`px-4 py-2 text-sm rounded-md font-medium ${isError ? 'bg-destructive/10 text-destructive border border-destructive/20' : 'bg-green-500/10 text-green-600 border border-green-500/20'}`}>
                        {message}
                    </div>
                )}
            </div>
        </div>

        <form method="POST" class="space-y-8">
            
            <NavigationSettings 
                client:load 
                initialNavbarLinks={navbarLinksData} 
                initialFooterLinks={footerLinksData} 
            />

            <div class="flex justify-end pt-4 pb-12">
                <button type="submit" class="px-6 py-2.5 bg-primary text-primary-foreground font-medium rounded-md hover:bg-primary/90 transition-colors">
                    Save Navigation Settings
                </button>
            </div>
        </form>
    </div>
</AdminLayout>
