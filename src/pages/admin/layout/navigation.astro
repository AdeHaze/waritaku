---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { settings } from '../../../db/schema';
import { eq, inArray } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { getDb } from '../../../lib/db';

import NavigationSettings from '../../../components/admin/NavigationSettings';
import { hasPermission } from '../../../lib/permissions';

const user = Astro.locals.user;
const permissions = Astro.locals.permissions;
if (!permissions || !hasPermission(permissions, 'layout', 'read')) {
    return Astro.redirect('/admin/login');
}

let db = null;
if (env && env.DB) {
    db = getDb(env);
}

let message = '';
let isError = false;

let navbarLinksData = [
    { label: 'All', url: '/all' },
    { label: 'Anime', url: '/anime' },
    { label: 'Manga', url: '/manga' },
    { label: 'Games', url: '/games' },
    { label: 'Novel', url: '/novel' },
    { label: 'Simak', url: '/simak' },
    { label: 'Event', url: '/event' },
    { label: 'Staff List', url: '/staff-list' },
    { label: 'Recruitment', url: '/recruitment' }
];

let footerLinksData = [
    { label: 'Latest', url: '/all' },
    { label: 'Tentang', url: '/tentang-planet-wibu' },
    { label: 'Kebijakan Privasi', url: '/kebijakan-privasi' },
    { label: 'Sitemap', url: '/sitemap-index.xml' },
    { label: 'Login', url: '/admin' }
];

let globalLayoutData = {
    headerStyle: 'default',
    footerStyle: 'default'
};

if (Astro.request.method === 'POST') {
    try {
        const formData = await Astro.request.formData();
        const navbarLinksStr = formData.get('navbarLinks') as string;
        const footerLinksStr = formData.get('footerLinks') as string;
        
        const newGlobalLayout = {
            headerStyle: formData.get('headerStyle') as string || 'default',
            footerStyle: formData.get('footerStyle') as string || 'default'
        };
        const globalLayoutStr = JSON.stringify(newGlobalLayout);
        
        if (db) {
            // Update or Insert navbar_links
            await db.insert(settings)
                .values({ key: 'navbar_links', value: navbarLinksStr })
                .onConflictDoUpdate({ target: settings.key, set: { value: navbarLinksStr } });

            // Update or Insert footer_links
            await db.insert(settings)
                .values({ key: 'footer_links', value: footerLinksStr })
                .onConflictDoUpdate({ target: settings.key, set: { value: footerLinksStr } });

            // Update or Insert global_navigation_layout
            await db.insert(settings)
                .values({ key: 'global_navigation_layout', value: globalLayoutStr })
                .onConflictDoUpdate({ target: settings.key, set: { value: globalLayoutStr } });

            message = 'Navigation settings updated successfully.';
            
            // Update local state for immediate render
            navbarLinksData = JSON.parse(navbarLinksStr);
            footerLinksData = JSON.parse(footerLinksStr);
            globalLayoutData = newGlobalLayout;
        }
    } catch (e) {
        message = 'An error occurred while saving navigation settings.';
        isError = true;
        console.error(e);
    }
} else if (db) {
    const records = await db.select().from(settings).where(inArray(settings.key, ['navbar_links', 'footer_links', 'global_navigation_layout']));
    
    records.forEach(record => {
        try {
            if (record.key === 'navbar_links') navbarLinksData = JSON.parse(record.value);
            if (record.key === 'footer_links') footerLinksData = JSON.parse(record.value);
            if (record.key === 'global_navigation_layout') globalLayoutData = JSON.parse(record.value);
        } catch (e) {}
    });
}
---

<AdminLayout title="Navigation & Footer">
    <div class="max-w-4xl">
        <div class="mb-8 flex flex-col sm:flex-row sm:items-start justify-between gap-4">
            <div>
                <h2 class="text-3xl font-bold tracking-tight">Navigation & Footer</h2>
                <p class="text-muted-foreground mt-2">Manage the links and text that appear in your global header and footer.</p>
            </div>
            <div class="flex flex-col items-end gap-3 shrink-0">
                <a href="/admin/docs#docs-navigation" class="inline-flex items-center gap-1.5 text-sm font-bold text-primary bg-primary/10 hover:bg-primary/20 px-4 py-2 rounded-full transition-colors border border-primary/20 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                    Read Documentation
                </a>
                {message && (
                    <div class={`px-4 py-2 text-sm rounded-md font-medium ${isError ? 'bg-destructive/10 text-destructive border border-destructive/20' : 'bg-green-500/10 text-green-600 border border-green-500/20'}`}>
                        {message}
                    </div>
                )}
            </div>
        </div>

        <form method="POST" class="space-y-8">
            
            <!-- Global Layout Settings -->
            <div class="bg-card border border-border rounded-xl p-6 shadow-sm">
                <div class="flex items-center gap-3 mb-6 border-b border-border pb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M3 9h18"></path><path d="M9 21V9"></path></svg>
                    <h3 class="text-lg font-bold">Global Layout Style</h3>
                </div>
                
                <div class="grid md:grid-cols-2 gap-6">
                    <div>
                        <label for="headerStyle" class="block font-semibold text-sm mb-2">Header Style</label>
                        <select name="headerStyle" id="headerStyle" class="flex h-10 w-full items-center justify-between rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50">
                            <option value="default" selected={globalLayoutData.headerStyle === 'default'}>Default (Logo Left, Links Right)</option>
                            <option value="centered" selected={globalLayoutData.headerStyle === 'centered'}>Centered (Logo Center)</option>
                        </select>
                        <p class="text-xs text-muted-foreground mt-2">Sets the default navigation bar style across the entire site.</p>
                    </div>
                    
                    <div>
                        <label for="footerStyle" class="block font-semibold text-sm mb-2">Footer Style</label>
                        <select name="footerStyle" id="footerStyle" class="flex h-10 w-full items-center justify-between rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50">
                            <option value="default" selected={globalLayoutData.footerStyle === 'default'}>Default (Full Width, Links & Tagline)</option>
                            <option value="minimal" selected={globalLayoutData.footerStyle === 'minimal'}>Minimal (Copyright Only)</option>
                        </select>
                        <p class="text-xs text-muted-foreground mt-2">Sets the default footer style across the entire site.</p>
                    </div>
                </div>
            </div>

            <!-- Links Settings -->
            
            <NavigationSettings 
                client:load 
                initialNavbarLinks={navbarLinksData} 
                initialFooterLinks={footerLinksData} 
            />

            <div class="flex justify-end pt-4 pb-12">
                <button type="submit" class="px-6 py-2.5 bg-primary text-primary-foreground font-medium rounded-md hover:bg-primary/90 transition-colors">
                    Save Navigation Settings
                </button>
            </div>
        </form>
    </div>
</AdminLayout>
