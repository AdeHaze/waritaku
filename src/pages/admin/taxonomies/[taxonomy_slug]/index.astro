---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getDb } from '../../../../lib/db';
import { generateUniqueSlug } from '../../../../lib/slug';
import { taxonomies, terms } from '../../../../db/schema';
import { eq, desc, asc, like, and, or, sql } from 'drizzle-orm';
import { env } from 'cloudflare:workers';

import { hasPermission } from '../../../../lib/permissions';

const user = Astro.locals.user;
const permissions = Astro.locals.permissions;
if (!user || !permissions || !hasPermission(permissions, 'taxonomies', 'read')) {
    return Astro.redirect('/admin/login');
}

const { taxonomy_slug } = Astro.params;
const db = getDb(env);

const taxRes = await db.select().from(taxonomies).where(eq(taxonomies.slug, taxonomy_slug as string)).limit(1);
if (taxRes.length === 0) {
    return Astro.redirect('/404');
}
const taxonomy = taxRes[0];

const canCreate = hasPermission(permissions, 'taxonomies', 'create');
const canEdit = hasPermission(permissions, 'taxonomies', 'edit_others') || hasPermission(permissions, 'taxonomies', 'edit_own');
const canDelete = hasPermission(permissions, 'taxonomies', 'delete_others') || hasPermission(permissions, 'taxonomies', 'delete_own');

const url = new URL(Astro.request.url);
let message = url.searchParams.get('message') || '';
let messageType = url.searchParams.get('type') || ''; // 'success' or 'error'
let isError = messageType === 'error';

// Query params for search / pagination / sort
const page = Math.max(1, parseInt(url.searchParams.get('page') || '1'));
const limit = 50;
const search = url.searchParams.get('search') || '';
const sort = url.searchParams.get('sort') || 'id_desc';

if (Astro.request.method === 'POST') {
    let formData: FormData | null = null;
    try {
        formData = await Astro.request.formData();
        const action = formData.get('action');

        if (action === 'create') {
            if (!canCreate) throw new Error("Forbidden: You do not have permission to create terms.");
            const name = formData?.get('name') as string;
            const slug = formData?.get('slug') as string;

            if (!name) {
                message = 'Name is required.';
                isError = true;
            } else {
                let initialSlug = slug || name;
                const finalSlug = await generateUniqueSlug(db, initialSlug, 'term', undefined, Boolean(taxonomy.omitTaxonomySlug));

                await db.insert(terms).values({
                    taxonomyId: taxonomy.id,
                    authorId: user.userId,
                    name,
                    slug: finalSlug
                });
                const u = new URL(Astro.request.url);
                u.searchParams.set('message', 'Term created successfully.');
                u.searchParams.set('type', 'success');
                return Astro.redirect(u.pathname + u.search, 303);
            }
        } else if (action === 'delete') {
            const termId = parseInt(formData?.get('termId') as string, 10);
            const termRes = await db.select().from(terms).where(eq(terms.id, termId)).limit(1);
            if (termRes.length > 0) {
                const termAuthor = termRes[0].authorId;
                const isOwner = termAuthor === user.userId;
                const canDelete = isOwner ? hasPermission(permissions, 'taxonomies', 'delete_own') : hasPermission(permissions, 'taxonomies', 'delete_others');
                if (!canDelete) throw new Error("Forbidden: You do not have permission to delete this term.");
                await db.delete(terms).where(eq(terms.id, termId));
            }
            const u = new URL(Astro.request.url);
            u.searchParams.set('message', 'Term deleted successfully.');
            u.searchParams.set('type', 'success');
            return Astro.redirect(u.pathname + u.search, 303);
        } else if (action === 'update') {
            const termId = parseInt(formData?.get('termId') as string, 10);
            const termRes = await db.select().from(terms).where(eq(terms.id, termId)).limit(1);
            if (termRes.length > 0) {
                const termAuthor = termRes[0].authorId;
                const isOwner = termAuthor === user.userId;
                const canEdit = isOwner ? hasPermission(permissions, 'taxonomies', 'edit_own') : hasPermission(permissions, 'taxonomies', 'edit_others');
                if (!canEdit) throw new Error("Forbidden: You do not have permission to edit this term.");
            }
            const newName = (formData?.get('name') as string)?.trim();
            const newSlug = (formData?.get('slug') as string)?.trim();
            if (!newName) {
                message = 'Name is required.';
                isError = true;
            } else {
                const updateData: any = { name: newName };
                if (newSlug) {
                    updateData.slug = await generateUniqueSlug(db, newSlug, 'term', termId, Boolean(taxonomy.omitTaxonomySlug));
                }
                await db.update(terms).set(updateData).where(eq(terms.id, termId));
                const u = new URL(Astro.request.url);
                u.searchParams.set('message', 'Term updated successfully.');
                u.searchParams.set('type', 'success');
                return Astro.redirect(u.pathname + u.search, 303);
            }
        }
    } catch (e: any) {
        if (e.message?.includes('UNIQUE constraint failed') || e.message?.includes('terms_taxonomy_slug_unique') || e.message?.includes('terms_slug_unique') || e.message?.includes('Failed query: insert into "terms"')) {
            const action = formData?.get('action');
            let failedSlug = (formData?.get('slug') as string)?.trim();
            if (!failedSlug && action === 'create') {
                failedSlug = (formData?.get('name') as string)?.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
            }
            
            let detailedMsg = `The slug "${failedSlug || ''}" already exists.`;
            try {
                const existing = await db.select({
                    termName: terms.name,
                    taxLabel: taxonomies.label,
                    taxSlug: taxonomies.slug
                })
                .from(terms)
                .innerJoin(taxonomies, eq(terms.taxonomyId, taxonomies.id))
                .where(eq(terms.slug, failedSlug || ''))
                .limit(1);

                if (existing.length > 0) {
                    const match = existing[0];
                    if (match.taxSlug === taxonomy.slug) {
                        detailedMsg = `The slug "${failedSlug}" already exists in this taxonomy (${taxonomy.label}) under term "${match.termName}".`;
                    } else {
                        detailedMsg = `The slug "${failedSlug}" is already in use in the "${match.taxLabel}" taxonomy (Term: "${match.termName}").`;
                    }
                }
            } catch (err) {}

            message = detailedMsg;
        } else {
            message = 'An unexpected error occurred. Please try again.';
            console.error('Term mutation error:', e);
        }
        isError = true;
    }
}

// Build query with search/sort/pagination
let termConditions: any = eq(terms.taxonomyId, taxonomy.id);
if (search) {
    const searchPattern = `%${search}%`;
    termConditions = and(termConditions, or(like(terms.name, searchPattern), like(terms.slug, searchPattern)));
}

// Count total
const countRes = await db.select({ count: sql<number>`count(*)` })
    .from(terms)
    .where(termConditions);
const totalTerms = countRes[0]?.count || 0;
const totalPages = Math.ceil(totalTerms / limit);

// Sort
let orderFn = desc(terms.id);
if (sort === 'name_asc') orderFn = asc(terms.name);
else if (sort === 'name_desc') orderFn = desc(terms.name);
else if (sort === 'slug_asc') orderFn = asc(terms.slug);

const allTerms = await db.select()
    .from(terms)
    .where(termConditions)
    .orderBy(orderFn)
    .limit(limit)
    .offset((page - 1) * limit);

// Build pagination links helper
function pageUrl(p: number) {
    const u = new URL(Astro.request.url);
    u.searchParams.set('page', String(p));
    return u.pathname + u.search;
}

function sortUrl(s: string) {
    const u = new URL(Astro.request.url);
    u.searchParams.set('sort', s);
    u.searchParams.delete('page');
    return u.pathname + u.search;
}

// Build pagination array
const paginationPages = Array.from({ length: Math.min(7, totalPages) }, (_, i) => {
    let p: number;
    if (totalPages <= 7) {
        p = i + 1;
    } else if (page <= 4) {
        p = i + 1;
    } else if (page >= totalPages - 3) {
        p = totalPages - 6 + i;
    } else {
        p = page - 3 + i;
    }
    return p;
});
---

<AdminLayout title={`${taxonomy.label} - Management`}>
    <div class="mb-8">
        <h1 class="text-3xl font-bold tracking-tight">{taxonomy.label}</h1>
        <p class="text-muted-foreground mt-1">Manage terms in the {taxonomy.label} taxonomy.</p>
    </div>

    {message && (
        <div class={`p-4 mb-6 rounded-lg font-medium text-sm ${isError ? 'bg-red-500/10 text-red-500' : 'bg-emerald-500/10 text-emerald-600'}`}>
            {message}
        </div>
    )}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Create Form -->
        <div class="lg:col-span-1">
            <div class="bg-card border border-border rounded-xl shadow-sm overflow-hidden">
                <div class="p-4 border-b border-border bg-muted/20">
                    <h2 class="font-semibold">Add New Term</h2>
                </div>
                {canCreate ? (
                    <form method="POST" class="p-6 space-y-4">
                        <input type="hidden" name="action" value="create" />
                        
                        <div>
                            <label class="block text-xs font-semibold text-muted-foreground mb-1">Name <span class="text-red-500">*</span></label>
                            <input type="text" name="name" required class="w-full px-3 py-2 text-sm bg-background border border-input rounded focus:outline-none focus:ring-1 focus:ring-primary" />
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-muted-foreground mb-1">Slug</label>
                            <input type="text" name="slug" placeholder="Auto-generated if empty" class="w-full px-3 py-2 text-sm bg-background border border-input rounded focus:outline-none focus:ring-1 focus:ring-primary" />
                        </div>

                        <button type="submit" class="w-full py-2 bg-primary text-primary-foreground font-bold rounded hover:bg-primary/90 transition-colors">
                            Add Term
                        </button>
                    </form>
                ) : (
                    <div class="p-6 text-sm text-muted-foreground bg-muted/5">
                        You do not have permission to create terms.
                    </div>
                )}
            </div>
        </div>

        <!-- Terms List -->
        <div class="lg:col-span-2">
            <div class="bg-card border border-border rounded-xl shadow-sm overflow-hidden">
                <!-- Toolbar: search, stats, sort -->
                <div class="p-4 border-b border-border bg-muted/20 space-y-3">
                    <form method="GET" class="flex gap-2">
                        <input 
                            type="search" 
                            name="search" 
                            value={search} 
                            placeholder="Search terms..."
                            class="flex-1 px-3 py-2 text-sm bg-background border border-input rounded-lg focus:outline-none focus:ring-1 focus:ring-primary"
                        />
                        <button type="submit" class="px-4 py-2 bg-primary text-primary-foreground text-sm font-semibold rounded-lg hover:bg-primary/90 transition-colors">
                            Search
                        </button>
                        {search && (
                            <a href={Astro.url.pathname} class="px-3 py-2 text-sm text-muted-foreground hover:text-foreground border border-input rounded-lg transition-colors">
                                Clear
                            </a>
                        )}
                    </form>
                    <div class="flex items-center justify-between text-xs text-muted-foreground">
                        <span>
                            {totalTerms} term{totalTerms !== 1 ? 's' : ''}
                            {search && <span> matching "<strong class="text-foreground">{search}</strong>"</span>}
                            {totalPages > 1 && <span> — page {page} of {totalPages}</span>}
                        </span>
                        <div class="flex items-center gap-1">
                            <span class="mr-1">Sort:</span>
                            {[
                                { key: 'id_desc', label: 'Newest' },
                                { key: 'name_asc', label: 'Name ↑' },
                                { key: 'name_desc', label: 'Name ↓' },
                                { key: 'slug_asc', label: 'Slug' },
                            ].map(opt => (
                                <a href={sortUrl(opt.key)} class={`px-2 py-1 rounded-md transition-colors ${sort === opt.key ? 'bg-primary text-primary-foreground font-semibold' : 'hover:bg-muted'}`}>
                                    {opt.label}
                                </a>
                            ))}
                        </div>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left">
                        <thead class="text-xs text-muted-foreground uppercase bg-muted/30 border-b border-border">
                            <tr>
                                <th class="px-6 py-4 font-semibold w-12">#</th>
                                <th class="px-6 py-4 font-semibold">Name</th>
                                <th class="px-6 py-4 text-right font-semibold w-24">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border">
                            {allTerms.length === 0 ? (
                                <tr>
                                    <td colspan="3" class="px-6 py-12 text-center text-muted-foreground">
                                        {search ? 'No terms match your search.' : 'No terms yet. Add your first one.'}
                                    </td>
                                </tr>
                            ) : (
                                allTerms.map((term, i) => {
                                    const isOwner = term.authorId === user.userId;
                                    const canEditTerm = isOwner ? hasPermission(permissions, 'taxonomies', 'edit_own') : hasPermission(permissions, 'taxonomies', 'edit_others');
                                    const canDeleteTerm = isOwner ? hasPermission(permissions, 'taxonomies', 'delete_own') : hasPermission(permissions, 'taxonomies', 'delete_others');

                                    return (
                                    <>
                                    <tr class="hover:bg-muted/10 transition-colors group">
                                        <td class="px-6 py-4 text-muted-foreground text-xs font-mono">
                                            {(page - 1) * limit + i + 1}
                                        </td>
                                        <td class="px-6 py-4 font-medium text-foreground term-view">
                                            <div class="flex flex-col">
                                                <span>{term.name}</span>
                                                <span class="text-xs text-muted-foreground font-mono mt-0.5">/{term.slug}</span>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4 text-right">
                                            <div class="flex items-center justify-end gap-1">
                                                {canEditTerm && (
                                                    <button type="button" onclick="this.closest('tr').classList.add('hidden'); this.closest('tr').nextElementSibling.classList.remove('hidden');" class="p-2 text-muted-foreground hover:text-primary hover:bg-primary/10 rounded-md transition-colors" title="Edit">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
                                                    </button>
                                                )}
                                                {canDeleteTerm && (
                                                    <form method="POST" class="inline-block" onsubmit={`return confirm('Delete "${term.name}"?');`}>
                                                        <input type="hidden" name="action" value="delete" />
                                                        <input type="hidden" name="termId" value={term.id} />
                                                        <button type="submit" class="p-2 text-muted-foreground hover:text-red-500 hover:bg-red-500/10 rounded-md transition-colors" title="Delete">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
                                                        </button>
                                                    </form>
                                                )}
                                            </div>
                                        </td>
                                    </tr>
                                    <!-- Inline edit row -->
                                    <tr class="term-edit hidden bg-muted/5 border-b border-border">
                                        <td colspan="3" class="px-6 py-4">
                                            <form method="POST" class="flex items-end gap-3 flex-wrap">
                                                <input type="hidden" name="action" value="update" />
                                                <input type="hidden" name="termId" value={term.id} />
                                                <div class="flex-1 min-w-[140px]">
                                                    <label class="block text-[10px] font-bold uppercase text-muted-foreground mb-1">Name</label>
                                                    <input type="text" name="name" value={term.name} required class="w-full px-3 py-2 text-sm bg-background border border-input rounded-lg focus:outline-none focus:ring-1 focus:ring-primary" />
                                                </div>
                                                <div class="w-40">
                                                    <label class="block text-[10px] font-bold uppercase text-muted-foreground mb-1">Slug</label>
                                                    <input type="text" name="slug" value={term.slug} class="w-full px-3 py-2 text-sm bg-background border border-input rounded-lg focus:outline-none focus:ring-1 focus:ring-primary font-mono text-xs" />
                                                </div>
                                                <button type="submit" class="px-4 py-2 bg-primary text-primary-foreground text-sm font-semibold rounded-lg hover:bg-primary/90 transition-colors">
                                                    Save
                                                </button>
                                                <button type="button" onclick="this.closest('tr').classList.add('hidden'); this.closest('tr').previousElementSibling.classList.remove('hidden');" class="px-3 py-2 text-sm text-muted-foreground hover:text-foreground border border-input rounded-lg transition-colors">
                                                    Cancel
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                    </>
                                    );
                                })
                            )}
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                {totalPages > 1 && (
                    <div class="flex items-center justify-between px-6 py-4 border-t border-border bg-muted/10">
                        <span class="text-xs text-muted-foreground">
                            Showing {(page - 1) * limit + 1}–{Math.min(page * limit, totalTerms)} of {totalTerms}
                        </span>
                        <div class="flex items-center gap-1">
                            {page > 1 && (
                                <a href={pageUrl(page - 1)} class="px-3 py-1.5 text-sm border border-input rounded-lg hover:bg-muted transition-colors">
                                    ← Prev
                                </a>
                            )}
                            {paginationPages.map(p => (
                                <a href={pageUrl(p)} class={`px-3 py-1.5 text-sm rounded-lg transition-colors ${p === page ? 'bg-primary text-primary-foreground font-semibold' : 'border border-input hover:bg-muted'}`}>
                                    {p}
                                </a>
                            ))}
                            {page < totalPages && (
                                <a href={pageUrl(page + 1)} class="px-3 py-1.5 text-sm border border-input rounded-lg hover:bg-muted transition-colors">
                                    Next →
                                </a>
                            )}
                        </div>
                    </div>
                )}
            </div>
        </div>
    </div>
</AdminLayout>
