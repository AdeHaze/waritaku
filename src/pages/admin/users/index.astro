---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../../../components/ui/card';
import { users, passwordResets } from '../../../db/schema';
import { eq } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { getDb } from '../../../lib/db';

import { hashPassword } from '../../../lib/auth';
import { hasPermission, hasAnyPermission } from '../../../lib/permissions';

const sessionUser = Astro.locals.user;
const permissions = Astro.locals.permissions;
if (!sessionUser || !permissions || !hasPermission(permissions, 'users', 'read')) {
    return Astro.redirect('/admin');
}

let items: any[] = [];
let error = '';
let success = '';

if (env && env.DB) {
  const db = getDb(env);
  
  // Handle POST (Create / Edit / Delete)
  if (Astro.request.method === 'POST') {
      try {
          const data = await Astro.request.formData();
          const action = data.get('action') as string;
          
          if (action === 'create') {
              const name = data.get('name') as string;
              const email = data.get('email') as string;
              const role = data.get('role') as string;
              const password = data.get('password') as string;
              
              if (name && email && role && password) {
                  const passwordHash = await hashPassword(password);
                  await db.insert(users).values({ name, email, role, passwordHash });
                  success = 'User created successfully!';
              }
          } else if (action === 'delete') {
              const id = parseInt(data.get('id') as string, 10);
              if (id && id !== sessionUser.userId) { // prevent self-deletion
                  await db.delete(users).where(eq(users.id, id));
                  success = 'User deleted successfully!';
              } else {
                  error = 'Cannot delete your own account.';
              }
          } else if (action === 'update_role') {
              const id = parseInt(data.get('id') as string, 10);
              const role = data.get('role') as string;
              if (id && id !== sessionUser.userId) {
                  await db.update(users).set({ role }).where(eq(users.id, id));
                  success = 'Role updated successfully!';
              }
          } else if (action === 'generate_reset_link') {
              const id = parseInt(data.get('id') as string, 10);
              if (id) {
                  const token = [...crypto.getRandomValues(new Uint8Array(32))].map(b => b.toString(16).padStart(2, '0')).join('');
                  const expiresAt = new Date(Date.now() + 60 * 60 * 1000);
                  
                  await db.insert(passwordResets).values({
                      userId: id,
                      token: token,
                      expiresAt: expiresAt
                  });
                  
                  const resetLink = `${Astro.url.origin}/admin/reset-password?token=${token}`;
                  success = `Reset Link generated successfully. Copy this and send it to the user: ${resetLink}`;
              }
          }
      } catch (e: any) {
          error = e.message;
      }
  }

  try {
      items = await db.select().from(users).orderBy(users.id);
  } catch(e: any) {
      error = e.message;
  }
}

// Fetch dynamic roles
let allRoles: any[] = [];
if (env && env.DB) {
    const db = getDb(env);
    try {
        const { roles } = await import('../../../db/schema');
        allRoles = await db.select().from(roles);
    } catch(e) {}
}

const canCreate = hasPermission(permissions, 'users', 'create');
const canEditOthers = hasPermission(permissions, 'users', 'edit_others');
const canDeleteOthers = hasPermission(permissions, 'users', 'delete_others');
---

<AdminLayout title="Users & Roles">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-foreground">Users & Roles</h1>
      <p class="text-muted-foreground mt-2">Manage authors, editors, and admins on your site.</p>
    </div>
    <div class="flex items-center gap-3">
        {hasPermission(permissions, 'system', 'read') && (
            <a href="/admin/users/roles" class="inline-flex items-center gap-1.5 text-sm font-bold text-foreground bg-muted hover:bg-muted/80 px-4 py-2 rounded-full transition-colors border border-border shadow-sm shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
                Manage Roles
            </a>
        )}
        <a href="/admin/docs#docs-users" class="inline-flex items-center gap-1.5 text-sm font-bold text-primary bg-primary/10 hover:bg-primary/20 px-4 py-2 rounded-full transition-colors border border-primary/20 shadow-sm shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            Read Documentation
        </a>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      {/* Create Form */}
      <div class="lg:col-span-1">
          <Card className="bg-card border-border shadow-sm sticky top-6">
            <CardHeader>
              <CardTitle>Add New User</CardTitle>
            </CardHeader>
            <CardContent>
              {error && <div class="mb-4 text-sm text-destructive font-medium">{error}</div>}
              {success && <div class="mb-4 text-sm text-green-600 dark:text-green-400 font-medium">{success}</div>}
              
              {canCreate ? (
                  <form method="POST" class="grid gap-4 py-4">
                      <input type="hidden" name="action" value="create" />
                      <div class="grid grid-cols-4 items-center gap-4">
                          <label for="name" class="text-right font-medium text-sm">Name</label>
                          <input id="name" name="name" class="col-span-3 h-10 rounded-md border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" required />
                      </div>
                      <div class="grid grid-cols-4 items-center gap-4">
                          <label for="email" class="text-right font-medium text-sm">Email</label>
                          <input id="email" name="email" type="email" class="col-span-3 h-10 rounded-md border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" required />
                      </div>
                      <div class="grid grid-cols-4 items-center gap-4">
                          <label for="password" class="text-right font-medium text-sm">Password</label>
                          <input id="password" name="password" type="password" class="col-span-3 h-10 rounded-md border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" required />
                      </div>
                      <div class="grid grid-cols-4 items-center gap-4">
                          <label for="role" class="text-right font-medium text-sm">Role</label>
                          <select id="role" name="role" class="col-span-3 h-10 rounded-md border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
                              {allRoles.map(r => (
                                  <option value={r.slug}>{r.label}</option>
                              ))}
                          </select>
                      </div>
                      <div class="flex justify-end gap-3 mt-4">
                          <button type="submit" class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90">
                              Create User
                          </button>
                      </div>
                  </form>
              ) : (
                  <div class="p-4 bg-muted text-muted-foreground text-sm rounded">You do not have permission to create users.</div>
              )}
            </CardContent>
          </Card>
      </div>

      {/* List */}
      <div class="lg:col-span-2">
          <Card className="bg-card border-border shadow-sm">
            <CardContent className="p-0">
              <div class="overflow-x-auto h-[700px] overflow-y-auto relative">
                <table class="w-full text-sm text-left whitespace-nowrap">
                  <thead class="text-xs uppercase bg-muted text-muted-foreground border-b border-border sticky top-0 z-10">
                    <tr>
                      <th class="px-6 py-4 font-semibold">Name / Email</th>
                      <th class="px-6 py-4 font-semibold">Role</th>
                      <th class="px-6 py-4 font-semibold text-right">Actions</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-border">
                    {items.map(item => (
                      <tr class="hover:bg-muted/30 transition-colors group">
                        <td class="px-6 py-4">
                            <div class="font-bold text-foreground">{item.name}</div>
                            <div class="text-xs text-muted-foreground">{item.email}</div>
                        </td>
                        <td class="px-6 py-4">
                            {item.id === sessionUser.userId || !canEditOthers ? (
                                <span class="px-2 py-1 bg-primary/20 text-primary rounded text-xs font-bold uppercase">{item.role}</span>
                            ) : (
                                <form method="POST" class="flex gap-2 items-center">
                                    <input type="hidden" name="action" value="update_role" />
                                    <input type="hidden" name="id" value={item.id} />
                                    <select name="role" class="h-8 rounded border border-input bg-background px-2 text-xs focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" onchange="this.form.submit()">
                                        {allRoles.map(r => (
                                            <option value={r.slug} selected={item.role === r.slug}>{r.label}</option>
                                        ))}
                                    </select>
                                </form>
                            )}
                        </td>
                        <td class="px-6 py-4 text-right flex justify-end gap-3">
                            <a href={`/admin/profile?id=${item.id}`} class="text-primary hover:underline text-xs font-semibold">Edit Profile</a>
                            {item.id !== sessionUser.userId && canEditOthers && (
                                <>
                                    <form method="POST" class="inline">
                                        <input type="hidden" name="action" value="generate_reset_link" />
                                        <input type="hidden" name="id" value={item.id} />
                                        <button type="submit" class="text-orange-500 hover:underline text-xs font-semibold" title="Generate a one-time password reset link for this user">Reset Link</button>
                                    </form>
                                </>
                            )}
                            {item.id !== sessionUser.userId && canDeleteOthers && (
                                <form method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                        <input type="hidden" name="action" value="delete" />
                                        <input type="hidden" name="id" value={item.id} />
                                        <button type="submit" class="text-destructive hover:underline text-xs font-semibold">Delete</button>
                                    </form>
                            )}
                        </td>
                      </tr>
                    ))}
                    {items.length === 0 && (
                        <tr><td colspan="3" class="px-6 py-12 text-center text-muted-foreground">No users found.</td></tr>
                    )}
                  </tbody>
                </table>
              </div>
            </CardContent>
          </Card>
      </div>
  </div>
</AdminLayout>
