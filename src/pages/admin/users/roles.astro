---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Card, CardContent, CardHeader } from '../../../components/ui/card';
import { roles, rolePermissions } from '../../../db/schema';
import { eq } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { getDb } from '../../../lib/db';
import { hasPermission } from '../../../lib/permissions';

const sessionUser = Astro.locals.user;
const permissions = Astro.locals.permissions;
if (!sessionUser || !permissions || !hasPermission(permissions, 'roles', 'read')) {
    return Astro.redirect('/admin');
}

let items: any[] = [];
let error = '';
let success = '';

const resourcesList = [
    'entries', 'media', 'taxonomies', 'taxonomy_terms', 'users', 'roles',
    'content_builder', 'taxonomy_builder', 'settings', 'layout', 'redirects', 'system'
];

if (env && env.DB) {
    const db = getDb(env);

    if (Astro.request.method === 'POST') {
        try {
            const data = await Astro.request.formData();
            const action = data.get('action') as string;

            if (action === 'create') {
                if (!hasPermission(permissions, 'roles', 'create')) {
                    error = 'Forbidden';
                } else {
                    const label = data.get('label') as string;
                    const slug = data.get('slug') as string;
                    const desc = data.get('description') as string;
                    if (label && slug) {
                        await db.insert(roles).values({
                            label, slug, description: desc, isSystem: false
                        });
                        success = 'Role created successfully.';
                    }
                }
            } else if (action === 'delete') {
                if (!hasPermission(permissions, 'roles', 'delete_others')) {
                    error = 'Forbidden';
                } else {
                    const id = parseInt(data.get('id') as string, 10);
                    const roleRec = await db.select().from(roles).where(eq(roles.id, id)).limit(1);
                    if (roleRec.length > 0 && !roleRec[0].isSystem) {
                        await db.delete(rolePermissions).where(eq(rolePermissions.roleId, id));
                        await db.delete(roles).where(eq(roles.id, id));
                        success = 'Role deleted successfully.';
                    } else {
                        error = 'Cannot delete system roles.';
                    }
                }
            } else if (action === 'update_perms') {
                if (!hasPermission(permissions, 'roles', 'edit_others')) {
                    error = 'Forbidden';
                } else {
                    const roleId = parseInt(data.get('role_id') as string, 10);
                    const roleRec = await db.select().from(roles).where(eq(roles.id, roleId)).limit(1);
                    if (roleRec.length > 0 && roleRec[0].slug !== 'superadmin') {
                        await db.delete(rolePermissions).where(eq(rolePermissions.roleId, roleId));
                    
                    const inserts = [];
                    for (const [key, val] of data.entries()) {
                        if (key.startsWith('perm_') && val === 'on') {
                            const permString = key.substring(5); // e.g. "entries:read"
                            const [res, act] = permString.split(':');
                            if (res && act) {
                                inserts.push({
                                    roleId: roleId,
                                    resource: res,
                                    action: act
                                });
                            }
                        }
                    }
                    
                    if (inserts.length > 0) {
                        await db.insert(rolePermissions).values(inserts);
                    }
                    success = 'Permissions updated.';
                }
                }
            }
        } catch (e: any) {
            error = e.message;
        }
    }

    try {
        const rolesData = await db.select().from(roles).orderBy(roles.id);
        const permsData = await db.select().from(rolePermissions);
        
        items = rolesData.map(r => {
            return {
                ...r,
                permissions: permsData.filter(p => p.roleId === r.id).map(p => `${p.resource}:${p.action}`)
            };
        });
    } catch (e: any) {
        error = e.message;
    }
}



---
<AdminLayout title="Role Management">
    <div class="px-6 py-6 max-w-7xl mx-auto space-y-6">
        <div>
            <h1 class="text-3xl font-bold tracking-tight text-foreground">Role Management</h1>
            <p class="text-muted-foreground mt-1 text-sm">Define custom roles and configure granular permissions.</p>
        </div>

        {error && <div class="p-4 bg-destructive/10 text-destructive text-sm rounded font-medium">{error}</div>}
        {success && <div class="p-4 bg-green-500/10 text-green-600 dark:text-green-400 text-sm rounded font-medium">{success}</div>}

        <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
            {hasPermission(permissions, 'roles', 'create') && (
            <div class="lg:col-span-1">
                <Card className="bg-card border-border shadow-sm sticky top-6">
                    <CardHeader>
                        <h2 class="text-lg font-semibold">Create Role</h2>
                    </CardHeader>
                    <CardContent>
                        <form method="POST" class="space-y-4">
                            <input type="hidden" name="action" value="create" />
                            <div class="space-y-2">
                                <label class="text-sm font-semibold">Label</label>
                                <input type="text" name="label" required class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" />
                            </div>
                            <div class="space-y-2">
                                <label class="text-sm font-semibold">Slug (a-z, no spaces)</label>
                                <input type="text" name="slug" required pattern="[a-z0-9_]+" class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" />
                            </div>
                            <div class="space-y-2">
                                <label class="text-sm font-semibold">Description</label>
                                <textarea name="description" class="flex w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"></textarea>
                            </div>
                            <button type="submit" class="w-full mt-4 inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2 text-sm font-medium">Create Role</button>
                        </form>
                    </CardContent>
                </Card>
            </div>
            )}
            
            <div class={hasPermission(permissions, 'roles', 'create') ? "lg:col-span-3 space-y-6" : "lg:col-span-4 space-y-6"}>
                {items.map(role => (
                    <Card className="bg-card border-border shadow-sm">
                        <CardHeader className="flex flex-row items-center justify-between">
                            <div>
                                <h2 class="text-lg font-semibold flex items-center gap-2">
                                    {role.label} <span class="text-xs bg-muted text-muted-foreground px-2 py-0.5 rounded-full">{role.slug}</span>
                                    {role.isSystem && <span class="text-xs bg-primary/20 text-primary px-2 py-0.5 rounded-full uppercase font-bold">System</span>}
                                </h2>
                                <p class="text-sm text-muted-foreground mt-1">{role.description}</p>
                            </div>
                            {!role.isSystem && hasPermission(permissions, 'roles', 'delete_others') && (
                                <form method="POST" onsubmit="return confirm('Delete this custom role?');">
                                    <input type="hidden" name="action" value="delete" />
                                    <input type="hidden" name="id" value={role.id} />
                                    <button class="text-destructive hover:underline text-sm font-semibold">Delete</button>
                                </form>
                            )}
                        </CardHeader>
                        <CardContent>
                            {role.slug === 'superadmin' ? (
                                <div class="text-sm text-muted-foreground italic">Superadmin has implicit access to all permissions.</div>
                            ) : (
                                <form method="POST">
                                    <input type="hidden" name="action" value="update_perms" />
                                    <input type="hidden" name="role_id" value={role.id} />
                                    <div class="overflow-x-auto">
                                        <table class="w-full text-sm text-left">
                                            <thead class="bg-muted/50 text-muted-foreground text-xs uppercase font-semibold">
                                                <tr>
                                                    <th class="px-4 py-2 rounded-tl-md">Resource</th>
                                                    <th class="px-4 py-2 text-center">Read</th>
                                                    <th class="px-4 py-2 text-center">Create</th>
                                                    <th class="px-4 py-2 text-center">Edit Own</th>
                                                    <th class="px-4 py-2 text-center">Edit Others</th>
                                                    <th class="px-4 py-2 text-center">Delete Own</th>
                                                    <th class="px-4 py-2 text-center">Delete Others</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-border">
                                                {resourcesList.map(res => (
                                                    <tr class="hover:bg-muted/30">
                                                        <td class="px-4 py-2 font-medium">{res}</td>
                                                        {['read', 'create', 'edit_own', 'edit_others', 'delete_own', 'delete_others'].map(act => (
                                                            <td class="px-4 py-2 text-center">
                                                                <input type="checkbox" name={`perm_${res}:${act}`} checked={role.permissions.includes(`${res}:${act}`)} disabled={!hasPermission(permissions, 'roles', 'edit_others')} class="size-4 rounded border-input" />
                                                            </td>
                                                        ))}
                                                    </tr>
                                                ))}
                                            </tbody>
                                        </table>
                                    </div>
                                    {hasPermission(permissions, 'roles', 'edit_others') && (
                                        <div class="mt-4 flex justify-end">
                                            <button type="submit" class="inline-flex items-center justify-center rounded-md bg-secondary text-secondary-foreground hover:bg-secondary/80 h-9 px-4 text-xs font-semibold">Save Permissions</button>
                                        </div>
                                    )}
                                </form>
                            )}
                        </CardContent>
                    </Card>
                ))}
            </div>
        </div>
    </div>
</AdminLayout>
