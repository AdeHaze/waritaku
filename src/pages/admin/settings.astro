---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { settings, collections, entries, taxonomies } from '../../db/schema';
import { eq, and } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { getDb } from '../../lib/db';
import { getRegisteredLanguages } from '../../i18n';
import { hasPermission } from '../../lib/permissions';

const availableLanguagePacks = getRegisteredLanguages();


const permissions = Astro.locals.permissions;
if (!permissions || !hasPermission(permissions, 'settings', 'read')) {
    return Astro.redirect('/admin/login');
}

let db = null;
if (env && env.DB) {
    db = getDb(env);
}

let message = '';
let isError = false;

// Default config
let generalConfig = {
    siteTitle: 'Waritaku',
    siteUrl: 'https://waritaku.com',
    tagline: '',
    siteDescription: '',
    logoUrl: 'https://waritaku.com/wp-content/uploads/2022/12/Logo_Waritaku_With_Tagline_7_Desktop.png',
    faviconUrl: '/favicon.svg',
    language: 'id',
    headerHtml: '',
    footerHtml: '',
    articleUpperHtml: '',
    articleBottomHtml: '',
    archiveInBetweenHtml: '',
    systemLoginHtml: '',
    copyright: 'Waritaku',
    enableRedirections: true,
    enable404Tracking: true,
    page404Id: '',
    dateArchiveMode: 'date', // 'date' | 'month' | 'year' | 'off'
    sitemapCollections: [] as string[],
    sitemapTaxonomies: [] as string[]
};

let pageOptions: { id: number, title: string }[] = [];
if (db) {
    const pagesCol = await db.select().from(collections).where(eq(collections.slug, 'pages')).limit(1);
    if (pagesCol.length > 0) {
        const rawPages = await db.select({ id: entries.id, data: entries.data }).from(entries).where(and(eq(entries.collectionId, pagesCol[0].id), eq(entries.status, 'published')));
        pageOptions = rawPages.map(p => {
            let t = 'Untitled';
            try { t = JSON.parse(p.data).title || t; } catch {}
            return { id: p.id, title: t };
        });
    }
}

let collectionsList: { slug: string, label: string }[] = [];
let taxonomiesList: { slug: string, label: string }[] = [];
if (db) {
    const cols = await db.select({ slug: collections.slug, label: collections.label }).from(collections);
    collectionsList = cols;
    const taxs = await db.select({ slug: taxonomies.slug, label: taxonomies.label }).from(taxonomies);
    taxonomiesList = taxs;
}

if (Astro.request.method === 'POST') {
    try {
        const formData = await Astro.request.formData();
        
        const newConfig = {
            siteTitle: formData.get('siteTitle') as string || 'Waritaku',
            siteUrl: formData.get('siteUrl') as string || 'https://waritaku.com',
            tagline: formData.get('tagline') as string || '',
            siteDescription: formData.get('siteDescription') as string || '',
            copyright: formData.get('copyright') as string || '',
            logoUrl: formData.get('logoUrl') as string || '',
            faviconUrl: formData.get('faviconUrl') as string || '/favicon.svg',
            language: formData.get('language') as string || 'id',
            headerHtml: formData.get('headerHtml') as string || '',
            footerHtml: formData.get('footerHtml') as string || '',
            articleUpperHtml: formData.get('articleUpperHtml') as string || '',
            articleBottomHtml: formData.get('articleBottomHtml') as string || '',
            archiveInBetweenHtml: formData.get('archiveInBetweenHtml') as string || '',
            systemLoginHtml: formData.get('systemLoginHtml') as string || '',
            enableRedirections: formData.get('enableRedirections') === 'on',
            enable404Tracking: formData.get('enable404Tracking') === 'on',
            page404Id: formData.get('page404Id') as string || '',
            dateArchiveMode: formData.get('dateArchiveMode') as string || 'date',
            sitemapCollections: formData.getAll('sitemapCollections') as string[],
            sitemapTaxonomies: formData.getAll('sitemapTaxonomies') as string[]
        };

        if (db) {
            const configStr = JSON.stringify(newConfig);
            
            await db.insert(settings)
                .values({ key: 'general_settings', value: configStr })
                .onConflictDoUpdate({ target: settings.key, set: { value: configStr } });

            message = 'General settings updated successfully.';
            generalConfig = newConfig;
        }
    } catch (e) {
        message = 'An error occurred while saving general settings.';
        isError = true;
        console.error(e);
    }
} else if (db) {
    const existing = await db.select().from(settings).where(eq(settings.key, 'general_settings'));
    if (existing.length > 0) {
        try {
            const dbSettings = JSON.parse(existing[0].value);
            if (!dbSettings.logoUrl || dbSettings.logoUrl.trim() === '') {
                delete dbSettings.logoUrl;
            }
            generalConfig = { ...generalConfig, ...dbSettings };
        } catch(e) {}
    } else {
        // Migration logic: Check if footer_config exists and we haven't saved general_settings yet
        const oldFooter = await db.select().from(settings).where(eq(settings.key, 'footer_config'));
        if (oldFooter.length > 0) {
            try {
                const parsed = JSON.parse(oldFooter[0].value);
                generalConfig.tagline = parsed.tagline || generalConfig.tagline;
                generalConfig.copyright = parsed.copyright || generalConfig.copyright;
            } catch(e) {}
        }
    }
}
---

<AdminLayout title="General Settings">
    <div class="max-w-4xl">
        <div class="mb-8 flex flex-col sm:flex-row sm:items-start justify-between gap-4">
            <div>
                <h2 class="text-3xl font-bold tracking-tight text-foreground">General Settings</h2>
                <p class="text-muted-foreground mt-2">Manage your site identity, branding, and global integrations.</p>
            </div>
            <div class="flex flex-col items-end gap-3 shrink-0">
                <a href="/admin/docs#docs-general-settings" class="inline-flex items-center gap-1.5 text-sm font-bold text-primary bg-primary/10 hover:bg-primary/20 px-4 py-2 rounded-full transition-colors border border-primary/20 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                    Read Documentation
                </a>
                {message && (
                    <div class={`px-4 py-2 text-sm rounded-md font-medium ${isError ? 'bg-destructive/10 text-destructive border border-destructive/20' : 'bg-green-500/10 text-green-600 border border-green-500/20'}`}>
                        {message}
                    </div>
                )}
            </div>
        </div>

        <form method="POST" class="space-y-8">
            
            <div class="bg-card border border-border rounded-xl p-6 shadow-sm">
                <div class="mb-6 pb-4 border-b border-border">
                    <h3 class="text-lg font-bold">Site Identity</h3>
                    <p class="text-sm text-muted-foreground mt-1">Configure your brand names and graphics.</p>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-2">
                        <label class="text-sm font-semibold">Site Title</label>
                        <input type="text" name="siteTitle" value={generalConfig.siteTitle} required class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" />
                        <p class="text-[11px] text-muted-foreground">The main name of your website.</p>
                    </div>

                    <div class="space-y-2">
                        <label class="text-sm font-semibold">Site Tagline</label>
                        <input type="text" name="tagline" value={generalConfig.tagline} class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" />
                        <p class="text-[11px] text-muted-foreground">A short description or motto (appears in footer).</p>
                    </div>

                    <div class="space-y-2 md:col-span-2">
                        <label class="text-sm font-semibold">Site URL</label>
                        <input type="url" name="siteUrl" value={generalConfig.siteUrl} required class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring font-mono" />
                        <p class="text-[11px] text-muted-foreground">The primary URL of your site (e.g. https://waritaku.com or https://www.waritaku.com). Used for canonical URLs.</p>
                    </div>

                    <div class="space-y-2 md:col-span-2">
                        <label class="text-sm font-semibold">Site Description (SEO)</label>
                        <textarea name="siteDescription" rows="3" class="flex w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">{generalConfig.siteDescription}</textarea>
                        <p class="text-[11px] text-muted-foreground">The meta description used for SEO on the homepage and as a fallback.</p>
                    </div>

                    <div class="space-y-2">
                        <label class="text-sm font-semibold">Header Logo URL</label>
                        <input type="text" name="logoUrl" value={generalConfig.logoUrl} placeholder="/logo.png" class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring font-mono" />
                        <p class="text-[11px] text-muted-foreground">URL of your logo image. Leave blank to use Site Title.</p>
                    </div>

                    <div class="space-y-2">
                        <label class="text-sm font-semibold">Favicon URL</label>
                        <input type="text" name="faviconUrl" value={generalConfig.faviconUrl} placeholder="/favicon.svg" class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring font-mono" />
                        <p class="text-[11px] text-muted-foreground">The small icon shown in browser tabs.</p>
                    </div>

                    <div class="space-y-2 md:col-span-2">
                        <label class="text-sm font-semibold">Copyright Footer Text</label>
                        <input type="text" name="copyright" value={generalConfig.copyright} class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" />
                        <p class="text-[11px] text-muted-foreground">Appears at the very bottom. The year is automatically added.</p>
                    </div>
                </div>
            </div>

            <div class="bg-card border border-border rounded-xl p-6 shadow-sm">
                <div class="mb-6 pb-4 border-b border-border">
                    <h3 class="text-lg font-bold">SEO & Edge Routing</h3>
                    <p class="text-sm text-muted-foreground mt-1">Configure Edge middleware features like Redirection Engine and 404 Logging.</p>
                </div>
                <div class="space-y-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <label class="text-sm font-semibold">Enable Redirection Engine</label>
                            <p class="text-[11px] text-muted-foreground mt-1">Allows the Edge Middleware to intercept requests and process 301/302 redirects. Turning this off instantly disables all redirects globally.</p>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" name="enableRedirections" class="sr-only peer" checked={generalConfig.enableRedirections}>
                            <div class="w-11 h-6 bg-muted peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-primary/20 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
                        </label>
                    </div>
                    <div class="flex items-center justify-between">
                        <div>
                            <label class="text-sm font-semibold">Enable 404 Live Tracking</label>
                            <p class="text-[11px] text-muted-foreground mt-1">Automatically logs broken links to the Live Tracker dashboard. Disable this if you are getting too much noise.</p>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" name="enable404Tracking" class="sr-only peer" checked={generalConfig.enable404Tracking}>
                            <div class="w-11 h-6 bg-muted peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-primary/20 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
                        </label>
                    </div>
                    <div class="pt-4 border-t border-border">
                        <label class="block text-sm font-semibold mb-2">Custom 404 Page Layout</label>
                        <p class="text-[11px] text-muted-foreground mb-3">Select a published Page to act as your custom 404 Error page. The page will be rendered dynamically with its block layout.</p>
                        <select name="page404Id" class="w-full px-4 py-2 bg-background border border-input rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/50">
                            <option value="">-- Default System 404 --</option>
                            {pageOptions.map(p => (
                                <option value={p.id} selected={generalConfig.page404Id == p.id.toString()}>{p.title}</option>
                            ))}
                        </select>
                    </div>
                </div>
            </div>

            <div class="bg-card border border-border rounded-xl p-6 shadow-sm">
                <div class="mb-6 pb-4 border-b border-border">
                    <h3 class="text-lg font-bold">Date Archives</h3>
                    <p class="text-sm text-muted-foreground mt-1">Control which date archive levels are active. Setting to Off completely disables all date-based D1 queries.</p>
                </div>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-semibold mb-2">Archive Mode</label>
                        <select name="dateArchiveMode" class="w-full px-4 py-2 bg-background border border-input rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/50">
                            <option value="date" selected={generalConfig.dateArchiveMode === 'date'}>Date (Year / Month / Day)</option>
                            <option value="month" selected={generalConfig.dateArchiveMode === 'month'}>Month (Year / Month)</option>
                            <option value="year" selected={generalConfig.dateArchiveMode === 'year'}>Year only</option>
                            <option value="off" selected={generalConfig.dateArchiveMode === 'off'}>Off — Disable all date archives</option>
                        </select>
                        <p class="text-[11px] text-muted-foreground mt-2">When Off, date archive URLs return 404 and the calendar widget is hidden.</p>
                    </div>
                </div>
            </div>

            <div class="bg-card border border-border rounded-xl p-6 shadow-sm">
                <div class="mb-6 pb-4 border-b border-border">
                    <h3 class="text-lg font-bold">XML Sitemap Config</h3>
                    <p class="text-sm text-muted-foreground mt-1">Control which Collections and Taxonomies are included in your generated sitemaps.</p>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
                    <div>
                        <label class="block text-sm font-semibold mb-3">Include Collections (Entries)</label>
                        <div class="space-y-3">
                            {collectionsList.map(c => (
                                <label class="flex items-center space-x-3 cursor-pointer group">
                                    <input type="checkbox" name="sitemapCollections" value={c.slug} checked={generalConfig.sitemapCollections === undefined || generalConfig.sitemapCollections.length === 0 ? true : generalConfig.sitemapCollections.includes(c.slug)} class="h-4 w-4 rounded border-input text-primary focus:ring-primary/50" />
                                    <span class="text-sm group-hover:text-primary transition-colors">{c.label}</span>
                                </label>
                            ))}
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold mb-3">Include Taxonomies (Terms)</label>
                        <div class="space-y-3">
                            {taxonomiesList.map(t => (
                                <label class="flex items-center space-x-3 cursor-pointer group">
                                    <input type="checkbox" name="sitemapTaxonomies" value={t.slug} checked={generalConfig.sitemapTaxonomies === undefined || generalConfig.sitemapTaxonomies.length === 0 ? true : generalConfig.sitemapTaxonomies.includes(t.slug)} class="h-4 w-4 rounded border-input text-primary focus:ring-primary/50" />
                                    <span class="text-sm group-hover:text-primary transition-colors">{t.label}</span>
                                </label>
                            ))}
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-card border border-border rounded-xl p-6 shadow-sm">
                <div class="mb-6 pb-4 border-b border-border flex items-center justify-between">
                    <div>
                        <h3 class="text-lg font-bold">Localization & Language Packs</h3>
                        <p class="text-sm text-muted-foreground mt-1">Configure active language pack and internationalization engine.</p>
                    </div>
                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold bg-primary/10 text-primary border border-primary/20">
                        ⚡ i18n Engine Active
                    </span>
                </div>
                
                <div class="space-y-6">
                    <div class="space-y-2 max-w-md">
                        <label class="text-sm font-semibold">Global Language Pack</label>
                        <select name="language" class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
                            {availableLanguagePacks.map(pack => (
                                <option value={pack.code} selected={generalConfig.language === pack.code}>
                                    {pack.name} ({pack.code})
                                </option>
                            ))}
                        </select>
                        <p class="text-[11px] text-muted-foreground">Controls UI strings, pagination labels, calendar headers, and HTML lang attributes across the site.</p>
                    </div>

                    <div class="p-4 rounded-lg bg-muted/30 border border-border text-xs space-y-2">
                        <div class="font-bold text-foreground">Extensible Language Pack System:</div>
                        <p class="text-muted-foreground leading-relaxed">
                            Language packs are modularly stored in <code class="font-mono text-primary">src/i18n/*.ts</code>. Additional language packs (e.g. Japanese, Spanish) can be added simply by creating a dictionary file and registering it in <code class="font-mono text-primary">src/i18n/index.ts</code>.
                        </p>
                    </div>
                </div>
            </div>

            <div class="bg-card border border-border rounded-xl p-6 shadow-sm">
                <div class="mb-6 pb-4 border-b border-border">
                    <h3 class="text-lg font-bold">Custom HTML Injection</h3>
                    <p class="text-sm text-muted-foreground mt-1">Inject custom scripts or HTML blocks globally or on specific areas.</p>
                </div>
                
                <div class="space-y-6">
                    <div class="space-y-2">
                        <label class="text-sm font-semibold">Header HTML (&lt;head&gt;)</label>
                        <textarea 
                            name="headerHtml" 
                            rows="4"
                            placeholder="<!-- Paste Google Analytics, Meta Verification, etc. -->"
                            class="flex w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring font-mono"
                        >{generalConfig.headerHtml}</textarea>
                        <p class="text-[11px] text-muted-foreground">Injected into the &lt;head&gt; section of every page.</p>
                    </div>

                    <div class="space-y-2">
                        <label class="text-sm font-semibold">Footer HTML (Before &lt;/body&gt;)</label>
                        <textarea 
                            name="footerHtml" 
                            rows="4"
                            placeholder="<!-- Paste global tracker scripts or deferred JS here -->"
                            class="flex w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring font-mono"
                        >{generalConfig.footerHtml}</textarea>
                        <p class="text-[11px] text-muted-foreground">Injected at the very bottom of every page.</p>
                    </div>

                    <div class="space-y-2">
                        <label class="text-sm font-semibold">Article Upper HTML</label>
                        <textarea 
                            name="articleUpperHtml" 
                            rows="6"
                            placeholder="<!-- Paste top banner Ads, announcements, or breadcrumbs here -->"
                            class="flex w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring font-mono"
                        >{generalConfig.articleUpperHtml}</textarea>
                        <p class="text-[11px] text-muted-foreground">This HTML/JS code will automatically be rendered directly at the top of every individual Article page (before the main content).</p>
                    </div>

                    <div class="space-y-2">
                        <label class="text-sm font-semibold">Article Bottom HTML</label>
                        <textarea 
                            name="articleBottomHtml" 
                            rows="6"
                            placeholder="<!-- Paste Disqus, Facebook Comments, Telegram script, or Ads here -->"
                            class="flex w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring font-mono"
                        >{generalConfig.articleBottomHtml}</textarea>
                        <p class="text-[11px] text-muted-foreground">This HTML/JS code will automatically be rendered directly at the bottom of every individual Article page.</p>
                    </div>

                    <div class="space-y-2">
                        <label class="text-sm font-semibold">Archive In-Between HTML</label>
                        <textarea 
                            name="archiveInBetweenHtml" 
                            rows="6"
                            placeholder="<!-- Paste Google Ads or custom widgets here -->"
                            class="flex w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring font-mono"
                        >{generalConfig.archiveInBetweenHtml}</textarea>
                        <p class="text-[11px] text-muted-foreground">This HTML/JS code will be rendered between articles in archive pages (e.g. Category, Tag, Date archives). Designed for in-feed/multiplex ads.</p>
                    </div>
                </div>
            </div>

            <div class="bg-card border border-border rounded-xl shadow-sm overflow-hidden mb-8">
                <div class="px-6 py-4 border-b border-border bg-muted/30">
                    <h2 class="font-bold text-lg text-foreground">Admin Interface Configuration</h2>
                    <p class="text-sm text-muted-foreground mt-1">Customize the look and feel of your admin panel.</p>
                </div>
                <div class="p-6 space-y-6">
                    <div class="space-y-2">
                        <label class="text-sm font-semibold">System Login HTML / Image</label>
                        <textarea 
                            name="systemLoginHtml" 
                            rows="6"
                            placeholder="<img src='https://images.unsplash.com/photo-...' class='w-full h-full object-cover opacity-80' />"
                            class="flex w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring font-mono"
                        >{generalConfig.systemLoginHtml}</textarea>
                        <p class="text-[11px] text-muted-foreground">This HTML will be rendered on the right side of the Admin Login screen. You can use an <code>&lt;img&gt;</code> tag for a background image.</p>
                    </div>
                </div>
            </div>

            <div class="flex justify-end pt-4 pb-12">
                <button type="submit" class="px-6 py-2.5 bg-primary text-primary-foreground font-medium rounded-md hover:bg-primary/90 transition-colors shadow-sm">
                    Save General Settings
                </button>
            </div>
        </form>
    </div>
</AdminLayout>
