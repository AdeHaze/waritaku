---
import { getThumbnail } from '../../lib/utils';
import LayoutArticlePage from '../../layouts/LayoutArticlePage.astro';
import GlobalSidebar from '../../components/GlobalSidebar.astro';
import Pagination from '../../components/Pagination.astro';
import ViewToggle from '../../components/ViewToggle.astro';
import { entries, collections, users, terms, taxonomies, entryTerms, settings } from '../../db/schema';
import { eq, and, desc, sql } from 'drizzle-orm';
import { env } from "cloudflare:workers";
import { getDb } from '../../lib/db';

let rawSlug = Astro.params.slug as string;
if (!rawSlug) return Astro.redirect('/404');

rawSlug = rawSlug.replace(/\/$/, '');

let currentPage = 1;
const pageMatch = rawSlug.match(/^(.*?)\/page\/(\d+)$/i);
if (pageMatch) {
    rawSlug = pageMatch[1];
    currentPage = Math.max(1, parseInt(pageMatch[2], 10));
} else {
    const pageParam = Astro.url.searchParams.get('page');
    if (pageParam) currentPage = Math.max(1, parseInt(pageParam, 10));
}

const slug = rawSlug;

let tagData: any = null;
let tagArticles: any[] = [];
const pageSize = 12;
let totalPages = 1;

let showLeftSidebar = false;
let showRightSidebar = true;

if (env && (env as any).DB && slug) {
    const db = getDb(env as any);

    const tagResult = await db.select({
        term: terms,
        taxonomy: taxonomies
    })
    .from(terms)
    .innerJoin(taxonomies, eq(terms.taxonomyId, taxonomies.id))
    .where(and(eq(terms.slug, slug), eq(taxonomies.slug, 'tags')))
    .limit(1);

    if (tagResult.length > 0) {
        tagData = tagResult[0].term;

        const articlesCol = await db.select().from(collections).where(eq(collections.slug, 'articles')).limit(1);
        const articlesColId = articlesCol.length > 0 ? articlesCol[0].id : null;

        if (articlesColId) {
            // Pagination Count Query
            const countResult = await db.select({ count: sql<number>`count(*)` })
                .from(entryTerms)
                .innerJoin(entries, eq(entryTerms.entryId, entries.id))
                .where(
                    and(
                        eq(entryTerms.termId, tagData.id),
                        eq(entries.collectionId, articlesColId),
                        eq(entries.status, 'published')
                    )
                );
            
            const totalItems = countResult[0]?.count || 0;
            totalPages = Math.ceil(totalItems / pageSize);

            // Fetch entries
            const articlesResult = await db.select({
                entry: entries,
                author: users
            })
            .from(entryTerms)
            .innerJoin(entries, eq(entryTerms.entryId, entries.id))
            .leftJoin(users, eq(entries.authorId, users.id))
            .where(
                and(
                    eq(entryTerms.termId, tagData.id),
                    eq(entries.collectionId, articlesColId),
                    eq(entries.status, 'published')
                )
            )
            .orderBy(desc(entries.publishedAt))
            .limit(pageSize)
            .offset((currentPage - 1) * pageSize);

            tagArticles = articlesResult.map(row => {
                const data = JSON.parse(row.entry.data || '{}');
                return {
                    id: row.entry.id,
                    slug: row.entry.slug,
                    publishedAt: row.entry.publishedAt,
                    ...data,
                    authorName: row.author?.name || 'Writer'
                };
            });
        }
        
        // Fetch layout config
        const configRes = await db.select().from(settings).where(eq(settings.key, 'sidebar_layout_config')).limit(1);
        if (configRes.length > 0) {
            try {
                const layoutConfig = JSON.parse(configRes[0].value);
                // Tags share category visibility rules
                showLeftSidebar = layoutConfig.left?.showOnCategories ?? false;
                showRightSidebar = layoutConfig.right?.showOnCategories ?? true;
            } catch(e) {}
        }
    } else {
        // Tag not found, throw 404 so Redirection Engine can catch it
        return new Response(null, {
            status: 404,
            statusText: 'Not found'
        });
    }
} else {
    return new Response(null, {
        status: 404,
        statusText: 'Not found'
    });
}


const pageTitle = `Topik: ${tagData.name}`;
const currentUrl = Astro.url.href;

const schemaObj = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": pageTitle,
    "url": currentUrl
};
const schemaString = JSON.stringify(schemaObj);
---

<LayoutArticlePage title={pageTitle} metaDescription={`Kumpulan artikel dengan topik ${tagData.name}`} schema={schemaString}>
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
        <div class={`grid grid-cols-1 gap-8 md:gap-12 ${showLeftSidebar && showRightSidebar ? 'lg:grid-cols-4' : (showLeftSidebar || showRightSidebar) ? 'lg:grid-cols-3' : 'lg:grid-cols-1'}`}>
            
            {/* Left Sidebar */}
            {showLeftSidebar && (
                <aside class="lg:col-span-1 mt-12 lg:mt-0 order-last lg:order-first">
                    <GlobalSidebar zone="left" context="category" />
                </aside>
            )}

            {/* Main Content */}
            <div class={`${showLeftSidebar && showRightSidebar ? 'lg:col-span-2' : (showLeftSidebar || showRightSidebar) ? 'lg:col-span-2' : 'lg:col-span-1'}`}>
                <div class="mb-12 border-b-4 border-primary pb-2 flex justify-between items-end">
                    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight uppercase text-foreground">
                        Topik: {tagData.name} {currentPage > 1 ? `(Page ${currentPage})` : ''}
                    </h1>
                    <ViewToggle />
                </div>
                
                {tagArticles.length === 0 ? (
                    <div class="text-center py-12 bg-muted/20 border border-border rounded-xl">
                        <p class="text-xl text-muted-foreground">Belum ada artikel untuk topik ini.</p>
                    </div>
                ) : (
                    <>
                        <div class="article-archive-layout mb-12">
                            {tagArticles.map((article: any) => (
                                <a href={`/${article.slug}`} class="article-archive-card group flex bg-muted/20 border border-border rounded-xl overflow-hidden hover:shadow-lg transition-all hover:-translate-y-1">
                                    <div class="article-archive-card-img-wrapper relative overflow-hidden flex-shrink-0">
                                        <img 
                                            src={article.featuredImageUrl || getThumbnail(article.content)} 
                                            alt={article.title} 
                                            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
                                            loading="lazy" 
                                        />
                                    </div>
                                    <div class="p-4 flex flex-col flex-1 min-w-0">
                                        <div class="flex items-center space-x-2 text-[10px] uppercase font-bold tracking-wider mb-2 text-muted-foreground flex-wrap">
                                            <span class="truncate max-w-full">{article.authorName}</span>
                                            <span>&bull;</span>
                                            <time class="flex-shrink-0">{new Date(article.publishedAt).toLocaleDateString()}</time>
                                        </div>
                                        <h3 class="text-base md:text-lg font-bold leading-snug group-hover:text-primary transition-colors line-clamp-3 mb-2">
                                            {article.title}
                                        </h3>
                                        <p class="text-xs text-muted-foreground line-clamp-2 mt-auto">
                                            {article.excerpt}
                                        </p>
                                    </div>
                                </a>
                            ))}
                        </div>

                        {totalPages > 1 && (
                            <Pagination 
                                currentPage={currentPage} 
                                totalPages={totalPages} 
                                baseUrl={`/tag/${tagData.slug}`} 
                            />
                        )}
                    </>
                )}
            </div>

            {/* Right Sidebar */}
            {showRightSidebar && (
                <aside class="lg:col-span-1 mt-12 lg:mt-0">
                    <GlobalSidebar zone="right" context="category" />
                </aside>
            )}
        </div>
    </div>
</LayoutArticlePage>
