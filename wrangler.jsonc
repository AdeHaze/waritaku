{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-26",
	// nodejs_compat enables Node.js built-ins (crypto, buffer, etc.) in the Worker.
	// Required for bcryptjs to verify legacy WordPress password hashes.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

	"name": "waritaku",
	"pages_build_output_dir": "dist",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "waritaku-d1",
			"database_id": "57c02531-4715-44fe-ba8c-cbaf4176345f",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "UPLOADS",
			"bucket_name": "waritaku-uploads"
		}
	]
}